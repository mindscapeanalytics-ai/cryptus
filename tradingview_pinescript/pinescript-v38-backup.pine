plotshape(_do_buy  and mode_buy_swing    and not _trap_buy,  title="SWING BUY",    location=location.belowbar, style=shape.arrowup,      color=color.blue,    size=size.normal,  text="SWING")
plotshape(_do_buy  and mode_buy_sniper   and not _trap_buy,  title="SNIPER BUY",   location=location.belowbar, style=shape.arrowup,      color=color.fuchsia, size=size.normal,  text="SNIPER")
plotshape(_do_buy  and mode_buy_kz       and not _trap_buy,  title="KZ BUY",       location=location.belowbar, style=shape.arrowup,      color=color.yellow,  size=size.normal,  text="KZ")
plotshape(_do_buy  and mode_buy_intraday and not _trap_buy,  title="INTRADAY BUY", location=location.belowbar, style=shape.triangleup,   color=color.lime,    size=size.small,   text="INT")
plotshape(_do_buy  and mode_buy_scalp    and not _trap_buy,  title="SCALP BUY",    location=location.belowbar, style=shape.triangleup,   color=color.green,   size=size.tiny,    text="S")

plotshape(_do_sell and mode_sell_swing    and not _trap_sell, title="SWING SELL",   location=location.abovebar, style=shape.arrowdown,    color=color.blue,    size=size.normal,  text="SWING")
plotshape(_do_sell and mode_sell_sniper   and not _trap_sell, title="SNIPER SELL",  location=location.abovebar, style=shape.arrowdown,    color=color.fuchsia, size=size.normal,  text="SNIPER")
plotshape(_do_sell and mode_sell_kz       and not _trap_sell, title="KZ SELL",      location=location.abovebar, style=shape.arrowdown,    color=color.yellow,  size=size.normal,  text="KZ")
plotshape(_do_sell and mode_sell_intraday and not _trap_sell, title="INTRADAY SELL",location=location.abovebar, style=shape.triangledown, color=color.red,     size=size.small,   text="INT")
plotshape(_do_sell and mode_sell_scalp    and not _trap_sell, title="SCALP SELL",   location=location.abovebar, style=shape.triangledown, color=color.orange,  size=size.tiny,    text="S")

// ICT elite pattern markers
plotshape(unicorn_bull and barstate.isconfirmed, title="Unicorn BUY",  location=location.belowbar, style=shape.diamond, color=color.new(color.fuchsia,20), size=size.small, text="🦄")
plotshape(unicorn_bear and barstate.isconfirmed, title="Unicorn SELL", location=location.abovebar, style=shape.diamond, color=color.new(color.fuchsia,20), size=size.small, text="🦄")
plotshape(mmxm_bull    and barstate.isconfirmed, title="MMXM BUY",     location=location.belowbar, style=shape.circle,  color=color.new(color.aqua,30),    size=size.tiny,  text="M")
plotshape(mmxm_bear    and barstate.isconfirmed, title="MMXM SELL",    location=location.abovebar, style=shape.circle,  color=color.new(color.aqua,30),    size=size.tiny,  text="M")
// BUG-10 FIXED: title strings were swapped (Judas Bull was above bar, Judas Bear below bar)
plotshape(judas_bullish and barstate.isconfirmed,"Judas Bull",          location=location.belowbar, style=shape.xcross,  color=color.new(color.orange,40),  size=size.tiny,  text="J")
plotshape(judas_bearish and barstate.isconfirmed,"Judas Bear",          location=location.abovebar, style=shape.xcross,  color=color.new(color.orange,40),  size=size.tiny,  text="J")
plotshape(aoe_breakout_bull and barstate.isconfirmed,"AOE Bull BO",     location=location.belowbar, style=shape.triangleup,  color=color.new(color.purple,30), size=size.tiny, text="AOE")
plotshape(aoe_breakout_bear and barstate.isconfirmed,"AOE Bear BO",     location=location.abovebar, style=shape.triangledown,color=color.new(color.purple,30), size=size.tiny, text="AOE")

// ════════════════════════════════════════════════════════════════════════════
// SECTION 26 — BOX CLEANUP (INFINITE-LOOP GUARD: _cleanup_iter < 50)
// Runs every bar, capped iterations to prevent CE10128 / TradingView timeout
// Max-per-type enforcement + age-based pruning
// ════════════════════════════════════════════════════════════════════════════
f_cleanup_single_array(array<box> box_arr, array<int> age_arr) =>
    int _cleanup_iter = 0
    while array.size(box_arr) > max_boxes_per_type and _cleanup_iter < 50
        _cleanup_iter += 1
        if array.size(age_arr) > 0
            int _oldest_age = array.get(age_arr, 0)
            int _oldest_idx = 0
            if array.size(age_arr) > 1
                for j = 1 to array.size(age_arr) - 1
                    if array.get(age_arr, j) > _oldest_age
                        _oldest_age := array.get(age_arr, j)
                        _oldest_idx := j
            if delete_boxes and _oldest_idx < array.size(box_arr) and not na(array.get(box_arr, _oldest_idx))
                box.delete(array.get(box_arr, _oldest_idx))
            if _oldest_idx < array.size(box_arr)
                array.remove(box_arr, _oldest_idx)
            if _oldest_idx < array.size(age_arr)
                array.remove(age_arr, _oldest_idx)

f_purge_single_array(array<box> box_arr, array<int> age_arr) =>
    int _cleanup_iter = 0
    int _idx_age = 0
    while _idx_age < array.size(box_arr) and _cleanup_iter < 50
        _cleanup_iter += 1
        if _idx_age < array.size(age_arr) and array.get(age_arr, _idx_age) > max_box_age
            if delete_boxes and not na(array.get(box_arr, _idx_age))
                box.delete(array.get(box_arr, _idx_age))
            array.remove(box_arr, _idx_age)
            array.remove(age_arr,  _idx_age)
        else
            _idx_age += 1

f_cleanup_boxes() =>
    if barstate.isconfirmed and aggressive_cleanup
        // ── Age all boxes (size-guard prevents for 0 to -1 crash on empty arrays) ─
        if array.size(bu_ob_ages) > 0
            for i = 0 to array.size(bu_ob_ages) - 1
                array.set(bu_ob_ages, i, array.get(bu_ob_ages, i) + 1)
        if array.size(be_ob_ages) > 0
            for i = 0 to array.size(be_ob_ages) - 1
                array.set(be_ob_ages, i, array.get(be_ob_ages, i) + 1)
        if array.size(bu_fvg_ages) > 0
            for i = 0 to array.size(bu_fvg_ages) - 1
                array.set(bu_fvg_ages, i, array.get(bu_fvg_ages, i) + 1)
        if array.size(be_fvg_ages) > 0
            for i = 0 to array.size(be_fvg_ages) - 1
                array.set(be_fvg_ages, i, array.get(be_fvg_ages, i) + 1)

        f_cleanup_single_array(bu_ob_boxes, bu_ob_ages)
        f_cleanup_single_array(be_ob_boxes, be_ob_ages)
        f_cleanup_single_array(bu_fvg_boxes, bu_fvg_ages)
        f_cleanup_single_array(be_fvg_boxes, be_fvg_ages)

        // ── Age-based hard purge (older than max_box_age) ──────────────────────
        f_purge_single_array(bu_ob_boxes, bu_ob_ages)
        f_purge_single_array(be_ob_boxes, be_ob_ages)
        f_purge_single_array(bu_fvg_boxes, bu_fvg_ages)
        f_purge_single_array(be_fvg_boxes, be_fvg_ages)

        // ── Filled FVG removal (FVG completely filled = remove) ────────────────
        int _cleanup_iter = 0
        int _idx_age = 0
        box _bx = na
        while _idx_age < array.size(bu_fvg_boxes) and _cleanup_iter < 50
            _cleanup_iter += 1
            _bx := array.get(bu_fvg_boxes, _idx_age)
            if not na(_bx) and close < box.get_bottom(_bx)
                if delete_boxes
                    box.delete(_bx)
                array.remove(bu_fvg_boxes, _idx_age)
                if _idx_age < array.size(bu_fvg_ages)
                    array.remove(bu_fvg_ages, _idx_age)
            else
                _idx_age += 1

        _cleanup_iter := 0
        _idx_age := 0
        while _idx_age < array.size(be_fvg_boxes) and _cleanup_iter < 50
            _cleanup_iter += 1
            _bx := array.get(be_fvg_boxes, _idx_age)
            if not na(_bx) and close > box.get_top(_bx)
                if delete_boxes
                    box.delete(_bx)
                array.remove(be_fvg_boxes, _idx_age)
                if _idx_age < array.size(be_fvg_ages)
                    array.remove(be_fvg_ages, _idx_age)
            else
                _idx_age += 1

f_cleanup_boxes()

// ════════════════════════════════════════════════════════════════════════════
// SECTION 27 — ALERT SYSTEM (hybrid: alertcondition + alert())
// Pine v6 limits: alertcondition() max = 64 (plot/shape have NO v6 cap).
// Current: 29 alertconditions (well within 64 limit).
// Strategy: alertcondition() for webhook-selectable + alert() for dynamic values.
// All gates use barstate.isconfirmed to prevent repainting.
// ════════════════════════════════════════════════════════════════════════════

// ── Helper strings (computed once per bar for alert() messages) ─────────────
string _a_tk   = syminfo.tickerid + " " + timeframe.period
string _a_sc   = str.tostring(math.round(display_buy_score > display_sell_score ? display_buy_score : display_sell_score), "#")
string _a_pr   = str.tostring(math.round(capped_prob_buy > capped_prob_sell ? capped_prob_buy : capped_prob_sell), "#")
string _a_ep   = str.tostring(frozen_ep,  "#.##")
string _a_sl   = str.tostring(frozen_sl,  "#.##")
string _a_tp1  = str.tostring(frozen_tp1, "#.##")
string _a_tp3  = str.tostring(frozen_tp3, "#.##")

// ═══════════════════════════════════════════════════════════════════════════
// A) ALERTCONDITION — selectable in TradingView "Create Alert" dialog (21)
// ═══════════════════════════════════════════════════════════════════════════

// Master catch-all
alertcondition(strong_buy  and barstate.isconfirmed and not _trap_buy,  "✅ ANY BUY Signal",  "MA-Gold v38 | ✅ BUY | Active Signal | {{ticker}} {{interval}}")
alertcondition(strong_sell and barstate.isconfirmed and not _trap_sell, "🔻 ANY SELL Signal", "MA-Gold v38 | 🔻 SELL | Active Signal | {{ticker}} {{interval}}")

// Tiered Institutional Signals
alertcondition(_do_buy  and mode_buy_swing  and not _trap_buy  and barstate.isconfirmed, "🔵 SWING BUY",  "MA-Gold v38 | 🔵 SWING BUY | {{ticker}} {{interval}}")
alertcondition(_do_sell and mode_sell_swing and not _trap_sell and barstate.isconfirmed, "🔴 SWING SELL", "MA-Gold v38 | 🔴 SWING SELL | {{ticker}} {{interval}}")
alertcondition(_do_buy  and mode_buy_sniper and not _trap_buy  and barstate.isconfirmed, "🎯 SNIPER BUY", "MA-Gold v38 | 🎯 SNIPER BUY | {{ticker}} {{interval}}")
alertcondition(_do_sell and mode_sell_sniper and not _trap_sell and barstate.isconfirmed, "🎯 SNIPER SELL","MA-Gold v38 | 🎯 SNIPER SELL | {{ticker}} {{interval}}")

// Highest-conviction ICT
alertcondition(unicorn_bull and barstate.isconfirmed, "🦄 UNICORN BUY",  "MA-Gold v38 | 🦄 UNICORN BUY — CHoCH+FVG+Discount | {{ticker}} {{interval}}")
alertcondition(unicorn_bear and barstate.isconfirmed, "🦄 UNICORN SELL", "MA-Gold v38 | 🦄 UNICORN SELL — CHoCH+FVG+Premium | {{ticker}} {{interval}}")
alertcondition(mmxm_bull and barstate.isconfirmed,    "🏫 MMXM BUY",    "MA-Gold v38 | 🏫 MMXM BUY | {{ticker}} {{interval}}")
alertcondition(mmxm_bear and barstate.isconfirmed,    "🏫 MMXM SELL",   "MA-Gold v38 | 🏫 MMXM SELL | {{ticker}} {{interval}}")
alertcondition(internal_bull_choch and barstate.isconfirmed, "⚡ CHoCH BUY", "MA-Gold v38 | ⚡ CHoCH BUY | {{ticker}} {{interval}}")
alertcondition(internal_bear_choch and barstate.isconfirmed, "⚡ CHoCH SELL","MA-Gold v38 | ⚡ CHoCH SELL | {{ticker}} {{interval}}")

// Trade management
alertcondition(barstate.isconfirmed and trade_lockdown and _at_tp1_now, "✅ TP1 HIT",    "MA-Gold v38 | ✅ TP1 HIT — Take 50% & move SL to BE | {{ticker}} {{interval}}")
alertcondition(barstate.isconfirmed and hit_sl,                        "❌ STOP LOSS",   "MA-Gold v38 | ❌ STOP LOSS hit — trade closed | {{ticker}} {{interval}}")

// Risk / entropy
// alertcondition(entropy_critical and barstate.isconfirmed, "🔴 ENTROPY CRITICAL", "MA-Gold v38 | 🔴 Shannon Entropy CRITICAL | {{ticker}} {{interval}}")
alertcondition((_is_fake_bull_bo or _is_fake_bear_bo) and barstate.isconfirmed, "🚫 FAKE BREAKOUT", "MA-Gold v38 | 🚫 Fake breakout trap | {{ticker}} {{interval}}")
// alertcondition(score_conflict_zone and barstate.isconfirmed and not trade_lockdown, "⚠ SCORE CONFLICT", "MA-Gold v38 | ⚠ Score conflict | {{ticker}} {{interval}}")

// Session windows
alertcondition(in_london_kz and not in_london_kz[1] and barstate.isconfirmed, "⚡ London KZ OPEN", "MA-Gold v38 | ⚡ London Kill Zone open | {{ticker}} {{interval}}")
alertcondition(in_ny_kz and not in_ny_kz[1] and barstate.isconfirmed,          "⚡ NY KZ OPEN",     "MA-Gold v38 | ⚡ NY Kill Zone open | {{ticker}} {{interval}}")
alertcondition(is_silver_bullet and not is_silver_bullet[1] and barstate.isconfirmed, "⚡ Silver Bullet", "MA-Gold v38 | ⚡ Silver Bullet window | {{ticker}} {{interval}}")

// Gold macro
// alertcondition(near_qtr_low and not near_qtr_low[1] and barstate.isconfirmed, "📍 IPDA Qtr Low", "MA-Gold v38 | 📍 IPDA Qtr Low reached | {{ticker}} {{interval}}")

// V32 new alert conditions (commented to save plot output budget)
// alertcondition(wyckoff_accum_conf and not wyckoff_accum_conf[1] and barstate.isconfirmed, "🌀 Wyckoff ACCUM", "MA-Gold v38 | 🌀 Wyckoff ACCUMULATION confirmed — HTF bull bias | {{ticker}} {{interval}}")
// alertcondition(wyckoff_dist_conf  and not wyckoff_dist_conf[1]  and barstate.isconfirmed, "🌀 Wyckoff DIST",  "MA-Gold v38 | 🌀 Wyckoff DISTRIBUTION confirmed — HTF bear bias | {{ticker}} {{interval}}")
// alertcondition(_lof_bull_val and barstate.isconfirmed, "🎭 LOF BULL (v32)", "MA-Gold v38 | 🎭 LOF BULL precision — London trap sweep confirmed ≥0.25ATR | {{ticker}} {{interval}}")
// alertcondition(_lof_bear_val and barstate.isconfirmed, "🎭 LOF BEAR (v32)", "MA-Gold v38 | 🎭 LOF BEAR precision — London trap sweep confirmed ≥0.25ATR | {{ticker}} {{interval}}")
alertcondition(near_liq_pool_buy  and not near_liq_pool_buy[1]  and barstate.isconfirmed, "💧 LIQ POOL BUY",  "MA-Gold v38 | 💧 Equal Low pool within 0.7ATR — buy setup zone | {{ticker}} {{interval}}")
alertcondition(near_liq_pool_sell and not near_liq_pool_sell[1] and barstate.isconfirmed, "💧 LIQ POOL SELL", "MA-Gold v38 | 💧 Equal High pool within 0.7ATR — sell setup zone | {{ticker}} {{interval}}")
// alertcondition(htf_fvg_aligned_bull and not htf_fvg_aligned_bull[1] and barstate.isconfirmed, "🔗 MTF FVG BULL", "MA-Gold v38 | 🔗 Multi-TF FVG alignment BULL (current + 1h) | {{ticker}} {{interval}}")
// alertcondition(htf_fvg_aligned_bear and not htf_fvg_aligned_bear[1] and barstate.isconfirmed, "🔗 MTF FVG BEAR", "MA-Gold v38 | 🔗 Multi-TF FVG alignment BEAR (current + 1h) | {{ticker}} {{interval}}")

// ═══════════════════════════════════════════════════════════════════════════
// B) ALERT() — contextual notifications (no output slot cost, unlimited)
//    Fires on "Any alert() function call" in TradingView dialog
//    Dynamic values embedded via str.tostring — no {{plot_N}} dependency
// ═══════════════════════════════════════════════════════════════════════════

// Pre-signal tier
f_trigger_alerts() =>
    string _a_lot = str.tostring(_computed_lot_size, "#.##") + "L"
    if _presig_imminent_buy and barstate.isconfirmed
        alert("MA-Gold v38 | ⚡ BUY IMMINENT | Score: " + _a_sc + " | Prob: " + _a_pr + "% | " + _a_tk, alert.freq_once_per_bar)
    if _presig_imminent_sell and barstate.isconfirmed
        alert("MA-Gold v38 | ⚡ SELL IMMINENT | Score: " + _a_sc + " | Prob: " + _a_pr + "% | " + _a_tk, alert.freq_once_per_bar)
    if _presig_lvl2_buy and barstate.isconfirmed
        alert("MA-Gold v38 | 🟡 BUY READY — Elite confluence | " + _a_tk, alert.freq_once_per_bar)
    if _presig_lvl2_sell and barstate.isconfirmed
        alert("MA-Gold v38 | 🟡 SELL READY — Elite confluence | " + _a_tk, alert.freq_once_per_bar)
    if _presig_building_buy and barstate.isconfirmed
        alert("MA-Gold v38 | 🔵 BUY Building — momentum rising | " + _a_tk, alert.freq_once_per_bar)
    if _presig_building_sell and barstate.isconfirmed
        alert("MA-Gold v38 | 🔵 SELL Building — momentum rising | " + _a_tk, alert.freq_once_per_bar)

    // Tiered signal alerts with trade data + V32 lot size
    if _do_buy and mode_buy_swing and not _trap_buy and barstate.isconfirmed
        alert("MA-Gold v38 | 🔵 SWING BUY | EP:" + _a_ep + " SL:" + _a_sl + " TP1:" + _a_tp1 + " TP3:" + _a_tp3 + " | LOT:" + _a_lot + " | " + _a_tk, alert.freq_once_per_bar)
    if _do_sell and mode_sell_swing and not _trap_sell and barstate.isconfirmed
        alert("MA-Gold v38 | 🔴 SWING SELL | EP:" + _a_ep + " SL:" + _a_sl + " TP1:" + _a_tp1 + " TP3:" + _a_tp3 + " | LOT:" + _a_lot + " | " + _a_tk, alert.freq_once_per_bar)
    if _do_buy and mode_buy_sniper and not _trap_buy and barstate.isconfirmed
        alert("MA-Gold v38 | 🎯 SNIPER BUY | EP:" + _a_ep + " SL:" + _a_sl + " TP1:" + _a_tp1 + " | LOT:" + _a_lot + " | " + _a_tk, alert.freq_once_per_bar)
    if _do_sell and mode_sell_sniper and not _trap_sell and barstate.isconfirmed
        alert("MA-Gold v38 | 🎯 SNIPER SELL | EP:" + _a_ep + " SL:" + _a_sl + " TP1:" + _a_tp1 + " | LOT:" + _a_lot + " | " + _a_tk, alert.freq_once_per_bar)
    if _do_buy and mode_buy_kz and not _trap_buy and barstate.isconfirmed
        alert("MA-Gold v38 | ⚡ KZ BUY | EP:" + _a_ep + " SL:" + _a_sl + " | LOT:" + _a_lot + " | " + _a_tk, alert.freq_once_per_bar)
    if _do_sell and mode_sell_kz and not _trap_sell and barstate.isconfirmed
        alert("MA-Gold v38 | ⚡ KZ SELL | EP:" + _a_ep + " SL:" + _a_sl + " | LOT:" + _a_lot + " | " + _a_tk, alert.freq_once_per_bar)
    if _do_buy and mode_buy_intraday and not _trap_buy and barstate.isconfirmed
        alert("MA-Gold v38 | 📈 INTRADAY BUY | Score:" + _a_sc + " | LOT:" + _a_lot + " | " + _a_tk, alert.freq_once_per_bar)
    if _do_sell and mode_sell_intraday and not _trap_sell and barstate.isconfirmed
        alert("MA-Gold v38 | 📉 INTRADAY SELL | Score:" + _a_sc + " | LOT:" + _a_lot + " | " + _a_tk, alert.freq_once_per_bar)
    if _do_buy and mode_buy_scalp and not _trap_buy and barstate.isconfirmed
        alert("MA-Gold v38 | ⚡ SCALP BUY | LOT:" + _a_lot + " | " + _a_tk, alert.freq_once_per_bar)
    if _do_sell and mode_sell_scalp and not _trap_sell and barstate.isconfirmed
        alert("MA-Gold v38 | ⚡ SCALP SELL | LOT:" + _a_lot + " | " + _a_tk, alert.freq_once_per_bar)

    // ICT patterns
    if mmxm_bull and barstate.isconfirmed
        alert("MA-Gold v38 | MMXM BUY — Stop hunt→CHoCH→FVG | " + _a_tk, alert.freq_once_per_bar)
    if mmxm_bear and barstate.isconfirmed
        alert("MA-Gold v38 | MMXM SELL — Stop hunt→CHoCH→FVG | " + _a_tk, alert.freq_once_per_bar)
    if ob_fvg_ce_bull and barstate.isconfirmed
        alert("MA-Gold v38 | ✦ OB+FVG+CE BUY | " + _a_tk, alert.freq_once_per_bar)
    if ob_fvg_ce_bear and barstate.isconfirmed
        alert("MA-Gold v38 | ✦ OB+FVG+CE SELL | " + _a_tk, alert.freq_once_per_bar)
    if _lof_bull_val and barstate.isconfirmed
        alert("MA-Gold v38 | 🎭 LOF London Trap BUY [v38 precision: sweep " + str.tostring(math.round(_lof_bull_sweep_mag * 100.0) / 100.0,"#.##") + "ATR] | " + _a_tk, alert.freq_once_per_bar)
    if _lof_bear_val and barstate.isconfirmed
        alert("MA-Gold v38 | 🎭 LOF London Trap SELL [v38 precision: sweep " + str.tostring(math.round(_lof_bear_sweep_mag * 100.0) / 100.0,"#.##") + "ATR] | " + _a_tk, alert.freq_once_per_bar)

    // V32 new alert() calls
    if wyckoff_accum_conf and not wyckoff_accum_conf[1] and barstate.isconfirmed
        alert("MA-Gold v38 | 🌀 WYCKOFF ACCUM confirmed — spring+OBV+discount+HTF bull | " + _a_tk, alert.freq_once_per_bar)
    if wyckoff_dist_conf and not wyckoff_dist_conf[1] and barstate.isconfirmed
        alert("MA-Gold v38 | 🌀 WYCKOFF DIST confirmed — upthrust+OBV fall+premium+HTF bear | " + _a_tk, alert.freq_once_per_bar)
    if not na(_live_winrate) and _live_winrate < 55.0 and not (not na(_live_winrate[1]) and _live_winrate[1] < 55.0) and barstate.isconfirmed
        alert("MA-Gold v38 | ⚠ LIVE WIN RATE LOW: " + str.tostring(math.round(_live_winrate),"#") + "% — min_prob auto-tightened +5% | " + _a_tk, alert.freq_once_per_bar)
    if soro_bull and barstate.isconfirmed
        alert("MA-Gold v38 | SORO Breakout BUY | " + _a_tk, alert.freq_once_per_bar)
    if soro_bear and barstate.isconfirmed
        alert("MA-Gold v38 | SORO Breakout SELL | " + _a_tk, alert.freq_once_per_bar)

    // Liquidity & structure
    if sweep_confirmed_bull and barstate.isconfirmed
        alert("MA-Gold v38 | ✦ Sweep Confirmed BUY | " + _a_tk, alert.freq_once_per_bar)
    if sweep_confirmed_bear and barstate.isconfirmed
        alert("MA-Gold v38 | ✦ Sweep Confirmed SELL | " + _a_tk, alert.freq_once_per_bar)
    if internal_bull_choch and barstate.isconfirmed
        alert("MA-Gold v38 | CHoCH Bullish — structure shift | " + _a_tk, alert.freq_once_per_bar)
    if internal_bear_choch and barstate.isconfirmed
        alert("MA-Gold v38 | CHoCH Bearish — structure shift | " + _a_tk, alert.freq_once_per_bar)
    if aoe_breakout_bull and barstate.isconfirmed
        alert("MA-Gold v38 | AOE Breakout BUY | " + _a_tk, alert.freq_once_per_bar)
    if aoe_breakout_bear and barstate.isconfirmed
        alert("MA-Gold v38 | AOE Breakout SELL | " + _a_tk, alert.freq_once_per_bar)

    // Trade management
    if barstate.isconfirmed and is_reversal_imminent_bear and trade_lockdown and active_signal_dir == 1
        alert("MA-Gold v38 | ⚠ EXIT BUY — Reversal (" + str.tostring(bear_rev_count) + "/7) | " + _a_tk, alert.freq_once_per_bar)
    if barstate.isconfirmed and is_reversal_imminent_bull and trade_lockdown and active_signal_dir == -1
        alert("MA-Gold v38 | ⚠ EXIT SELL — Reversal (" + str.tostring(bull_rev_count) + "/7) | " + _a_tk, alert.freq_once_per_bar)

    // Risk / wait
    if wait_signal and barstate.isconfirmed
        string _wait_r = entropy_critical ? "ENTROPY" : score_conflict_zone ? "CONFLICT" : not signal_env_ok ? "ENV" : "TIED"
        alert("MA-Gold v38 | ⏸ WAIT (" + _wait_r + ") — Low probability environment | " + _a_tk, alert.freq_once_per_bar)

    // Gold macro
    if gold_inst_flow_bull and barstate.isconfirmed
        alert("MA-Gold v38 | 🏦 Inst. Gold flow BULLISH | " + _a_tk, alert.freq_once_per_bar)
    if gold_inst_flow_bear and barstate.isconfirmed
        alert("MA-Gold v38 | 🏦 Inst. Gold flow BEARISH | " + _a_tk, alert.freq_once_per_bar)
    if near_qtr_high and not near_qtr_high[1] and barstate.isconfirmed
        alert("MA-Gold v38 | 📍 IPDA Qtr High reached | " + _a_tk, alert.freq_once_per_bar)

f_trigger_alerts()

