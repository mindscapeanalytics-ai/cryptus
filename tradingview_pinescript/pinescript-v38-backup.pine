delete_boxes     = input.bool(true,  "Delete Old Boxes", group=G0)
manual_reset     = input.bool(false, "Manual Reset Signal", group=G0)
zigzag_len       = input.int(9, "ZigZag Length", minval=5, maxval=20, group=G0)

G1 = "PRO Intelligence"
show_signals     = input.bool(true,  "Show Signals", group=G1)
