var float _soro_lon_l = na
var bool  _soro_lon_rdy = false
var float _soro_ny_h  = na
var float _soro_ny_l  = na
var bool  _soro_ny_rdy = false

// NWOG / NDOG
var float prev_week_close = na
var float prev_day_close  = na

// Breaker blocks
var float last_bull_breaker_top = na
var float last_bull_breaker_bot = na
var float last_bear_breaker_top = na
var float last_bear_breaker_bot = na

// HTF MSS
var bool htf_mss_bull = false
var bool htf_mss_bear = false

// VWAP reclaim counters
var int _vwap_above_count = 0
var int _vwap_below_count = 0

// Score velocity tracking (pre-signal engine)
var int _prev_buy_score  = 0
var int _prev_sell_score = 0
var int _buy_vel_bars    = 0
var int _sell_vel_bars   = 0

// Probability carry-over (10% smoothing from prior bar)
var float _prob_buy_carry  = 50.0
var float _prob_sell_carry = 50.0

// State machine vars
var string persistent_signal_type  = "No Signal"
var color  persistent_signal_color = color.gray
var int    last_signal_bar_any     = 0
var int    active_signal_dir       = 0
var float  active_signal_prob      = 0.0
var int    active_signal_score     = 0
var bool   trade_lockdown          = false
var bool   tp1_already_reached     = false
var int    last_trade_tag_bar      = 0
var int    last_exit_label_bar     = 0
var float  _fvg_mid_buy            = 0.0
var float  _fvg_mid_sell           = 0.0
var bool   is_trade_voided         = false
var float  frozen_ep               = 0.0
var float  frozen_sl               = 0.0
var float  frozen_tp1              = 0.0
var float  frozen_tp2              = 0.0
var float  frozen_tp3              = 0.0
var float  frozen_risk             = 0.0
var string frozen_tier             = "SCALP"

// Swing confirmation counters
var int _swing_buy_consec  = 0
var int _swing_sell_consec = 0

// Dashboard table
var table dashboard = na

// Display scores (post-bonus final)
var int display_buy_score  = 0
var int display_sell_score = 0
// ARCH-15: raised to 80 — v32 Wyckoff+LiqPool+MTF bonuses push elite setups to 60-75
int score_max_display = 80

// Volume delta trend bools — var-persisted, computed in Section 15 (before Wyckoff/scoring)
// ARCH-01: no longer a forward-declaration issue; Section 15 computes before Section 16.
var bool delta_bull_trending = false
var bool delta_bear_trending = false

// ════════════════════════════════════════════════════════════════════════════
// V32 STATE VARS
// ════════════════════════════════════════════════════════════════════════════

// V32-FIX-04: Adaptive probability decay — track bars since last strong signal
var int  _bars_since_strong_signal = 999
var float _prob_buy_carry_decay    = 0.0
var float _prob_sell_carry_decay   = 0.0

// V32-FIX-07: Session-anchored VWAP
var float _anchored_vwap_sum   = 0.0
var float _anchored_vol_sum    = 0.0
var float _anchored_vwap_val   = na
var int   _anchor_session_start = 0

// V32-FIX-10: Rolling 50-signal outcome tracker
var float[] _signal_outcomes   = array.new_float(0)   // 1.0 = win, 0.0 = loss
var int[]   _signal_dirs       = array.new_int(0)      // 1 = buy, -1 = sell
var float[] _signal_eps        = array.new_float(0)
var float[] _signal_sls        = array.new_float(0)
var float[] _signal_tp1s       = array.new_float(0)
var int     _outcome_max       = 50
var float   _live_winrate      = na                    // 0-100%
var int     _total_signals     = 0
var int     _pending_outcome_dir = 0
var float   _pending_outcome_ep  = 0.0
var float   _pending_outcome_sl  = 0.0
var float   _pending_outcome_tp1 = 0.0
var bool    _outcome_pending   = false
var int     _consec_losses     = 0

// V32-FIX-12: Liquidity pool mapping — equal highs / equal lows
var float[] _eq_high_pool = array.new_float(0)
var float[] _eq_low_pool  = array.new_float(0)
var float   _nearest_eq_high = na
var float   _nearest_eq_low  = na
int   _liq_pool_score_buy  = 0
int   _liq_pool_score_sell = 0

// V32-FIX-01: Computed lot size
var float   _computed_lot_size = 0.0

// ════════════════════════════════════════════════════════════════════════════
// SECTION 3 — HELPER FUNCTIONS
// ════════════════════════════════════════════════════════════════════════════
f_safe_get_float(arr, ind) =>
    array.size(arr) > ind ? array.get(arr, array.size(arr) - 1 - ind) : na

f_safe_get_int(arr, ind) =>
    array.size(arr) > ind ? array.get(arr, array.size(arr) - 1 - ind) : na

f_delete_box_with_age(box_arr, age_arr) =>
    if array.size(box_arr) > 0 and array.size(age_arr) > 0
        bx = array.shift(box_arr)
        array.shift(age_arr)
        if delete_boxes and not na(bx)
            box.delete(bx)
    0

f_near(price, level, dist) =>
    not na(level) and math.abs(price - level) <= dist

f_get_box_extension() =>
    tf_minutes = timeframe.in_seconds(timeframe.period) / 60
    tf_minutes <= 15 ? 5 : tf_minutes <= 60 ? 8 : 10

// Logistic accumulation — avoids asymptote collapse above 80%
f_apply_factor(prob, weight) =>
    prob < 80.0 ? prob + (92.0 - prob) * weight : prob + (95.0 - prob) * weight * 0.5

// ════════════════════════════════════════════════════════════════════════════
// SECTION 4 — CORE CALCULATIONS
// ════════════════════════════════════════════════════════════════════════════
ema_fast = ta.ema(close, ema_fast_len)
ema_slow = ta.ema(close, ema_slow_len)
rsi_val  = ta.rsi(close, rsi_len)
atr_val  = ta.atr(atr_len)
atr_long = ta.atr(50)
vol_sma  = ta.sma(volume, 20)
vol_ok   = volume > vol_sma
vol_spike = volume > vol_sma * 1.5      // single canonical alias — V30-FIX-12
vol_surge = volume > vol_sma * 2.5      // institutional-level volume

[macd_line, macd_signal, macd_hist] = ta.macd(close, 12, 26, 9)
[di_plus, di_minus, adx_val] = ta.dmi(14, 14)
adx_trending     = adx_val > 20
adx_strong_trend = adx_val > 30
adx_ranging      = adx_val < 15

obv_val    = ta.obv
obv_sma    = ta.sma(obv_val, 20)
obv_rising = obv_val > obv_sma and obv_val > obv_val[3]
obv_falling= obv_val < obv_sma and obv_val < obv_val[3]
obv_bull_div = low  < ta.lowest(low[1],  8) and obv_val > ta.lowest(obv_val,  8)
obv_bear_div = high > ta.highest(high[1],8) and obv_val < ta.highest(obv_val, 8)

ema_diff     = math.abs(ema_fast - ema_slow)
ema_diff_avg = ta.sma(ema_diff, 20)
ema_squeeze  = ema_diff < ema_diff_avg * 0.5
ema_squeeze_release_bull = ema_squeeze[1] and not ema_squeeze and close > ema_fast
ema_squeeze_release_bear = ema_squeeze[1] and not ema_squeeze and close < ema_fast

kc_basis           = ta.ema(close, 20)
kc_atr_val         = ta.atr(10) * 2.0
kc_upper           = kc_basis + kc_atr_val
kc_lower           = kc_basis - kc_atr_val
kc_bull_exhaustion = close > kc_upper and rsi_val > 70 and macd_hist < macd_hist[1]
kc_bear_exhaustion = close < kc_lower and rsi_val < 30 and macd_hist > macd_hist[1]

is_ranging       = atr_val < atr_long * 0.6
trending_market  = not is_ranging
atr_sma_20       = ta.sma(atr_val, 20)
atr_rising       = atr_val > atr_val[1] and atr_val[1] > atr_val[2]
extreme_volatility = use_gold_volatility and atr_val > atr_long * 2.5
normal_volatility  = not extreme_volatility

vwap_val    = ta.vwap(hlc3)
vwap_stdev  = ta.stdev(hlc3, 100)
vwap_upper_2 = vwap_val + vwap_stdev * 2
vwap_lower_2 = vwap_val - vwap_stdev * 2
gold_institutional_flow = close > vwap_val
gold_institutional_sell = close < vwap_val
is_overbought_vwap      = close > vwap_upper_2
is_oversold_vwap        = close < vwap_lower_2

// V32-FIX-02: ATR normalization factor for scoring (scales zone-based bonuses by ATR regime)
// Prevents over-scoring in low-volatility environments and under-scoring in high-vol
float _atr_norm_raw    = atr_sma_20 > 0 ? nz(atr_val, atr_sma_20) / atr_sma_20 : 1.0  // ARCH-05: nz() safety on atr_val
float _atr_norm_factor = math.max(0.5, math.min(_atr_norm_raw, 1.75))  // clamp 0.5-1.75

// Pivot S/R
ph = ta.pivothigh(high, pivot_len, pivot_len)
pl = ta.pivotlow(low,  pivot_len, pivot_len)
if not na(ph)
    last_resistance := ph
if not na(pl)
    last_support := pl

// ════════════════════════════════════════════════════════════════════════════
// SECTION 5 — SESSION & TIME LOGIC
// ════════════════════════════════════════════════════════════════════════════
hour_utc     = hour(time, "UTC")
_minute_utc  = minute(time)

in_asian_session  = hour_utc >= 0  and hour_utc < 7
in_london_session = hour_utc >= 7  and hour_utc < 12
in_ny_session     = hour_utc >= 13 and hour_utc < 17
in_prime_session  = in_london_session or in_ny_session
avoid_asian       = use_asian_session_filter ? not in_asian_session : true

bool in_london_kz   = hour_utc >= 7  and hour_utc < 9
bool in_ny_kz       = hour_utc >= 13 and hour_utc < 15
bool in_silver_kz   = hour_utc >= 10 and hour_utc < 11
// BUG-04 FIXED: NY Silver Bullet (15:00 UTC) was outside in_kill_zone, causing
// session_multiplier and KZ bonuses to miss the 15:00 window entirely.
bool _in_ny_sb      = hour_utc == 15  // NY Silver Bullet 15:00-16:00 UTC
bool in_kill_zone   = in_london_kz or in_ny_kz or in_silver_kz or _in_ny_sb
string kill_zone_name = in_london_kz ? "London" : in_ny_kz ? "NY Open" : in_silver_kz ? "London SB" : _in_ny_sb ? "NY Silver Bullet" : ""

is_london_silver_bullet = hour_utc == 10
is_ny_silver_bullet     = _in_ny_sb  // BUG-04: reuse already-defined _in_ny_sb
is_silver_bullet        = is_london_silver_bullet or is_ny_silver_bullet

// TBOE — Time-Based Opening Extension (10:00-10:30 UTC micro-window)
bool in_tboe = hour_utc == 10 and _minute_utc <= 30

// London micro-window (7:00-7:30) for LOF detection
bool _london_micro = hour_utc == 7 and _minute_utc <= 30

// V32-FIX-07: Session-anchored VWAP (resets at London open 07:00 and NY open 13:00 UTC)
// Provides a more relevant intraday reference than rolling VWAP — anchored to session open
bool _new_anchor_session = (hour_utc == 7 and hour_utc[1] != 7) or (hour_utc == 13 and hour_utc[1] != 13)
if _new_anchor_session or bar_index == 0
    _anchored_vwap_sum    := hlc3 * volume
    _anchored_vol_sum     := volume
    _anchor_session_start := bar_index
else
    _anchored_vwap_sum := _anchored_vwap_sum + hlc3 * volume
    _anchored_vol_sum  := _anchored_vol_sum  + volume
_anchored_vwap_val := _anchored_vol_sum > 0 ? _anchored_vwap_sum / _anchored_vol_sum : vwap_val
bool anchored_vwap_bull = close > _anchored_vwap_val
bool anchored_vwap_bear = close < _anchored_vwap_val

// Session bonuses for scoring
silver_bullet_bonus = is_silver_bullet ? 2 : 0
prime_session_bonus = (in_prime_session and not in_kill_zone) ? 1 : 0

// FIX-S1: Added UTC timezone to time() — FOREX.com exchange TZ != UTC, causing Off-Session
// Also add in_prime_session as fallback so London/NY always count as valid
in_session = not use_session_filter or not na(time(timeframe.period, session_input, "UTC")) or in_prime_session

// Session backgrounds
ny_sess_active     = not na(time(timeframe.period, "0800-1700", "America/New_York"))
lon_sess_active    = not na(time(timeframe.period, "0300-1200", "America/New_York"))
asia_sess_active   = not na(time(timeframe.period, "1900-0400", "America/New_York"))
bgcolor(show_session_bg and ny_sess_active ? color.new(ny_session_color, session_bg_transparency) : na, title="NY BG")
bgcolor(show_session_bg and lon_sess_active and not ny_sess_active ? color.new(london_session_color, session_bg_transparency) : na, title="LON BG")
bgcolor(show_session_bg and asia_sess_active and not lon_sess_active and not ny_sess_active ? color.new(asia_session_color, session_bg_transparency) : na, title="ASIA BG")

// Volume-Weighted Bar Coloring
vol_ma_ref   = ta.sma(volume, vol_bar_ma_len)
vol_is_bold  = volume > vol_ma_ref * vol_bar_bold_mult
vol_is_light = volume < vol_ma_ref * vol_bar_light_mult
bar_bull_color = vol_is_bold ? color.new(#00e676,0) : vol_is_light ? color.new(#66bb6a,70) : color.new(#4caf50,30)
bar_bear_color = vol_is_bold ? color.new(#ff1744,0) : vol_is_light ? color.new(#ef5350,70) : color.new(#f44336,30)
barcolor(use_vol_weighted_bars ? (close >= open ? bar_bull_color : bar_bear_color) : na, title="Vol-Weighted Bars")

// Session open labels (TF <= 60m only)
bool _tf_ok_lbl = timeframe.in_seconds(timeframe.period) <= 3600
if _tf_ok_lbl
    if hour_utc == 7  and hour_utc[1] != 7
        label.new(bar_index, high + atr_val*0.3, "🟡 LONDON OPEN", color=color.new(#F2B807,85), textcolor=#F2B807, style=label.style_label_down, size=size.tiny)
    if hour_utc == 13 and hour_utc[1] != 13
        label.new(bar_index, high + atr_val*0.3, "🔴 NY OPEN",    color=color.new(#f24968,85), textcolor=#f24968, style=label.style_label_down, size=size.tiny)
    if hour_utc == 10 and hour_utc[1] != 10
        label.new(bar_index, high + atr_val*0.3, "⚡ SB WINDOW",  color=color.new(color.orange,85), textcolor=color.orange, style=label.style_label_down, size=size.tiny)
    if hour_utc == 12 and hour_utc[1] != 12
        label.new(bar_index, high + atr_val*0.3, "⚡ LDN/NY ⚡",  color=color.new(color.yellow,85), textcolor=color.yellow, style=label.style_label_down, size=size.tiny)
    // BUG-04 FIX: added NY Silver Bullet open label (was missing)
    if hour_utc == 15 and hour_utc[1] != 15
        label.new(bar_index, high + atr_val*0.3, "⚡ NY SB 15:00", color=color.new(color.fuchsia,85), textcolor=color.fuchsia, style=label.style_label_down, size=size.tiny)

// ════════════════════════════════════════════════════════════════════════════
// SECTION 6 — VOLUME PROFILE & AOE
// ════════════════════════════════════════════════════════════════════════════
if bar_index > vp_period_start + vp_lookback
    vp_period_start := bar_index - vp_lookback
    vp_period_high  := ta.highest(high, vp_lookback)
    vp_period_low   := ta.lowest(low,   vp_lookback)
else
    vp_period_high  := math.max(vp_period_high, high)
    vp_period_low   := math.min(vp_period_low,  low)

f_calc_vp() =>
    if not use_volume_profile
        [na, na, na]
    else
        for i = 0 to vp_rows - 1
            array.set(vp_volume_at_price, i, 0.0)
        price_range = vp_period_high - vp_period_low
        if price_range <= 0
            [na, na, na]
        else
            price_step      = price_range / vp_rows
            bars_in_period  = bar_index - vp_period_start
            lookback_bars   = math.min(bars_in_period, vp_lookback)
            for i = 0 to lookback_bars
                b_high  = high[i]
                b_low   = low[i]
                b_vol   = volume[i]
                b_range = b_high - b_low
                if b_high >= vp_period_low and b_low <= vp_period_high
                    for lv = 0 to vp_rows - 1
                        lv_lo = vp_period_low + lv       * price_step
                        lv_hi = vp_period_low + (lv + 1) * price_step
                        ov_hi = math.min(b_high, lv_hi)
                        ov_lo = math.max(b_low,  lv_lo)
                        if ov_hi >= ov_lo
                            ov = ov_hi - ov_lo
                            vp = b_range > 0 ? ov / b_range : 1.0 / vp_rows
                            array.set(vp_volume_at_price, lv, array.get(vp_volume_at_price, lv) + b_vol * vp)
            max_vol   = array.max(vp_volume_at_price)
            poc_idx   = array.indexof(vp_volume_at_price, max_vol)
            poc_price = vp_period_low + (poc_idx + 0.5) * price_step
            tot_vol   = array.sum(vp_volume_at_price)
            tgt_vol   = tot_vol * (vp_value_area_pct / 100)
            va_vol    = array.get(vp_volume_at_price, poc_idx)
            va_hi_i   = poc_idx
            va_lo_i   = poc_idx
            while va_vol < tgt_vol and (va_hi_i < vp_rows - 1 or va_lo_i > 0)
                v_ab = va_hi_i < vp_rows - 1 ? array.get(vp_volume_at_price, va_hi_i + 1) : 0.0
                v_bl = va_lo_i > 0            ? array.get(vp_volume_at_price, va_lo_i - 1) : 0.0
                if v_ab >= v_bl and va_hi_i < vp_rows - 1
                    va_hi_i += 1
                    va_vol  += v_ab
                else if va_lo_i > 0
                    va_lo_i -= 1
                    va_vol  += v_bl
                else
                    break
            [poc_price, vp_period_low + (va_hi_i + 1) * price_step, vp_period_low + va_lo_i * price_step]

if use_volume_profile and (bar_index - vp_last_calc_bar) >= vp_recalc_interval
    [_p, _h, _l] = f_calc_vp()
    vp_poc_level := _p
    vp_vah_level := _h
    vp_val_level := _l
    vp_last_calc_bar := bar_index
    if show_poc_line
        if not na(vp_poc_line)
            line.delete(vp_poc_line)
        if not na(vp_poc_level)
            vp_poc_line := line.new(bar_index - vp_lookback, vp_poc_level, bar_index + 20, vp_poc_level, color=poc_color, width=2, style=line.style_dashed)
    if show_vah_val
        if not na(vp_vah_line)
            line.delete(vp_vah_line)
        if not na(vp_val_line)
            line.delete(vp_val_line)
        if not na(vp_vah_level)
            vp_vah_line := line.new(bar_index - vp_lookback, vp_vah_level, bar_index + 20, vp_vah_level, color=va_color, width=1)
        if not na(vp_val_level)
            vp_val_line := line.new(bar_index - vp_lookback, vp_val_level, bar_index + 20, vp_val_level, color=va_color, width=1)

near_poc            = f_near(close, vp_poc_level, atr_val * 0.3)
inside_value_area   = f_near(close, (nz(vp_vah_level)+nz(vp_val_level))/2, (nz(vp_vah_level)-nz(vp_val_level))/2)
in_discount_va      = not na(vp_val_level) and close < vp_val_level
in_premium_va       = not na(vp_vah_level) and close > vp_vah_level

// AOE (Area of Interest)
if use_aoe
    array.push(aoe_close_arr, close)
    array.push(aoe_open_arr,  open)
    if array.size(aoe_close_arr) > aoe_lookback
        array.shift(aoe_close_arr)
        array.shift(aoe_open_arr)
    if array.size(aoe_close_arr) >= aoe_lookback
        aoe_high := array.max(aoe_close_arr)
        aoe_low  := array.min(aoe_close_arr)
        aoe_breakout_bull := close > aoe_high and close[1] <= aoe_high and volume > vol_sma * 1.2
        aoe_breakout_bear := close < aoe_low  and close[1] >= aoe_low  and volume > vol_sma * 1.2
        if show_aoe_box and not na(aoe_high) and not na(aoe_low)
            if not na(aoe_box)
                box.delete(aoe_box)
            aoe_box := box.new(bar_index - aoe_lookback, aoe_high, bar_index + 5, aoe_low,
                 bgcolor=aoe_box_color, border_color=color.new(color.purple, 70), text="AOI", text_color=color.new(color.purple,30), text_size=size.tiny)

// ════════════════════════════════════════════════════════════════════════════
// SECTION 7 — ADAPTIVE ATR (K-MEANS SUPERTREND)
// ════════════════════════════════════════════════════════════════════════════
if barstate.isfirst and use_adaptive_atr
    array.clear(atr_test_factors)
    array.clear(atr_trackers)
    for i = 0 to int((atr_max_factor - atr_min_factor) / atr_step_val)
        fac = atr_min_factor + i * atr_step_val
        array.push(atr_test_factors, fac)
        array.push(atr_trackers, adaptive_atr_tracker.new(factor=fac, upper=hl2, lower=hl2, output=hl2))

if use_adaptive_atr and array.size(atr_trackers) > 0 and bar_index > adaptive_last_update
    for i = 0 to array.size(atr_trackers) - 1
        tr = array.get(atr_trackers, i)
        up_v = hl2 + atr_val * tr.factor
        dn_v = hl2 - atr_val * tr.factor
        tr.trend := close > tr.upper ? 1 : close < tr.lower ? 0 : tr.trend
        tr.upper := close[1] < tr.upper ? math.min(up_v, tr.upper) : up_v
        tr.lower := close[1] > tr.lower ? math.max(dn_v, tr.lower) : dn_v
        tr.output := tr.trend == 1 ? tr.lower : tr.upper
        diff_v  = nz(math.sign(close[1] - tr.output))
        alpha_v = 2.0 / (perf_memory + 1)
        tr.perf += alpha_v * (nz(close - close[1]) * diff_v - tr.perf)
    perf_data   = array.new_float(0)
    factor_data = array.new_float(0)
    for el in atr_trackers
        perf_data.push(el.perf)
        factor_data.push(el.factor)
    if perf_data.size() >= 3
        var float[] centroids = array.new_float(3)
        centroids.set(0, perf_data.percentile_linear_interpolation(25))
        centroids.set(1, perf_data.percentile_linear_interpolation(50))
        centroids.set(2, perf_data.percentile_linear_interpolation(75))
        if na(km_factor_clusters)
            km_factor_clusters := array.new<kmeans_vector>(3)
            km_perf_clusters   := array.new<kmeans_vector>(3)
        for i = 0 to 2
            km_factor_clusters.set(i, kmeans_vector.new(array.new_float(0)))
            km_perf_clusters.set(i, kmeans_vector.new(array.new_float(0)))
        for _iter = 0 to 15
            for i = 0 to 2
                km_factor_clusters.get(i).out.clear()
                km_perf_clusters.get(i).out.clear()
            for i = 0 to perf_data.size() - 1
                val = perf_data.get(i)
                d0  = math.abs(val - centroids.get(0))
                d1  = math.abs(val - centroids.get(1))
                d2  = math.abs(val - centroids.get(2))
                idx = d0 <= d1 and d0 <= d2 ? 0 : d1 <= d2 ? 1 : 2
                km_perf_clusters.get(idx).out.push(val)
                km_factor_clusters.get(idx).out.push(factor_data.get(i))
            c0 = km_perf_clusters.get(0).out.size() > 0 ? km_perf_clusters.get(0).out.avg() : centroids.get(0)
            c1 = km_perf_clusters.get(1).out.size() > 0 ? km_perf_clusters.get(1).out.avg() : centroids.get(1)
            c2 = km_perf_clusters.get(2).out.size() > 0 ? km_perf_clusters.get(2).out.avg() : centroids.get(2)
            if c0 == centroids.get(0) and c1 == centroids.get(1) and c2 == centroids.get(2)
                break
            centroids.set(0, c0)
            centroids.set(1, c1)
            centroids.set(2, c2)
        best_idx = centroids.get(0) >= centroids.get(1) and centroids.get(0) >= centroids.get(2) ? 0 : (centroids.get(1) >= centroids.get(2) ? 1 : 2)
        bcf = km_factor_clusters.get(best_idx).out
        adaptive_best_factor := bcf.size() > 0 ? bcf.avg() : 1.5
        den_ama = ta.ema(math.abs(close - close[1]), int(perf_memory))
        km_perf_index := den_ama > 0 ? math.max(nz(km_perf_clusters.get(best_idx).out.avg()), 0) / den_ama : 0
    adaptive_last_update := bar_index

current_adaptive_factor = use_adaptive_atr ? adaptive_best_factor : 1.5
zone_dist = use_adaptive_atr ? nz(atr_val,1.0) * (current_adaptive_factor * 0.5) : nz(atr_val,1.0) * zone_atr_mult  // ARCH-05: nz() guard

km_st_upper = hl2 + atr_val * current_adaptive_factor
km_st_lower = hl2 - atr_val * current_adaptive_factor
var float km_trailing_stop = na
var int   km_trailing_trend = 0
km_trailing_trend := close > nz(km_trailing_stop, close) ? 1 : close < nz(km_trailing_stop, close) ? 0 : nz(km_trailing_trend, 1)
km_trailing_stop  := km_trailing_trend == 1 ? math.max(nz(km_trailing_stop, km_st_lower), km_st_lower) : math.min(nz(km_trailing_stop, km_st_upper), km_st_upper)
km_supertrend_os  := km_trailing_trend
perf_alpha = math.pow(nz(km_perf_index), 2)
km_perf_ama := nz(km_perf_ama, close) + perf_alpha * (close - nz(km_perf_ama, close))

// ════════════════════════════════════════════════════════════════════════════
// SECTION 8 — ZIGZAG & MARKET STRUCTURE
// ════════════════════════════════════════════════════════════════════════════
to_up   = high >= ta.highest(high, zigzag_len)
to_down = low  <= ta.lowest(low,  zigzag_len)
trend   := nz(trend[1], 1)
trend   := trend == 1 and to_down ? -1 : trend == -1 and to_up ? 1 : trend

last_trend_up_since   = ta.barssince(to_up[1])
low_val               = ta.lowest(nz(last_trend_up_since   > 0 ? last_trend_up_since   : 1, 1), 100)
low_index             = bar_index - ta.barssince(low_val  == low)
last_trend_down_since = ta.barssince(to_down[1])
high_val              = ta.highest(nz(last_trend_down_since > 0 ? last_trend_down_since : 1, 1), 100)
high_index            = bar_index - ta.barssince(high_val == high)

if ta.change(trend) != 0
    if trend == 1
        array.push(low_points_arr,  low_val)
        array.push(low_index_arr,   low_index)
        if array.size(low_points_arr) > 5
            array.shift(low_points_arr)
        if array.size(low_index_arr) > 5
            array.shift(low_index_arr)
    if trend == -1
        array.push(high_points_arr, high_val)
        array.push(high_index_arr,  high_index)
        if array.size(high_points_arr) > 5
            array.shift(high_points_arr)
        if array.size(high_index_arr) > 5
            array.shift(high_index_arr)

f_get_high(ind) => [f_safe_get_float(high_points_arr, ind), f_safe_get_int(high_index_arr, ind)]
f_get_low(ind)  => [f_safe_get_float(low_points_arr,  ind), f_safe_get_int(low_index_arr,  ind)]

[h0_raw, h0i] = f_get_high(0)
[h1_raw, h1i] = f_get_high(1)
[l0_raw, l0i] = f_get_low(0)
[l1_raw, l1i] = f_get_low(1)

// V30-FIX: ZigZag sanity filter tightened to 5% — Gold precision
// BUG-11 FIXED: Added 10% fallback window so strong trends (>5% swing) still get valid h0/l0
// Without this, $150+ gold moves (>5% from current price) silently null out OTE/Fib/discount calcs
h0 = not na(h0_raw) and h0_raw > close*0.90 and h0_raw < close*1.10 ? h0_raw : na
h1 = not na(h1_raw) and h1_raw > close*0.90 and h1_raw < close*1.10 ? h1_raw : na
l0 = not na(l0_raw) and l0_raw < close*1.10 and l0_raw > close*0.90 ? l0_raw : na
l1 = not na(l1_raw) and l1_raw < close*1.10 and l1_raw > close*0.90 ? l1_raw : na

market   := nz(market[1], 1)
last_l0   = ta.valuewhen(ta.change(market) != 0, l0, 0)
last_h0   = ta.valuewhen(ta.change(market) != 0, h0, 0)
is_bull_break = not na(h0) and close > h0 and close[1] <= h0 and (math.max(open,close)-math.min(open,close)) > (high-low)*0.4
is_bear_break = not na(l0) and close < l0 and close[1] >= l0 and (math.max(open,close)-math.min(open,close)) > (high-low)*0.4
market := last_l0==l0 or last_h0==h0 ? market : market==1 and is_bear_break ? -1 : market==-1 and is_bull_break ? 1 : market
new_structure_break = ta.change(market) != 0

var int last_msb_bar = 0
var int last_msb_dir = 0
if new_structure_break
    last_msb_bar := bar_index
    last_msb_dir := market
msb_bars_ago = bar_index - last_msb_bar
msb_recent   = msb_bars_ago <= 20

// BSL / SSL liquidity levels
bsl_level = ta.highest(high, 20)
ssl_level = ta.lowest(low,  20)
bsl_swept = high > bsl_level[1] and close < bsl_level[1]
ssl_swept  = low  < ssl_level[1] and close > ssl_level[1]

// EQH / EQL
is_eqh = not na(h0) and not na(h1) and math.abs(h0 - h1) <= atr_val * 0.15
is_eql = not na(l0) and not na(l1) and math.abs(l0 - l1) <= atr_val * 0.15
plotshape(is_eqh and ta.change(is_eqh), title="EQH", location=location.abovebar, style=shape.triangledown, color=color.new(#FF5252,40), size=size.tiny, text="EQH")
plotshape(is_eql and ta.change(is_eql), title="EQL", location=location.belowbar, style=shape.triangleup,   color=color.new(#00BFA5,40), size=size.tiny, text="EQL")

// S/R zone proximity
near_support    = f_near(close, last_support,    zone_dist)
near_resistance = f_near(close, last_resistance, zone_dist)

var int support_touches    = 0
var int resistance_touches = 0
if near_support    and not near_support[1]
    support_touches    += 1
if near_resistance and not near_resistance[1]
    resistance_touches += 1
if not na(pl) and pl != pl[1]
    support_touches    := 0
if not na(ph) and ph != ph[1]
    resistance_touches := 0
bool is_strong_support    = support_touches    >= 2
bool is_strong_resistance = resistance_touches >= 2

// ════════════════════════════════════════════════════════════════════════════
// SECTION 9 — INTERNAL STRUCTURE (ICT SMC BOS / CHoCH)
// ════════════════════════════════════════════════════════════════════════════
int_ph = ta.pivothigh(high, internal_sensitivity, internal_sensitivity)
int_pl = ta.pivotlow(low,   internal_sensitivity, internal_sensitivity)
internal_bull_bos   := false
internal_bear_bos   := false
internal_bull_choch := false
internal_bear_choch := false

if show_internal_structure
    if not na(int_ph)
        if int_ph > nz(int_stru_up_axis)
            if int_stru_moving == -1
                internal_bull_choch := true
                if int_stru_type == "All" or int_stru_type == "CHoCH"
                    label.new(bar_index-internal_sensitivity, int_ph, "I-CHoCH", color=color.new(color.black,100), style=label.style_label_down, textcolor=color.lime, size=size.tiny)
            else
                internal_bull_bos := true
                if int_stru_type == "All" or int_stru_type == "BoS"
                    label.new(bar_index-internal_sensitivity, int_ph, "I-BoS", color=color.new(color.black,100), style=label.style_label_down, textcolor=color.green, size=size.tiny)
            int_stru_moving := 1
        int_stru_up_axis    := int_ph
        int_stru_up_axis_bar:= bar_index-internal_sensitivity
    if not na(int_pl)
        if int_pl < nz(int_stru_dn_axis)
            if int_stru_moving == 1
                internal_bear_choch := true
                if int_stru_type == "All" or int_stru_type == "CHoCH"
                    label.new(bar_index-internal_sensitivity, int_pl, "I-CHoCH", color=color.new(color.black,100), style=label.style_label_up, textcolor=color.red, size=size.tiny)
            else
                internal_bear_bos := true
                if int_stru_type == "All" or int_stru_type == "BoS"
                    label.new(bar_index-internal_sensitivity, int_pl, "I-BoS", color=color.new(color.black,100), style=label.style_label_up, textcolor=color.maroon, size=size.tiny)
            int_stru_moving := -1
        int_stru_dn_axis    := int_pl
        int_stru_dn_axis_bar:= bar_index-internal_sensitivity

// ════════════════════════════════════════════════════════════════════════════
// SECTION 10 — PRICE LEVELS (PDH/PDL/PWH/PWL/NWOG/NDOG/IPDA)
// ════════════════════════════════════════════════════════════════════════════
pdh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_on)
pdl = request.security(syminfo.tickerid, "D", low[1],  lookahead=barmerge.lookahead_on)
pdm = (pdh + pdl) / 2
pwh = request.security(syminfo.tickerid, "W", high[1], lookahead=barmerge.lookahead_on)
pwl = request.security(syminfo.tickerid, "W", low[1],  lookahead=barmerge.lookahead_on)
near_pdh   = f_near(high, pdh, atr_val*0.3)
near_pdl   = f_near(low,  pdl, atr_val*0.3)
sweep_pdh  = high > pdh and close < pdh
sweep_pdl  = low  < pdl and close > pdl
near_pwh   = f_near(high, pwh, atr_val*0.5)
near_pwl   = f_near(low,  pwl, atr_val*0.5)
sweep_pwh  = high > pwh and close < pwh
sweep_pwl  = low  < pwl and close > pwl

// NWOG / NDOG
bool is_week_open = dayofweek(time) == dayofweek.monday and dayofweek(time[1]) != dayofweek.monday
bool is_day_open  = hour_utc == 0 and hour_utc[1] != 0
if is_week_open
    prev_week_close := close[1]
if is_day_open
    prev_day_close  := close[1]
nwog_gap   = not na(prev_week_close) ? open - prev_week_close : 0.0
ndog_gap   = not na(prev_day_close)  ? open - prev_day_close  : 0.0
nwog_bull  = nwog_gap > atr_val * 0.5
nwog_bear  = nwog_gap < -(atr_val * 0.5)
ndog_bull  = ndog_gap > atr_val * 0.3
ndog_bear  = ndog_gap < -(atr_val * 0.3)
nwog_fill_level = not na(prev_week_close) ? prev_week_close : na
ndog_fill_level = not na(prev_day_close)  ? prev_day_close  : na
near_nwog_fill  = not na(nwog_fill_level) and math.abs(close - nwog_fill_level) <= atr_val*0.4
near_ndog_fill  = not na(ndog_fill_level) and math.abs(close - ndog_fill_level) <= atr_val*0.3

// Quarterly IPDA (institutional liquidity targets)
float qtr_high = request.security(syminfo.tickerid, "3M", high[1], lookahead=barmerge.lookahead_on)
float qtr_low  = request.security(syminfo.tickerid, "3M", low[1],  lookahead=barmerge.lookahead_on)
bool  near_qtr_high = f_near(high, qtr_high, atr_val * 1.0)
bool  near_qtr_low  = f_near(low,  qtr_low,  atr_val * 1.0)

// Weekly / Monthly macro bias
// BUG-07 FIXED: was open[0] with lookahead_on (future leak in backtest). Changed to lookahead_off.
weekly_open        = request.security(syminfo.tickerid, "W", open[0], lookahead=barmerge.lookahead_off)
monthly_open       = request.security(syminfo.tickerid, "M", open[0], lookahead=barmerge.lookahead_off)
above_weekly_open  = close > weekly_open
above_monthly_open = close > monthly_open
weekly_bias_bull   = above_weekly_open
weekly_bias_bear   = not above_weekly_open
monthly_bias_bull  = above_monthly_open
macro_bull_aligned = weekly_bias_bull and monthly_bias_bull
macro_bear_aligned = not weekly_bias_bull and not monthly_bias_bull

// Seasonal bias (Q1: gold bullish Jan-Mar historically)
bool seasonal_bull_bias = (month(time) >= 1  and month(time) <= 3)  or (month(time) == 9)
bool seasonal_bear_bias = (month(time) >= 7  and month(time) <= 8)  or (month(time) == 11)

// Quarterly rebalancing period (last 2 weeks of quarter-end months)
bool _qtr_rebal = (month(time) == 3 or month(time) == 6 or month(time) == 9 or month(time) == 12) and dayofmonth(time) >= 15

// NY midnight open
if hour_utc == 0 and hour_utc[1] != 0
    ny_midnight_open := open
above_midnight_open = not na(ny_midnight_open) and close > ny_midnight_open
below_midnight_open = not na(ny_midnight_open) and close < ny_midnight_open

// Round / half numbers (Gold magnets)
round_number_base     = 50
current_price_rounded = math.round(close / round_number_base) * round_number_base
distance_to_round     = math.abs(close - current_price_rounded)
near_round_number     = use_round_numbers and distance_to_round <= gold_round_number_dist
century_level         = math.round(close / 100) * 100
near_century          = math.abs(close - century_level) <= gold_round_number_dist * 1.5
// V30-FIX-09: Half-round tolerance uses input-based distance (was too wide ATR-based)
is_half_round         = math.abs(close - (math.floor(close/50)*50 + 25)) <= gold_round_number_dist * 0.5
is_high_precision_window = in_kill_zone and (near_round_number or near_century)
_half_round_level_val    = math.floor(close/50)*50 + 25

// HTF EMA + bias (V27-FIX: 0.08% neutral band prevents premature bias flip)
f_get_mtf_ema(tf, len) => request.security(syminfo.tickerid, tf, ta.ema(close, len)[1], lookahead=barmerge.lookahead_on)
htf_ema   = f_get_mtf_ema(htf_tf, htf_ema_len)
htf_close = request.security(syminfo.tickerid, htf_tf, close[1], lookahead=barmerge.lookahead_on)
float _htf_band = htf_ema * 0.0008
htf_bull  = htf_close > htf_ema + _htf_band
htf_bear  = htf_close < htf_ema - _htf_band

// HTF MSS (Market Structure Shift on HTF)
float htf_high_prev = request.security(syminfo.tickerid, htf_tf, ta.highest(high[1], 5), lookahead=barmerge.lookahead_on)
float htf_low_prev  = request.security(syminfo.tickerid, htf_tf, ta.lowest(low[1],   5), lookahead=barmerge.lookahead_on)
bool  htf_bos_bull  = htf_close > htf_high_prev
bool  htf_bos_bear  = htf_close < htf_low_prev
if htf_bos_bull
    htf_mss_bull := true
    htf_mss_bear := false
if htf_bos_bear
    htf_mss_bear := true
    htf_mss_bull := false

// MTF confluence (15m / 1h / 4h)
mtf_15m_c   = request.security(syminfo.tickerid, "15",  close[1], lookahead=barmerge.lookahead_on)
mtf_1h_c    = request.security(syminfo.tickerid, "60",  close[1], lookahead=barmerge.lookahead_on)
mtf_4h_c    = request.security(syminfo.tickerid, "240", close[1], lookahead=barmerge.lookahead_on)
mtf_15m_ema = request.security(syminfo.tickerid, "15",  ta.ema(close, 50)[1], lookahead=barmerge.lookahead_on)
mtf_1h_ema  = request.security(syminfo.tickerid, "60",  ta.ema(close, 50)[1], lookahead=barmerge.lookahead_on)
mtf_4h_ema  = request.security(syminfo.tickerid, "240", ta.ema(close, 50)[1], lookahead=barmerge.lookahead_on)
mtf_bullish_confluence = mtf_1h_c > mtf_1h_ema and htf_bull
mtf_bearish_confluence = mtf_1h_c < mtf_1h_ema and htf_bear

// HTF Bias Strength (0-4 scale)
float _htf_gap_pct = not na(htf_ema) and htf_ema > 0 ? math.abs(htf_close - htf_ema) / htf_ema * 100 : 0.0
int htf_bias_strength = (_htf_gap_pct > 1.0 ? 1 : 0) + (mtf_4h_c > mtf_4h_ema and htf_bull ? 1 : 0) + (adx_trending and di_plus > di_minus and htf_bull ? 1 : adx_trending and di_minus > di_plus and htf_bear ? 1 : 0) + (macro_bull_aligned and htf_bull ? 1 : macro_bear_aligned and htf_bear ? 1 : 0)

// DXY macro
dxy_close          = request.security(dxy_symbol, timeframe.period, close[1], lookahead=barmerge.lookahead_on)
dxy_ema            = ta.ema(nz(dxy_close, close), 20)
dxy_rsi            = ta.rsi(nz(dxy_close, close), 14)
dxy_bullish        = nz(dxy_close) > nz(dxy_ema) and dxy_rsi > 50
dxy_bearish        = nz(dxy_close) < nz(dxy_ema) and dxy_rsi < 50
gold_dxy_confluence_bull = dxy_bearish or na(dxy_close)
gold_dxy_confluence_bear = dxy_bullish or na(dxy_close)

// SMT Divergence (Gold vs DXY)
smt_divergence_bull = dxy_close > ta.highest(nz(dxy_close[1],dxy_close),10) and not (high > ta.highest(high[1],10)) and htf_bull
smt_divergence_bear = dxy_close < ta.lowest(nz(dxy_close[1],dxy_close),10) and not (low  < ta.lowest(low[1],10))  and htf_bear

// Strong Daily bias
strong_daily_bull = htf_close > htf_ema and htf_bull and macro_bull_aligned
strong_daily_bear = htf_close < htf_ema and htf_bear and macro_bear_aligned

// News buffer
potential_news_event = use_news_buffer and atr_rising and extreme_volatility
safe_to_trade        = not potential_news_event

// IPDA plots (quarter high/low — only when price is close)
float _scale_safety_limit = close * 0.05
plot(not na(qtr_high) and math.abs(close - qtr_high) < _scale_safety_limit ? qtr_high : na, "IPDA Qtr High", color=color.new(#FF5252, 40), style=plot.style_linebr, linewidth=2)
plot(not na(qtr_low)  and math.abs(close - qtr_low)  < _scale_safety_limit ? qtr_low  : na, "IPDA Qtr Low",  color=color.new(#00BFA5, 40), style=plot.style_linebr, linewidth=2)

// ════════════════════════════════════════════════════════════════════════════
// SECTION 11 — SESSION SWEEPS, JUDAS, AMD, PO3, SORO
// ════════════════════════════════════════════════════════════════════════════
// Judas Swing (session-open manipulation sweep)
is_london_judas_window = hour_utc == 7  and _minute_utc <= 30
is_ny_judas_window     = hour_utc == 13 and _minute_utc <= 30
is_judas_window        = is_london_judas_window or is_ny_judas_window
var float judas_window_open = na
var int   judas_window_bar  = 0
if (is_london_judas_window and not is_london_judas_window[1]) or (is_ny_judas_window and not is_ny_judas_window[1])
    judas_window_open := open
    judas_window_bar  := bar_index
judas_high_sweep = is_judas_window and not na(judas_window_open) and high > judas_window_open + atr_val*0.5 and close < judas_window_open
judas_low_sweep  = is_judas_window and not na(judas_window_open) and low  < judas_window_open - atr_val*0.5 and close > judas_window_open
judas_bearish    = judas_high_sweep
judas_bullish    = judas_low_sweep
if judas_bullish
    judas_bull_active := true
    judas_bear_active := false
    last_judas_bar    := bar_index
if judas_bearish
    judas_bear_active := true
    judas_bull_active := false
    last_judas_bar    := bar_index
if (bar_index - last_judas_bar) > 12
    judas_bull_active := false
    judas_bear_active := false

// Asian Range
if hour_utc == 0 and hour_utc[1] != 0
    asian_high := high
    asian_low  := low
if in_asian_session
    asian_high := math.max(nz(asian_high, high), high)
    asian_low  := math.min(nz(asian_low,  low),  low)
sweep_asian_high = in_london_session and high > asian_high and close < asian_high
sweep_asian_low  = in_london_session and low  < asian_low  and close > asian_low

// Asian Accumulation Range Box (PO3 visual)
if hour_utc == 0 and hour_utc[1] != 0
    asian_range_start := bar_index
    if not na(asian_range_box)
        box.delete(asian_range_box)
        asian_range_box := na
if in_asian_session and not na(asian_high) and not na(asian_low)
    if na(asian_range_box)
        asian_range_box := box.new(asian_range_start, asian_high, bar_index+1, asian_low, bgcolor=color.new(#14D990,92), border_color=color.new(#14D990,60), border_width=1, text="ACCUM", text_color=color.new(#14D990,40), text_size=size.tiny)
    else
        box.set_top(asian_range_box,   asian_high)
        box.set_bottom(asian_range_box, asian_low)
        box.set_right(asian_range_box,  bar_index+1)
if hour_utc == 7 and hour_utc[1] != 7 and not na(asian_range_box)
    box.set_right(asian_range_box, bar_index)

// London first candle bias
if hour_utc == 7  and hour_utc[1] != 7
    london_open_price         := open
    london_first_candle_bull  := false
    london_first_candle_bear  := false
if hour_utc == 8  and hour_utc[1] != 8 and not na(london_open_price)
    london_first_candle_bull  := close > london_open_price
    london_first_candle_bear  := close < london_open_price
if hour_utc == 12 and hour_utc[1] != 12
    london_first_candle_bull  := false
    london_first_candle_bear  := false

// AMD Cycle
bool amd_accumulation = in_asian_session and not na(asian_high) and not na(asian_low) and (asian_high - asian_low) < atr_val*2.0
bool amd_manipulation = is_judas_window  and (judas_bullish or judas_bearish)
if amd_manipulation
    _last_amd_manip_bar := bar_index
bool _amd_manip_recent = (bar_index - _last_amd_manip_bar) <= 3
bool amd_distribution  = (in_london_session or in_ny_session) and _amd_manip_recent
bool amd_cycle_bull    = amd_distribution and judas_bull_active
bool amd_cycle_bear    = amd_distribution and judas_bear_active
bool is_manipulation   = in_london_session and (low < pdl or high > pdh or sweep_asian_high or sweep_asian_low)

// PO3 (Power of 3) — accumulation / manipulation / distribution
bool _new_london_po3 = hour_utc == 7  and hour_utc[1] != 7
bool _new_ny_po3     = hour_utc == 13 and hour_utc[1] != 13
if _new_london_po3 or _new_ny_po3
    po3_open := open
    po3_high := high
    po3_low  := low
if in_london_session or in_ny_session
    po3_high := math.max(nz(po3_high, high), high)
    po3_low  := math.min(nz(po3_low,  low),  low)
float _po3_manip_thr = atr_val * 0.65
bool po3_manip_bull  = not na(po3_open) and low  < po3_open - _po3_manip_thr and close > po3_open and htf_bull
bool po3_manip_bear  = not na(po3_open) and high > po3_open + _po3_manip_thr and close < po3_open and htf_bear
bool po3_dist_bull   = not na(po3_open) and (po3_manip_bull[1] or po3_manip_bull[2] or po3_manip_bull[3]) and close > po3_open and close > close[1]
bool po3_dist_bear   = not na(po3_open) and (po3_manip_bear[1] or po3_manip_bear[2] or po3_manip_bear[3]) and close < po3_open and close < close[1]

// SORO (Session Opening Range Breakout)
bool _in_lon_range = in_london_kz and hour_utc == 7  and _minute_utc <= 30
bool _in_ny_range  = in_ny_kz     and hour_utc == 13 and _minute_utc <= 30
if _new_london_po3
    _soro_lon_h := na
    _soro_lon_l := na
    _soro_lon_rdy := false
if _new_ny_po3
    _soro_ny_h := na
    _soro_ny_l := na
    _soro_ny_rdy := false
if _in_lon_range
    _soro_lon_h := na(_soro_lon_h) ? high : math.max(_soro_lon_h, high)
    _soro_lon_l := na(_soro_lon_l) ? low  : math.min(_soro_lon_l, low)
if not _in_lon_range and _in_lon_range[1]
    _soro_lon_rdy := true
if _in_ny_range
    _soro_ny_h := na(_soro_ny_h) ? high : math.max(_soro_ny_h, high)
    _soro_ny_l := na(_soro_ny_l) ? low  : math.min(_soro_ny_l, low)
if not _in_ny_range and _in_ny_range[1]
    _soro_ny_rdy := true
bool soro_bull = (_soro_lon_rdy and not na(_soro_lon_h) and close > _soro_lon_h and close[1] <= _soro_lon_h and vol_spike and htf_bull) or (_soro_ny_rdy and not na(_soro_ny_h) and close > _soro_ny_h and close[1] <= _soro_ny_h and vol_spike and htf_bull)
bool soro_bear = (_soro_lon_rdy and not na(_soro_lon_l) and close < _soro_lon_l and close[1] >= _soro_lon_l and vol_spike and htf_bear) or (_soro_ny_rdy and not na(_soro_ny_l) and close < _soro_ny_l and close[1] >= _soro_ny_l and vol_spike and htf_bear)

// Displacement candles
bool _bull_disp = close > open and math.abs(close-open) > atr_val*1.5 and math.abs(close-open) > (high-low)*0.7 and volume > vol_sma*1.8
bool _bear_disp = close < open and math.abs(close-open) > atr_val*1.5 and math.abs(close-open) > (high-low)*0.7 and volume > vol_sma*1.8
bull_disp_aligned = _bull_disp and htf_bull
bear_disp_aligned = _bear_disp and htf_bear

// ════════════════════════════════════════════════════════════════════════════
// SECTION 12 — FVG + OB DETECTION
// ════════════════════════════════════════════════════════════════════════════
bull_fvg = low > high[2] and (low - high[2]) >= atr_val * 0.1
bear_fvg = high < low[2] and (low[2] - high) >= atr_val * 0.1

// Stacked FVG detection (+3 score bonus)
stacked_bull_fvg = bull_fvg and bull_fvg[1]
stacked_bear_fvg = bear_fvg and bear_fvg[1]

// FVG boxes
if show_fvg and bull_fvg
    _b = box.new(bar_index-2, low, bar_index + f_get_box_extension(), high[2], bgcolor=bu_ob_color, border_color=bu_ob_border_color, text="FVG", text_color=bu_ob_text_color, text_size=text_size)
    array.push(bu_fvg_boxes, _b)
    array.push(bu_fvg_ages,  bar_index)
if show_fvg and bear_fvg
    _b = box.new(bar_index-2, high, bar_index + f_get_box_extension(), low[2], bgcolor=be_ob_color, border_color=be_ob_border_color, text="FVG", text_color=be_ob_text_color, text_size=text_size)
    array.push(be_fvg_boxes, _b)
    array.push(be_fvg_ages,  bar_index)

// FVG contraction (partial fill)
if use_fvg_contraction
    for _fvg in bu_fvg_boxes
        if not na(_fvg)
            _t = box.get_top(_fvg)
            _b = box.get_bottom(_fvg)
            if low < _t and low > _b
                box.set_bottom(_fvg, low)
    for _fvg in be_fvg_boxes
        if not na(_fvg)
            _t = box.get_top(_fvg)
            _b = box.get_bottom(_fvg)
            if high > _b and high < _t
                box.set_top(_fvg, high)

// FVG zone membership
in_bu_fvg = false
in_be_fvg = false
for _fvg in bu_fvg_boxes
    if not na(_fvg) and close >= box.get_bottom(_fvg) and close <= box.get_top(_fvg)
        in_bu_fvg := true
for _fvg in be_fvg_boxes
    if not na(_fvg) and close >= box.get_bottom(_fvg) and close <= box.get_top(_fvg)
        in_be_fvg := true

// FVG CE (Consequent Encroachment — midpoint sniper entry)
float fvg_ce_bull = na
float fvg_ce_bear = na
bool at_fvg_ce_bull = false
bool at_fvg_ce_bear = false
if array.size(bu_fvg_boxes) > 0
    float _nt = na
    float _nb = na
    for _fvg in bu_fvg_boxes
        if not na(_fvg)
            _t = box.get_top(_fvg)
            _b = box.get_bottom(_fvg)
            if close >= _b and close <= _t
                if na(_nt) or _t < _nt
                    _nt := _t
                    _nb := _b
    if not na(_nt)
        fvg_ce_bull    := (_nt+_nb)/2.0
        at_fvg_ce_bull := math.abs(close-fvg_ce_bull) <= atr_val*0.2
if array.size(be_fvg_boxes) > 0
    float _nt = na
    float _nb = na
    for _fvg in be_fvg_boxes
        if not na(_fvg)
            _t = box.get_top(_fvg)
            _b = box.get_bottom(_fvg)
            if close >= _b and close <= _t
                if na(_nb) or _b > _nb
                    _nt := _t
                    _nb := _b
    if not na(_nb)
        fvg_ce_bear    := (_nt+_nb)/2.0
        at_fvg_ce_bear := math.abs(close-fvg_ce_bear) <= atr_val*0.2

// IFVG (Inverse FVG — price violates the FVG)
bool ifvg_bull = bull_fvg[1] and close > high[1]
bool ifvg_bear = bear_fvg[1] and close < low[1]

// Order Blocks
ob_bull_trigger = close > open and close > close[1] and close[1] < open[1] and volume > vol_sma * 1.2
ob_bear_trigger = close < open and close < close[1] and close[1] > open[1] and volume > vol_sma * 1.2
if ob_bull_trigger
    _b = box.new(bar_index, low[1], bar_index + f_get_box_extension(), high[1], bgcolor=bu_ob_color, border_color=bu_ob_border_color, text="OB+", text_color=bu_ob_text_color, text_size=text_size)
    array.push(bu_ob_boxes, _b)
    array.push(bu_ob_ages,  bar_index)
    bu_ob_index := bar_index
if ob_bear_trigger
    _b = box.new(bar_index, low[1], bar_index + f_get_box_extension(), high[1], bgcolor=be_ob_color, border_color=be_ob_border_color, text="OB-", text_color=be_ob_text_color, text_size=text_size)
    array.push(be_ob_boxes, _b)
    array.push(be_ob_ages,  bar_index)
    be_ob_index := bar_index
// Extend OB boxes
for _ob in bu_ob_boxes
    if not na(_ob)
        box.set_right(_ob, bar_index + f_get_box_extension())
for _ob in be_ob_boxes
    if not na(_ob)
        box.set_right(_ob, bar_index + f_get_box_extension())

// OB zone membership
in_bu_ob = false
in_be_ob = false
for _ob in bu_ob_boxes
    if not na(_ob) and close >= box.get_bottom(_ob) and close <= box.get_top(_ob)
        in_bu_ob := true
for _ob in be_ob_boxes
    if not na(_ob) and close >= box.get_bottom(_ob) and close <= box.get_top(_ob)
        in_be_ob := true

// OB Mean Threshold (midpoint sniper)
float ob_mt_bull = na
float ob_mt_bear = na
bool at_ob_mt_bull = false
bool at_ob_mt_bear = false
if array.size(bu_ob_boxes) > 0
    float _nt = na
    float _nb = na
    for _ob in bu_ob_boxes
        if not na(_ob)
            _t = box.get_top(_ob)
            _b = box.get_bottom(_ob)
            if close >= _b and close <= _t
                if na(_nt) or _t < _nt
                    _nt := _t
                    _nb := _b
    if not na(_nt)
        ob_mt_bull    := (_nt+_nb)/2.0
        at_ob_mt_bull := math.abs(close-ob_mt_bull) <= atr_val*0.25
if array.size(be_ob_boxes) > 0
    float _nt = na
    float _nb = na
    for _ob in be_ob_boxes
        if not na(_ob)
            _t = box.get_top(_ob)
            _b = box.get_bottom(_ob)
            if close >= _b and close <= _t
                if na(_nb) or _b > _nb
                    _nt := _t
                    _nb := _b
    if not na(_nb)
        ob_mt_bear    := (_nt+_nb)/2.0
        at_ob_mt_bear := math.abs(close-ob_mt_bear) <= atr_val*0.25

// Gap fills
gap_up_today   = open > high[1]*1.001
gap_down_today = open < low[1]*0.999
gap_fill_bull  = gap_down_today and close > open  and volume > vol_sma*1.5
gap_fill_bear  = gap_up_today   and close < open  and volume > vol_sma*1.5

// Nearest OB zones (for dashboard)
float nearest_bu_zone = na
float nearest_be_zone = na
for _ob in bu_ob_boxes
    if not na(_ob)
        _t = box.get_top(_ob)
        if _t < close and (na(nearest_bu_zone) or _t > nearest_bu_zone)
            nearest_bu_zone := _t
if na(nearest_bu_zone)
    for _fvg in bu_fvg_boxes
        if not na(_fvg)
            _t = box.get_top(_fvg)
            if _t < close and (na(nearest_bu_zone) or _t > nearest_bu_zone)
                nearest_bu_zone := _t
for _ob in be_ob_boxes
    if not na(_ob)
        _b = box.get_bottom(_ob)
        if _b > close and (na(nearest_be_zone) or _b < nearest_be_zone)
            nearest_be_zone := _b
if na(nearest_be_zone)
    for _fvg in be_fvg_boxes
        if not na(_fvg)
            _b = box.get_bottom(_fvg)
            if _b > close and (na(nearest_be_zone) or _b < nearest_be_zone)
                nearest_be_zone := _b

// ════════════════════════════════════════════════════════════════════════════
// SECTION 13 — ICT CONCEPTS
// ════════════════════════════════════════════════════════════════════════════
// OTE (Optimal Trade Entry — 61.8–78.6% retracement)
float ote_bull_low  = na
float ote_bull_high = na
float ote_bear_low  = na
float ote_bear_high = na
bool in_ote_bull    = false
bool in_ote_bear    = false
var box ote_bull_box = na
var box ote_bear_box = na
if not na(h0) and not na(l0) and h0 > l0
    _sr = h0 - l0
    ote_bull_low   := h0 - _sr*0.786
    ote_bull_high  := h0 - _sr*0.618
    ote_bear_low   := l0 + _sr*0.618
    ote_bear_high  := l0 + _sr*0.786
    in_ote_bull    := close >= ote_bull_low and close <= ote_bull_high and htf_bull
    in_ote_bear    := close >= ote_bear_low and close <= ote_bear_high and htf_bear
    float _plt = close * 0.02
    if htf_bull and math.abs(close - ote_bull_high) < _plt
        if na(ote_bull_box)
            ote_bull_box := box.new(bar_index, ote_bull_high, bar_index+3, ote_bull_low, bgcolor=color.new(#00BFA5,88), border_color=color.new(#00BFA5,60), text="OTE", text_color=color.new(#00BFA5,40), text_size=size.tiny)
        else
            box.set_lefttop(ote_bull_box, bar_index, ote_bull_high)
            box.set_rightbottom(ote_bull_box, bar_index+3, ote_bull_low)
    else if not na(ote_bull_box)
        box.delete(ote_bull_box)
        ote_bull_box := na
    if htf_bear and math.abs(close - ote_bear_high) < _plt
        if na(ote_bear_box)
            ote_bear_box := box.new(bar_index, ote_bear_high, bar_index+3, ote_bear_low, bgcolor=color.new(#FF5252,88), border_color=color.new(#FF5252,60), text="OTE", text_color=color.new(#FF5252,40), text_size=size.tiny)
        else
            box.set_lefttop(ote_bear_box, bar_index, ote_bear_high)
            box.set_rightbottom(ote_bear_box, bar_index+3, ote_bear_low)
    else if not na(ote_bear_box)
        box.delete(ote_bear_box)
        ote_bear_box := na
else
    if not na(ote_bull_box)
        box.delete(ote_bull_box)
        ote_bull_box := na
    if not na(ote_bear_box)
        box.delete(ote_bear_box)
        ote_bear_box := na

// CISD (Change In State Of Delivery) — zone polarity flip
bool cisd_bull = false
bool cisd_bear = false
for _fvg in be_fvg_boxes
    if not na(_fvg)
        if close > box.get_top(_fvg) and close[1] <= box.get_top(_fvg) and htf_bull
            cisd_bull := true
for _fvg in bu_fvg_boxes
    if not na(_fvg)
        if close < box.get_bottom(_fvg) and close[1] >= box.get_bottom(_fvg) and htf_bear
            cisd_bear := true

// BPR (Balanced Price Range — OB + FVG overlap = highest-precision zone)
bool in_bpr = in_bu_ob and in_bu_fvg or in_be_ob and in_be_fvg

// ICT Unicorn 2026 (CHoCH + FVG in premium/discount zone)
float _eq_high = not na(h0) ? h0 : vwap_val + atr_val
float _eq_low  = not na(l0) ? l0 : vwap_val - atr_val
midpoint   = (_eq_high + _eq_low) / 2
in_premium = close > midpoint
in_discount= close < midpoint
bool unicorn_bull = internal_bull_choch and (in_bu_fvg or at_fvg_ce_bull) and in_discount and htf_bull and vol_spike and (in_london_session or in_ny_session)
bool unicorn_bear = internal_bear_choch and (in_be_fvg or at_fvg_ce_bear) and in_premium  and htf_bear and vol_spike and (in_london_session or in_ny_session)

// MMXM (ICT Market Maker Model — stop hunt → CHoCH → FVG retrace)
bool mmxm_bull = ssl_swept and internal_bull_choch and in_bu_fvg and htf_bull and (in_london_session or in_ny_session)
bool mmxm_bear = bsl_swept and internal_bear_choch and in_be_fvg and htf_bear and (in_london_session or in_ny_session)

// OB+FVG+CE Triple Confluence (highest precision)
bool ob_fvg_ce_bull = in_bu_ob and in_bu_fvg and at_fvg_ce_bull and htf_bull
bool ob_fvg_ce_bear = in_be_ob and in_be_fvg and at_fvg_ce_bear and htf_bear

// Breaker Blocks (S/R flip — failed OB becomes opposing structure)
if new_structure_break and market == 1
    for _bb_i = 1 to 10
        if close[_bb_i] < open[_bb_i] and (high[_bb_i]-low[_bb_i]) > atr_val*0.5
            last_bull_breaker_top := high[_bb_i]
            last_bull_breaker_bot := low[_bb_i]
            break
if new_structure_break and market == -1
    for _bb_i = 1 to 10
        if close[_bb_i] > open[_bb_i] and (high[_bb_i]-low[_bb_i]) > atr_val*0.5
            last_bear_breaker_top := high[_bb_i]
            last_bear_breaker_bot := low[_bb_i]
            break
in_bull_breaker = not na(last_bull_breaker_top) and close >= last_bull_breaker_bot and close <= last_bull_breaker_top
in_bear_breaker = not na(last_bear_breaker_top) and close >= last_bear_breaker_bot and close <= last_bear_breaker_top

// Auto Fib retracement levels
near_auto_fib_bull = false
near_auto_fib_bear = false
if not na(h0) and not na(l0)
    _fr = h0 - l0
    if _fr > 0
        _tol = atr_val * 0.3
        near_auto_fib_bull := (f_near(close, l0+_fr*0.382, _tol) or f_near(close, l0+_fr*0.500, _tol)) and close < midpoint
        near_auto_fib_bear := (f_near(close, h0-_fr*0.382, _tol) or f_near(close, h0-_fr*0.500, _tol)) and close > midpoint

// ════════════════════════════════════════════════════════════════════════════
// SECTION 14 — CANDLE PATTERNS & DIVERGENCES
// ════════════════════════════════════════════════════════════════════════════
// Momentum candles
gold_bull_momentum_candle = close > open and (close-open) > (high-low)*0.55 and close > (high+low)/2 + atr_val*0.1
gold_bear_momentum_candle = close < open and (open-close) > (high-low)*0.55 and close < (high+low)/2 - atr_val*0.1

// Engulfing
bullish_engulfing = close > open and close > high[1] and open < close[1] and volume > vol_sma
bearish_engulfing = close < open and close < low[1]  and open > close[1] and volume > vol_sma

// Pin bars
pin_bar_bull = (math.min(open,close) - low) > (high-low)*0.6 and close > (high+low)/2
pin_bar_bear = (high - math.max(open,close)) > (high-low)*0.6 and close < (high+low)/2

// Rejection blocks
float _rb_range = high - low
bull_rejection_block = _rb_range > atr_val*0.5 and (math.min(open,close)-low) > _rb_range*0.6 and close > (high+low)/2 and volume > vol_sma*1.2
bear_rejection_block = _rb_range > atr_val*0.5 and (high-math.max(open,close)) > _rb_range*0.6 and close < (high+low)/2 and volume > vol_sma*1.2

// Absorption
bull_absorption = close > open and close > math.max(high[1],high[2],high[3]) and open <= low[1]  and volume > vol_sma*1.3
bear_absorption = close < open and close < math.min(low[1],low[2],low[3])   and open >= high[1] and volume > vol_sma*1.3

// SFP (Stop-Run / Fake Pattern)
sfp_bullish = low  < ta.lowest(low,  zigzag_len)[1] and close > ta.lowest(low,  zigzag_len)[1] and close > open
sfp_bearish = high > ta.highest(high,zigzag_len)[1] and close < ta.highest(high,zigzag_len)[1] and close < open
plotshape(sfp_bullish and ta.change(sfp_bullish), title="SFP+", style=shape.triangleup,   location=location.belowbar, color=color.new(#00BFA5,30), size=size.tiny, text="SFP")
plotshape(sfp_bearish and ta.change(sfp_bearish), title="SFP-", style=shape.triangledown, location=location.abovebar, color=color.new(#FF5252,30), size=size.tiny, text="SFP")

// Liquidity sweeps
liq_low_sweep  = low  < ta.lowest(low[1],  5) and close > ta.lowest(low[1],  5)
liq_high_sweep = high > ta.highest(high[1], 5) and close < ta.highest(high[1], 5)
liquidity_grab_bullish = liq_low_sweep  and volume > vol_sma*1.3 and close > open
liquidity_grab_bearish = liq_high_sweep and volume > vol_sma*1.3 and close < open
liq_sweep_bull_v15 = ssl_swept or sweep_pdl or sweep_asian_low  or liquidity_grab_bullish
liq_sweep_bear_v15 = bsl_swept or sweep_pdh or sweep_asian_high or liquidity_grab_bearish

// Sweep quality grading (1-3)
int sweep_quality_bull = ssl_swept ? ((math.abs(low-ssl_level[1])/(atr_val>0?atr_val:1)) > 0.5 ? 1 : 0) + ((math.abs(close-ssl_level[1])/(atr_val>0?atr_val:1)) > 0.3 ? 1 : 0) + (volume > vol_sma*1.5 ? 1 : 0) : 0
int sweep_quality_bear = bsl_swept ? ((math.abs(high-bsl_level[1])/(atr_val>0?atr_val:1)) > 0.5 ? 1 : 0) + ((math.abs(close-bsl_level[1])/(atr_val>0?atr_val:1)) > 0.3 ? 1 : 0) + (volume > vol_sma*1.5 ? 1 : 0) : 0
bool sweep_quality_ok_bull = sweep_quality_bull >= 2
bool sweep_quality_ok_bear = sweep_quality_bear >= 2

// Sweep confirmed
sweep_confirmed_bull = sfp_bullish and (in_bu_ob or in_bu_fvg or near_support) and volume > vol_sma*1.5
sweep_confirmed_bear = sfp_bearish and (in_be_ob or in_be_fvg or near_resistance) and volume > vol_sma*1.5

// Exhaustion
blow_off_top        = close < open and high > high[1] + atr_val*0.5 and volume > vol_sma*2.0 and rsi_val > 72
capitulation_bottom = close > open and low  < low[1]  - atr_val*0.5 and volume > vol_sma*2.0 and rsi_val < 28
reversal_buy_exhaustion  = capitulation_bottom and (in_bu_ob or in_bu_fvg) and htf_bull
reversal_sell_exhaustion = blow_off_top        and (in_be_ob or in_be_fvg) and htf_bear

// RSI divergence
rsi_prev_low  = ta.lowest(rsi_val,  14)
rsi_prev_high = ta.highest(rsi_val, 14)
rsi_bullish_div = low  < ta.lowest(low[1],  10) and rsi_val > rsi_prev_low[1]  and rsi_val < 40
rsi_bearish_div = high > ta.highest(high[1],10) and rsi_val < rsi_prev_high[1] and rsi_val > 60
bullish_divergence = rsi_bullish_div or obv_bull_div
bearish_divergence = rsi_bearish_div or obv_bear_div

// Order flow
bullish_order_flow = obv_rising  and vol_spike and close > ema_fast
bearish_order_flow = obv_falling and vol_spike and close < ema_fast

// Breakout + squeeze
highest_20 = ta.highest(high, 20)
lowest_20  = ta.lowest(low,   20)
in_squeeze     = (highest_20 - lowest_20) < ta.sma(atr_val, 20) * 3.0
breakout_up    = in_squeeze[1] and close > highest_20[1] and close > open and volume > vol_sma*1.3
breakout_down  = in_squeeze[1] and close < lowest_20[1]  and close < open and volume > vol_sma*1.3

// Volume imbalance
bull_volume_imbalance = open > close[1] and close > open
bear_volume_imbalance = open < close[1] and close < open
strong_bull_vi = bull_volume_imbalance and (open - close[1]) > atr_val*0.3
strong_bear_vi = bear_volume_imbalance and (close[1] - open)  > atr_val*0.3

// Institutional flow
institutional_accumulation = vol_surge and (high-low) < atr_val*0.6 and close > open and htf_bull and not extreme_volatility
institutional_distribution = vol_surge and (high-low) < atr_val*0.6 and close < open and htf_bear and not extreme_volatility

// Premium / Discount
fib_range    = not na(h0) and not na(l0) ? math.abs(h0-l0) : atr_val*5
near_fib_bull= f_near(close, not na(l0)?l0+fib_range*0.50:na, zone_dist) or f_near(close, not na(l0)?l0+fib_range*0.618:na, zone_dist)
near_fib_bear= f_near(close, not na(h0)?h0-fib_range*0.50:na, zone_dist) or f_near(close, not na(h0)?h0-fib_range*0.618:na, zone_dist)

// ERL / IRL
float range_high = not na(h0) ? h0 : ta.highest(high, 20)
float range_low  = not na(l0) ? l0 : ta.lowest(low,  20)
float range_mid  = (range_high + range_low) / 2.0
bool erl_above   = not na(pdh) and pdh > range_high
bool erl_below   = not na(pdl) and pdl < range_low
bool targeting_erl_bull = ssl_swept and erl_above
bool targeting_erl_bear = bsl_swept and erl_below

// Patterns
bool double_bottom = is_eql and sfp_bullish and htf_bull
bool double_top    = is_eqh and sfp_bearish and htf_bear
bool triple_bottom = double_bottom and not na(l1) and math.abs(l1-l0) < atr_val*0.2
bool triple_top    = double_top    and not na(h1) and math.abs(h1-h0) < atr_val*0.2
bool hs_pattern_bear  = not na(h0) and not na(h1) and not na(l0) and not na(l1) and h0 < h1 and l0 > l1 and close < l0 and htf_bear
bool ihs_pattern_bull = not na(l0) and not na(l1) and not na(h0) and not na(h1) and l0 > l1 and h0 < h1 and close > h0 and htf_bull
bool trend_continuation_bull = market == 1  and new_structure_break and htf_bull and close > ema_fast
bool trend_continuation_bear = market == -1 and new_structure_break and htf_bear and close < ema_fast
bool trend_reversal_bull = internal_bull_choch and htf_bull and (in_bu_ob or in_bu_fvg)
bool trend_reversal_bear = internal_bear_choch and htf_bear and (in_be_ob or in_be_fvg)
bool falling_wedge_bull  = ema_squeeze and close > ema_fast and close > close[3] and htf_bull and breakout_up
bool rising_wedge_bear   = ema_squeeze and close < ema_fast and close < close[3] and htf_bear and breakout_down

// Turtle soup
bool turtle_soup_bull = (sfp_bullish or liquidity_grab_bullish) and (near_support  or in_bu_ob or in_bu_fvg or near_round_number) and htf_bull
bool turtle_soup_bear = (sfp_bearish or liquidity_grab_bearish) and (near_resistance or in_be_ob or in_be_fvg or near_round_number) and htf_bear

// VWAP mean reversion
bool vwap_mean_rev_bull = is_oversold_vwap  and (in_bu_ob or in_bu_fvg or sfp_bullish)
bool vwap_mean_rev_bear = is_overbought_vwap and (in_be_ob or in_be_fvg or sfp_bearish)

// VWAP reclaim (held for 2+ bars = institutional intent)
_vwap_above_count := close > vwap_val ? _vwap_above_count + 1 : 0
_vwap_below_count := close < vwap_val ? _vwap_below_count + 1 : 0
bool vwap_reclaim_bull = _vwap_above_count == 2 and close[2] < vwap_val and htf_bull
bool vwap_reclaim_bear = _vwap_below_count == 2 and close[2] > vwap_val and htf_bear

// STOCH
stoch_k          = ta.stoch(close, high, low, 14)
stoch_d          = ta.sma(stoch_k, 3)
stoch_oversold   = stoch_k < 20
stoch_overbought = stoch_k > 80
stoch_bull_cross = ta.crossover(stoch_k, stoch_d)  and stoch_k < 40
stoch_bear_cross = ta.crossunder(stoch_k, stoch_d) and stoch_k > 60

// MACD events
_macd_bull_event = ta.crossover(macd_line, macd_signal) or (macd_line > macd_signal and macd_hist > macd_hist[1] and macd_hist > 0)
_macd_bear_event = ta.crossunder(macd_line, macd_signal) or (macd_line < macd_signal and macd_hist < macd_hist[1] and macd_hist < 0)
macd_bull_alignment = macd_line > macd_signal
macd_bear_alignment = macd_line < macd_signal

// V32-FIX-09: LOF timing precision
// Real LOF requires: fake sweep in first 3 candles of London open (07:00-07:15 UTC on 5m)
// + sweep magnitude ≥ 0.25 ATR beyond Asian H/L
// + CHoCH must complete within 3 bars of the sweep
// + HTF alignment required
bool _london_micro_strict = hour_utc == 7 and _minute_utc <= 15  // first 3×5m candles only
float _lof_bull_sweep_mag = not na(asian_low)  ? (asian_low  - low)  / (atr_val > 0 ? atr_val : 1.0) : 0.0
float _lof_bear_sweep_mag = not na(asian_high) ? (high - asian_high) / (atr_val > 0 ? atr_val : 1.0) : 0.0
bool _lof_bull_mag_ok = _lof_bull_sweep_mag >= 0.25   // sweep at least 0.25 ATR below Asian low
bool _lof_bear_mag_ok = _lof_bear_sweep_mag >= 0.25   // sweep at least 0.25 ATR above Asian high
// CHoCH recency gate — internal CHoCH must have occurred within 3 bars
bool _choch_bull_recent = internal_bull_choch or internal_bull_choch[1] or internal_bull_choch[2]
bool _choch_bear_recent = internal_bear_choch or internal_bear_choch[1] or internal_bear_choch[2]
bool _lof_bull_val = _london_micro_strict and sweep_asian_low  and _choch_bull_recent and _lof_bull_mag_ok and htf_bull
bool _lof_bear_val = _london_micro_strict and sweep_asian_high and _choch_bear_recent and _lof_bear_mag_ok and htf_bear
london_open_fake_bull = _lof_bull_val
london_open_fake_bear = _lof_bear_val

// Fake Breakout Trap Detector (V30-FIX-16)
bool _is_fake_bull_bo = high > ta.highest(high[1],5) and close < ta.highest(high[1],5) and (high-close) > (high-low)*0.60
bool _is_fake_bear_bo = low  < ta.lowest(low[1],   5) and close > ta.lowest(low[1],   5) and (close-low) > (high-low)*0.60

// ════════════════════════════════════════════════════════════════════════════
// SECTION 15 — GLOBAL PRE-FLAGS & BIAS
// ════════════════════════════════════════════════════════════════════════════
// Bias counts (no SFP here to prevent triple-counting)
int _bull_bias_count = (market==1 and close>ema_fast and gold_institutional_flow ?1:0) +
     (htf_bull and close>ema_slow ?1:0) + (in_bu_ob and close>open ?1:0) +
     (liquidity_grab_bullish and close>ema_fast ?1:0) + (near_round_number and htf_bull ?1:0) +
     (near_support and htf_bull ?1:0) + (in_bu_fvg and close>open ?1:0)
int _bear_bias_count = (market==-1 and close<ema_fast and gold_institutional_sell ?1:0) +
     (htf_bear and close<ema_slow ?1:0) + (in_be_ob and close<open ?1:0) +
     (liquidity_grab_bearish and close<ema_fast ?1:0) + (near_round_number and htf_bear ?1:0) +
     (near_resistance and htf_bear ?1:0) + (in_be_fvg and close<open ?1:0)
bool bull_bias = _bull_bias_count >= 2
bool bear_bias = _bear_bias_count >= 2

// Structural trend
strong_bullish_trend = close > ema_fast and ema_fast > ema_slow and close > vwap_val and htf_bull
strong_bearish_trend = close < ema_fast and ema_fast < ema_slow and close < vwap_val and htf_bear
bullish_candle       = gold_bull_momentum_candle
bearish_candle       = gold_bear_momentum_candle

// Pre-calculated flags (prevent CE10116 element limit inside scoring functions)
_range_filter_val        = atr_val > atr_sma_20 * 0.8
_ts_bull_val             = is_eql and sfp_bullish and (in_bu_fvg or in_bu_ob) and htf_bull
_ts_bear_val             = is_eqh and sfp_bearish and (in_be_fvg or in_be_ob) and htf_bear

// Elite confluence count (for +20% multiplier)
g_elite_conf_buy  = (unicorn_bull?1:0) + (mmxm_bull?1:0) + (ob_fvg_ce_bull?1:0) + (in_ote_bull?1:0) + (in_bpr?1:0) + (cisd_bull?1:0) + (_lof_bull_val?1:0)
g_elite_conf_sell = (unicorn_bear?1:0) + (mmxm_bear?1:0) + (ob_fvg_ce_bear?1:0) + (in_ote_bear?1:0) + (in_bpr?1:0) + (cisd_bear?1:0) + (_lof_bear_val?1:0)

// Breakout + rejection zone analysis
be_top = array.size(be_ob_boxes) > 0 ? box.get_top(array.get(be_ob_boxes,    array.size(be_ob_boxes)-1))    : na
be_bot = array.size(be_ob_boxes) > 0 ? box.get_bottom(array.get(be_ob_boxes, array.size(be_ob_boxes)-1))    : na
bu_top = array.size(bu_ob_boxes) > 0 ? box.get_top(array.get(bu_ob_boxes,    array.size(bu_ob_boxes)-1))    : na
bu_bot = array.size(bu_ob_boxes) > 0 ? box.get_bottom(array.get(bu_ob_boxes, array.size(bu_ob_boxes)-1))    : na
break_above_supply = not na(be_top) and close > be_top and close[1] <= be_top
follow_through_up  = break_above_supply and close > open and close > high[1]
break_below_demand = not na(bu_bot) and close < bu_bot and close[1] >= bu_bot
follow_through_dn  = break_below_demand and close < open and close < low[1]
rejection_supply   = not na(be_bot) and high >= be_bot and close < be_bot
rejection_demand   = not na(bu_top) and low  <= bu_top and close > bu_top
strong_body_up     = close > open and (close-open) > (high-low)*0.5
strong_body_dn     = close < open and (open-close) > (high-low)*0.5

// ════════════════════════════════════════════════════════════════════════════
// V32-FIX-11: WYCKOFF PHASE DETECTION
// Accumulation: tight range + bullish volume delta + OBV rising + discount
// Distribution: tight range + bearish volume delta + OBV falling + premium
// ════════════════════════════════════════════════════════════════════════════
float _wyc_range_pct  = ta.sma(atr_val, 10) > 0 ? atr_val / ta.sma(atr_val, 10) : 1.0
bool  _wyc_tight      = _wyc_range_pct < 0.85  // below-average range = consolidation
bool  _wyc_spring     = low < ta.lowest(low[1], 5) and close > ta.lowest(low[1], 5) and volume > vol_sma * 1.3
bool  _wyc_upthrust   = high > ta.highest(high[1], 5) and close < ta.highest(high[1], 5) and volume > vol_sma * 1.3
// ── ARCH-01: Volume Delta Engine — relocated here from Section 17 ────────────
// Placed BEFORE Wyckoff (which needs delta_bull/bear_trending) and BEFORE
// Section 16 scoring (which needs wyckoff_accum_conf). Achieves zero-lag.
float _hl_range      = high - low
float _vd_bull_raw   = _hl_range > 0 ? (close - low)  / _hl_range : 0.5
float _vd_bear_raw   = _hl_range > 0 ? (high - close) / _hl_range : 0.5
float vol_delta      = (_vd_bull_raw - _vd_bear_raw) * volume
var float cum_vol_delta = 0.0
cum_vol_delta        := cum_vol_delta + vol_delta
var float cum_delta_sma = 0.0
float _ema_alpha     = 2.0 / 11.0
cum_delta_sma        := na(cum_delta_sma[1]) ? cum_vol_delta : cum_delta_sma[1] + _ema_alpha * (cum_vol_delta - cum_delta_sma[1])
delta_bull_trending  := cum_vol_delta > cum_delta_sma and _vd_bull_raw > 0.55
delta_bear_trending  := cum_vol_delta < cum_delta_sma and _vd_bear_raw > 0.55
float _vdelta_ma     = ta.ema(vol_delta, 8)  // VD MA for divergence detection in Section 17
// ─────────────────────────────────────────────────────────────────────────────

// ARCH-01 RESOLVED (BUG-12): Wyckoff now uses current-bar delta (zero lag)
bool wyckoff_accum = _wyc_tight and obv_rising  and delta_bull_trending and in_discount and not extreme_volatility and _wyc_spring
bool wyckoff_dist  = _wyc_tight and obv_falling and delta_bear_trending and in_premium  and not extreme_volatility and _wyc_upthrust
// Wyckoff confirmed with HTF alignment
bool wyckoff_accum_conf = wyckoff_accum and htf_bull and (in_bu_ob or in_bu_fvg or in_ote_bull)
bool wyckoff_dist_conf  = wyckoff_dist  and htf_bear and (in_be_ob or in_be_fvg or in_ote_bear)

// ════════════════════════════════════════════════════════════════════════════
// V32-FIX-12: LIQUIDITY POOL MAPPING
// Equal highs (3 within 0.15 ATR) and equal lows form institutional targets
// Graduated scoring: closer = higher score (0-3)
// ════════════════════════════════════════════════════════════════════════════
// Build EQH/EQL pool from pivot history
if not na(ph) and not na(ph[1])
    if math.abs(ph - ph[1]) <= atr_val * 0.15
        if not na(ph) and (array.size(_eq_high_pool) == 0 or math.abs(ph - array.get(_eq_high_pool, array.size(_eq_high_pool)-1)) > atr_val * 0.3)
            array.push(_eq_high_pool, ph)
        if array.size(_eq_high_pool) > 10
            array.shift(_eq_high_pool)
if not na(pl) and not na(pl[1])
    if math.abs(pl - pl[1]) <= atr_val * 0.15
        if not na(pl) and (array.size(_eq_low_pool) == 0 or math.abs(pl - array.get(_eq_low_pool, array.size(_eq_low_pool)-1)) > atr_val * 0.3)
            array.push(_eq_low_pool, pl)
        if array.size(_eq_low_pool) > 10
            array.shift(_eq_low_pool)

// Find nearest pool levels
_nearest_eq_high := na
_nearest_eq_low  := na
if array.size(_eq_high_pool) > 0
    for _ehi = 0 to array.size(_eq_high_pool) - 1
        _eh = array.get(_eq_high_pool, _ehi)
        if _eh > close and (na(_nearest_eq_high) or _eh < _nearest_eq_high)
            _nearest_eq_high := _eh
if array.size(_eq_low_pool) > 0
    for _eli = 0 to array.size(_eq_low_pool) - 1
        _el = array.get(_eq_low_pool, _eli)
        if _el < close and (na(_nearest_eq_low) or _el > _nearest_eq_low)
            _nearest_eq_low := _el

// Graduated proximity score (0-3 based on ATR distance)
float _dist_eqh = not na(_nearest_eq_high) ? math.abs(close - _nearest_eq_high) / (atr_val > 0 ? atr_val : 1) : 999.0
float _dist_eql = not na(_nearest_eq_low)  ? math.abs(close - _nearest_eq_low)  / (atr_val > 0 ? atr_val : 1) : 999.0
_liq_pool_score_buy  := _dist_eql < 0.3 ? 3 : _dist_eql < 0.7 ? 2 : _dist_eql < 1.2 ? 1 : 0
_liq_pool_score_sell := _dist_eqh < 0.3 ? 3 : _dist_eqh < 0.7 ? 2 : _dist_eqh < 1.2 ? 1 : 0
bool near_liq_pool_buy  = _liq_pool_score_buy  >= 2 and htf_bull
bool near_liq_pool_sell = _liq_pool_score_sell >= 2 and htf_bear

// V32-FIX-06: Multi-timeframe FVG validation
// Confirm current-TF FVG aligns with 1h FVG for higher conviction
// V32-FIX-06 BUG-01 FIXED: was low[0]/high[0] with lookahead_on → lookahead bias. Now uses confirmed prior bar [1].
float htf_fvg_bull_check = request.security(syminfo.tickerid, "60", low[1] > high[3] ? 1.0 : 0.0, lookahead=barmerge.lookahead_on)
float htf_fvg_bear_check = request.security(syminfo.tickerid, "60", high[1] < low[3] ? 1.0 : 0.0, lookahead=barmerge.lookahead_on)
bool htf_fvg_aligned_bull = bull_fvg and htf_fvg_bull_check > 0.5
bool htf_fvg_aligned_bear = bear_fvg and htf_fvg_bear_check > 0.5

// ════════════════════════════════════════════════════════════════════════════
// SECTION 16 — SCORING ENGINE (5 MODULAR SUB-FUNCTIONS)
// Prevents CE10116 254-element limit per function
// ════════════════════════════════════════════════════════════════════════════

// Sub-module 1: Core Structural Bias
f_score_core(int b, int s) =>
    int rb = b
    int rs = s
    if bull_bias
        rb += 3
    if bear_bias
        rs += 3
    if htf_bull and bull_bias
        rb += 2
    if htf_bear and bear_bias
        rs += 2
    if in_discount and bull_bias
        rb += 1
    if in_premium and bear_bias
        rs += 1
    if gold_dxy_confluence_bull
        rb += 1
    if gold_dxy_confluence_bear
        rs += 1
    if in_bu_ob or in_bu_fvg
        rb += 2
    if in_be_ob or in_be_fvg
        rs += 2
    if near_support
        rb += 1
    if near_resistance
        rs += 1
    if near_fib_bull
        rb += 1
    if near_fib_bear
        rs += 1
    [rb, rs]

// Sub-module 2: Structural Indicators & Momentum
f_score_struct(int b, int s) =>
    int rb = b
    int rs = s
    if sweep_confirmed_bull and bull_bias
        rb += 3
    else if ssl_swept and bull_bias
        rb += 2
    else if liq_low_sweep and bull_bias
        rb += 1
    if sweep_confirmed_bear and bear_bias
        rs += 3
    else if bsl_swept and bear_bias
        rs += 2
    else if liq_high_sweep and bear_bias
        rs += 1
    if rsi_val >= validated_rsi_buy_min and rsi_val < 70
        rb += 1
    if rsi_val <= validated_rsi_sell_max and rsi_val > 30
        rs += 1
    if use_volume_filter ? vol_ok : true
        if bull_bias
            rb += 1
        if bear_bias
            rs += 1
    if _range_filter_val
        if bull_bias
            rb += 1
        if bear_bias
            rs += 1
    if adx_trending and bull_bias
        rb += 1
    if adx_trending and bear_bias
        rs += 1
    if _macd_bull_event and bull_bias
        rb += 1
    if _macd_bear_event and bear_bias
        rs += 1
    if (stoch_bull_cross or stoch_oversold) and bull_bias
        rb += 1
    if (stoch_bear_cross or stoch_overbought) and bear_bias
        rs += 1
    // ARCH-10: vol_spike made exclusive — only scores the leading bias direction
    if vol_spike and bull_bias and not bear_bias
        rb += 1
    else if vol_spike and bear_bias
        rs += 1
    if near_round_number
        if bull_bias
            rb += 1
        if bear_bias
            rs += 1
    if near_century
        if bull_bias
            rb += 1
        if bear_bias
            rs += 1
    [rb, rs]

// Sub-module 3: ICT & Session
f_score_ict(int b, int s) =>
    int rb = b
    int rs = s
    if bull_bias
        rb += prime_session_bonus
    if bear_bias
        rs += prime_session_bonus
    if is_silver_bullet and bull_bias
        rb += 5
    else if in_kill_zone and bull_bias
        rb += 3
    if is_silver_bullet and bear_bias
        rs += 5
    else if in_kill_zone and bear_bias
        rs += 3
    if sfp_bullish and bull_bias
        rb += 1
    if sfp_bearish and bear_bias
        rs += 1
    if sfp_bullish and (in_bu_ob or in_bu_fvg) and rsi_val < 40
        rb += 1
    if sfp_bearish and (in_be_ob or in_be_fvg) and rsi_val > 60
        rs += 1
    if reversal_buy_exhaustion and bull_bias
        rb += 5
    if reversal_sell_exhaustion and bear_bias
        rs += 5
    if kc_bull_exhaustion and bull_bias
        rb += 2
    if kc_bear_exhaustion and bear_bias
        rs += 2
    if rsi_bullish_div and bull_bias
        rb += 1
    if rsi_bearish_div and bear_bias
        rs += 1
    if obv_bull_div and bull_bias
        rb += 1
    if obv_bear_div and bear_bias
        rs += 1
    if breakout_up and bull_bias
        rb += 1
    if breakout_down and bear_bias
        rs += 1
    if institutional_accumulation and bull_bias
        rb += 1
    if institutional_distribution and bear_bias
        rs += 1
    if gold_bull_momentum_candle and bull_bias
        rb += 1
    if gold_bear_momentum_candle and bear_bias
        rs += 1
    // V30-FIX-08: near_poc is directional-gated (prevents both sides scoring)
    if near_poc and bull_bias and not bear_bias
        rb += 2
    if near_poc and bear_bias and not bull_bias
        rs += 2
    if inside_value_area and in_discount
        rb += 1
    if inside_value_area and in_premium
        rs += 1
    if in_discount_va and bull_bias
        rb += 1
    if in_premium_va and bear_bias
        rs += 1
    if aoe_breakout_bull and bull_bias
        rb += 2
    if aoe_breakout_bear and bear_bias
        rs += 2
    bool _inside_aoe = use_aoe and not na(aoe_high) and not na(aoe_low) and close <= aoe_high and close >= aoe_low
    if _inside_aoe and close > (aoe_high+aoe_low)/2 and bull_bias
        rb += 1
    if _inside_aoe and close < (aoe_high+aoe_low)/2 and bear_bias
        rs += 1
    if internal_bull_choch and bull_bias
        rb += 3
    else if internal_bull_bos and bull_bias
        rb += 1
    if internal_bear_choch and bear_bias
        rs += 3
    else if internal_bear_bos and bear_bias
        rs += 1
    if use_adaptive_atr and not na(km_trailing_stop)
        if km_supertrend_os == 1 and bull_bias
            rb += 1
        if km_supertrend_os == 0 and bear_bias
            rs += 1
    if near_auto_fib_bull and bull_bias
        rb += 1
    if near_auto_fib_bear and bear_bias
        rs += 1
    if new_structure_break and bull_bias and market == 1
        rb += 2
    if new_structure_break and bear_bias and market == -1
        rs += 2
    [rb, rs]

// Sub-module 4: Institutional SMC & Macro
f_score_inst(int b, int s) =>
    int rb = b
    int rs = s
    if weekly_bias_bull and bull_bias
        rb += 1
    if weekly_bias_bear and bear_bias
        rs += 1
    if macro_bull_aligned and bull_bias
        rb += 1
    if macro_bear_aligned and bear_bias
        rs += 1
    if above_midnight_open and bull_bias
        rb += 1
    if below_midnight_open and bear_bias
        rs += 1
    if judas_bull_active and bull_bias
        rb += 2
    if judas_bear_active and bear_bias
        rs += 2
    if in_ote_bull and bull_bias
        rb += 2
    if in_ote_bear and bear_bias
        rs += 2
    if is_half_round and bull_bias and close <= _half_round_level_val
        rb += 1
    if is_half_round and bear_bias and close >= _half_round_level_val
        rs += 1
    if is_high_precision_window and bull_bias
        rb += 1
    if is_high_precision_window and bear_bias
        rs += 1
    if _ts_bull_val
        rb += 3
    if _ts_bear_val
        rs += 3
    if vwap_mean_rev_bull and bull_bias
        rb += 1
    if vwap_mean_rev_bear and bear_bias
        rs += 1
    if sweep_pdl and bull_bias
        rb += 2
    if sweep_pdh and bear_bias
        rs += 2
    if sweep_asian_low and is_manipulation and bull_bias
        rb += 1
    if sweep_asian_high and is_manipulation and bear_bias
        rs += 1
    if _lof_bull_val and bull_bias
        rb += 3
    if _lof_bear_val and bear_bias
        rs += 3
    if soro_bull and bull_bias
        rb += 2
    if soro_bear and bear_bias
        rs += 2
    if london_first_candle_bull and bull_bias and in_london_session
        rb += 1
    if london_first_candle_bear and bear_bias and in_london_session
        rs += 1
    if amd_cycle_bull and bull_bias
        rb += 3
    if amd_cycle_bear and bear_bias
        rs += 3
    if smt_divergence_bull and bull_bias
        rb += 2
    if smt_divergence_bear and bear_bias
        rs += 2
    if strong_daily_bull and bull_bias
        rb += 2
    if strong_daily_bear and bear_bias
        rs += 2
    [rb, rs]

// Sub-module 5: Premium & Elite Patterns
f_score_elite(int b, int s) =>
    int rb = b
    int rs = s
    if triple_bottom and bull_bias
        rb += 3
    else if double_bottom and bull_bias
        rb += 2
    if triple_top and bear_bias
        rs += 3
    else if double_top and bear_bias
        rs += 2
    if ihs_pattern_bull and bull_bias
        rb += 2
    if hs_pattern_bear and bear_bias
        rs += 2
    if trend_continuation_bull and bull_bias
        rb += 1
    if trend_continuation_bear and bear_bias
        rs += 1
    if trend_reversal_bull and bull_bias
        rb += 2
    if trend_reversal_bear and bear_bias
        rs += 2
    if gap_fill_bull and bull_bias
        rb += 1
    if gap_fill_bear and bear_bias
        rs += 1
    if bull_absorption and bull_bias
        rb += 2
    if bear_absorption and bear_bias
        rs += 2
    if is_strong_support and bull_bias and near_support
        rb += 1
    if is_strong_resistance and bear_bias and near_resistance
        rs += 1
    if ema_squeeze_release_bull and bull_bias
        rb += 1
    if ema_squeeze_release_bear and bear_bias
        rs += 1
    if at_fvg_ce_bull and bull_bias
        rb += 3
    if at_fvg_ce_bear and bear_bias
        rs += 3
    if at_ob_mt_bull and bull_bias
        rb += 2
    if at_ob_mt_bear and bear_bias
        rs += 2
    if ifvg_bull and bull_bias
        rb += 2
    if ifvg_bear and bear_bias
        rs += 2
    if targeting_erl_bull and bull_bias
        rb += 2
    if targeting_erl_bear and bear_bias
        rs += 2
    if strong_bull_vi and bull_bias
        rb += 2
    if strong_bear_vi and bear_bias
        rs += 2
    if bull_rejection_block and bull_bias
        rb += 2
    if bear_rejection_block and bear_bias
        rs += 2
    if sweep_pwl and bull_bias
        rb += 2
    if sweep_pwh and bear_bias
        rs += 2
    if near_pwl and bull_bias
        rb += 1
    if near_pwh and bear_bias
        rs += 1
    if nwog_bull and bull_bias
        rb += 1
    if nwog_bear and bear_bias
        rs += 1
    if near_nwog_fill and bull_bias and close < nwog_fill_level
        rb += 1
    if near_nwog_fill and bear_bias and close > nwog_fill_level
        rs += 1
    if near_ndog_fill and bull_bias and close < ndog_fill_level
        rb += 1
    if near_ndog_fill and bear_bias and close > ndog_fill_level
        rs += 1
    if bull_disp_aligned and (in_bu_ob or in_bu_fvg or in_ote_bull or sfp_bullish or sweep_confirmed_bull or po3_manip_bull or ssl_swept)
        rb += 3
    else if bull_disp_aligned and bull_bias
        rb += 1
    if bear_disp_aligned and (in_be_ob or in_be_fvg or in_ote_bear or sfp_bearish or sweep_confirmed_bear or po3_manip_bear or bsl_swept)
        rs += 3
    else if bear_disp_aligned and bear_bias
        rs += 1
    if in_bull_breaker and bull_bias
        rb += 2
    if in_bear_breaker and bear_bias
        rs += 2
    // BUG-03 FIXED: BPR was scoring both sides simultaneously. Now zone-directional.
    if in_bpr and in_bu_ob and in_bu_fvg and bull_bias
        rb += 2
    if in_bpr and in_be_ob and in_be_fvg and bear_bias
        rs += 2
    if unicorn_bull and bull_bias
        rb += 4
    if unicorn_bear and bear_bias
        rs += 4
    if mmxm_bull and bull_bias
        rb += 3
    if mmxm_bear and bear_bias
        rs += 3
    if ob_fvg_ce_bull and bull_bias
        rb += 3
    if ob_fvg_ce_bear and bear_bias
        rs += 3
    if po3_manip_bull and bull_bias
        rb += 2
    if po3_manip_bear and bear_bias
        rs += 2
    if po3_dist_bull and bull_bias
        rb += 1
    if po3_dist_bear and bear_bias
        rs += 1
    if cisd_bull and bull_bias
        rb += 2
    if cisd_bear and bear_bias
        rs += 2
    if near_qtr_low and bull_bias
        rb += 1
    if near_qtr_high and bear_bias
        rs += 1
    if seasonal_bull_bias and bull_bias
        rb += 1
    if seasonal_bear_bias and bear_bias
        rs += 1
    // V32-FIX-11: Wyckoff phase detection bonus (ATR-normalized)
    if wyckoff_accum_conf and bull_bias
        rb += int(math.round(3.0 * _atr_norm_factor))
    if wyckoff_dist_conf and bear_bias
        rs += int(math.round(3.0 * _atr_norm_factor))
    // V32-FIX-12: Liquidity pool proximity (graduated 0-3)
    if near_liq_pool_buy and bull_bias
        rb += _liq_pool_score_buy
    if near_liq_pool_sell and bear_bias
        rs += _liq_pool_score_sell
    // V32-FIX-06: MTF FVG alignment bonus (1h confirms current-TF FVG)
    if htf_fvg_aligned_bull and bull_bias
        rb += 2
    if htf_fvg_aligned_bear and bear_bias
        rs += 2
    // V32-FIX-07: Anchored VWAP alignment bonus
    if anchored_vwap_bull and bull_bias and not anchored_vwap_bear
        rb += 1
    if anchored_vwap_bear and bear_bias and not anchored_vwap_bull
        rs += 1
    [rb, rs]

// Sequential scoring pipeline
[b1, s1] = f_score_core(0, 0)
[b2, s2] = f_score_struct(b1, s1)
[b3, s3] = f_score_ict(b2, s2)
[b4, s4] = f_score_inst(b3, s3)
[b5, s5] = f_score_elite(b4, s4)
int buy_score  = b5
int sell_score = s5

// V30-FIX-13: Institutional Confluence Multiplier (+20% for 3+ elite confluences)
if g_elite_conf_buy  >= 3 and bull_bias
    buy_score  += int(math.round(buy_score  * 0.20))
if g_elite_conf_sell >= 3 and bear_bias
    sell_score += int(math.round(sell_score * 0.20))
// ARCH-06: Raw score ceiling guard — prevents runaway inflation from compound bonuses
// Scores above 99 are meaningless and waste precision in tier comparisons
buy_score  := math.min(buy_score,  99)
sell_score := math.min(sell_score, 99)

// ════════════════════════════════════════════════════════════════════════════
// SECTION 17 — SCORE POST-BONUSES
// ARCH-01: Volume Delta core computation was moved to Section 15 (before
// Wyckoff) for zero-lag — delta_bull/bear_trending are current-bar here.
// ════════════════════════════════════════════════════════════════════════════

// Volume Delta Divergence (vol_delta/_vdelta_ma computed in Section 15)
bool vd_bull_div  = low  < low[3]  and vol_delta > vol_delta[3] and vol_delta > _vdelta_ma
bool vd_bear_div  = high > high[3] and vol_delta < vol_delta[3] and vol_delta < _vdelta_ma

// HTF MSS bonus (+2 within last 10 bars)
int _bars_bos_bull = nz(ta.barssince(htf_bos_bull), 999)
int _bars_bos_bear = nz(ta.barssince(htf_bos_bear), 999)

// Gold-specific scoring hacks (V26-XAUUSD)
bool gold_inst_flow_bull = gold_dxy_confluence_bull and gold_institutional_flow and htf_bull and macro_bull_aligned
bool gold_inst_flow_bear = gold_dxy_confluence_bear and gold_institutional_sell and htf_bear and macro_bear_aligned

bool gold_kz_round = in_kill_zone and (near_round_number or near_century) and in_prime_session

bool gold_risk_off_buy  = extreme_volatility and gold_dxy_confluence_bull and breakout_up  and htf_bull
bool gold_risk_off_sell = extreme_volatility and gold_dxy_confluence_bear and breakout_down and htf_bear

f_apply_post_bonuses(int b_score, int s_score, int bars_bos_bull, int bars_bos_bear) =>
    int rb = b_score
    int rs = s_score
    if delta_bull_trending and bull_bias
        rb += 1
    if delta_bear_trending and bear_bias
        rs += 1
    if vd_bull_div and bull_bias and (in_bu_ob or in_bu_fvg or sfp_bullish or in_ote_bull)
        rb += 2
    if vd_bear_div and bear_bias and (in_be_ob or in_be_fvg or sfp_bearish or in_ote_bear)
        rs += 2
    if stacked_bull_fvg and htf_bull and bull_bias
        rb += int(math.round(3.0 * _atr_norm_factor))
    if stacked_bear_fvg and htf_bear and bear_bias
        rs += int(math.round(3.0 * _atr_norm_factor))
    if in_tboe and bull_bias
        rb += 1
    if in_tboe and bear_bias
        rs += 1
    if htf_mss_bull and bull_bias and bars_bos_bull <= 10
        rb += 2
    if htf_mss_bear and bear_bias and bars_bos_bear <= 10
        rs += 2
    if htf_bull and htf_bias_strength >= 3 and bull_bias
        rb += 1
    if htf_bear and htf_bias_strength >= 3 and bear_bias
        rs += 1
    if gold_inst_flow_bull and bull_bias
        rb += 2
    if gold_inst_flow_bear and bear_bias
        rs += 2
    if gold_kz_round and bull_bias and close > current_price_rounded - gold_round_number_dist*0.5
        rb += 1
    if gold_kz_round and bear_bias and close < current_price_rounded + gold_round_number_dist*0.5
        rs += 1
    if gold_risk_off_buy and bull_bias
        rb += 2
    if gold_risk_off_sell and bear_bias
        rs += 2
    if _qtr_rebal and macro_bull_aligned and bull_bias and not macro_bear_aligned
        rb += 1
    if _qtr_rebal and macro_bear_aligned and bear_bias and not macro_bull_aligned
        rs += 1
    if vwap_reclaim_bull and bull_bias
        rb += 2
    if vwap_reclaim_bear and bear_bias
        rs += 2
    if strong_bullish_trend and not strong_bearish_trend and bull_bias
        rb += 1
    if strong_bearish_trend and not strong_bullish_trend and bear_bias
        rs += 1
    [rb, rs]

[b_post, s_post] = f_apply_post_bonuses(buy_score, sell_score, _bars_bos_bull, _bars_bos_bear)
buy_score  := b_post
sell_score := s_post

// ════════════════════════════════════════════════════════════════════════════
// SECTION 18 — SHANNON ENTROPY (V32-FIX-03) + PRE-SIGNAL ENGINE
// V32-FIX-03: 4-bin quantile entropy on ATR-scaled returns (20-bar window)
// Bins: strong-up, weak-up, weak-down, strong-down  (max H = log2(4) = 2.0)
// More accurate than 1-bit up/down encoding (max H = 1.0)
// ════════════════════════════════════════════════════════════════════════════
float _ret_thr = atr_val * 0.25
float _b_su = 0.0
float _b_wu = 0.0
float _b_wd = 0.0
float _b_sd = 0.0
for _ei = 0 to 19
    float _r = close[_ei] - close[_ei + 1]
    if _r > _ret_thr
        _b_su += 1.0
    else if _r > 0
        _b_wu += 1.0
    else if _r >= -_ret_thr
        _b_wd += 1.0
    else
        _b_sd += 1.0
float _ent_n = 20.0
float _p_su  = _b_su / _ent_n
float _p_wu  = _b_wu / _ent_n
float _p_wd  = _b_wd / _ent_n
float _p_sd  = _b_sd / _ent_n
float _e_su  = _p_su > 0 ? -_p_su * math.log(_p_su) / math.log(2.0) : 0.0
float _e_wu  = _p_wu > 0 ? -_p_wu * math.log(_p_wu) / math.log(2.0) : 0.0
float _e_wd  = _p_wd > 0 ? -_p_wd * math.log(_p_wd) / math.log(2.0) : 0.0
float _e_sd  = _p_sd > 0 ? -_p_sd * math.log(_p_sd) / math.log(2.0) : 0.0
float bar_entropy    = _e_su + _e_wu + _e_wd + _e_sd  // 0.0 = pure trend, 2.0 = max chaos
bool entropy_high    = bar_entropy > 1.70  // equiv 85% of max
bool entropy_critical= bar_entropy > 1.90  // equiv 95% of max

// Score Velocity Tracking (pre-signal acceleration detector)
int _buy_score_delta  = buy_score  - _prev_buy_score
int _sell_score_delta = sell_score - _prev_sell_score
_buy_vel_bars  := _buy_score_delta  > 0 ? _buy_vel_bars  + 1 : 0
_sell_vel_bars := _sell_score_delta > 0 ? _sell_vel_bars + 1 : 0
bool score_bull_rising       = _buy_score_delta  >= 1 and buy_score  >= validated_score_scalp
bool score_bear_rising       = _sell_score_delta >= 1 and sell_score >= validated_score_scalp
bool score_bull_accelerating = _buy_score_delta  >= 2 and buy_score  >= validated_score_scalp and htf_bull
bool score_bear_accelerating = _sell_score_delta >= 2 and sell_score >= validated_score_scalp and htf_bear
bool score_bull_surging      = _buy_vel_bars  >= 3 and buy_score  >= validated_score_intraday and htf_bull
bool score_bear_surging      = _sell_vel_bars >= 3 and sell_score >= validated_score_intraday and htf_bear

f_apply_entropy_bonuses(int b_score, int s_score, bool disp_bull, bool disp_bear, bool rsi_fs_bull, bool rsi_fs_bear) =>
    int rb = b_score
    int rs = s_score
    if disp_bull and htf_bull and bull_bias and not bull_disp_aligned
        rb += 2
    if disp_bear and htf_bear and bear_bias and not bear_disp_aligned
        rs += 2
    if rsi_fs_bull
        rb += 2
    if rsi_fs_bear
        rs += 2
    [rb, rs]

// Displacement candle bonus (GUARDED: only when not already in bull_disp_aligned)
float _body_size  = math.abs(close - open)
float _avg_body   = ta.sma(_body_size, 10)
bool _is_displacement_bull = close > open and _body_size >= _avg_body*1.5 and close >= high-(high-low)*0.15 and close > high[1] and close > high[2]
bool _is_displacement_bear = close < open and _body_size >= _avg_body*1.5 and close <= low+(high-low)*0.15  and close < low[1]  and close < low[2]

// RSI Failure Swing — hidden divergence detector (unique, no overlap with scoring)
bool rsi_fail_swing_bull = rsi_val > rsi_val[3] and low  >= low[3]  and rsi_val[3] < rsi_val[6] and bull_bias and htf_bull
bool rsi_fail_swing_bear = rsi_val < rsi_val[3] and high <= high[3] and rsi_val[3] > rsi_val[6] and bear_bias and htf_bear

[b_ent, s_ent] = f_apply_entropy_bonuses(buy_score, sell_score, _is_displacement_bull, _is_displacement_bear, rsi_fail_swing_bull, rsi_fail_swing_bear)
buy_score  := b_ent
sell_score := s_ent

// Snapshot final scores for velocity tracking next bar
_prev_buy_score  := buy_score
_prev_sell_score := sell_score
display_buy_score  := math.max(0, math.min(buy_score,  99))
display_sell_score := math.max(0, math.min(sell_score, 99))

// ════════════════════════════════════════════════════════════════════════════
// 2026 INSTITUTIONAL GOLD HACKS — Trap-Aware Precision Scoring
// Applied AFTER entropy bonuses; BEFORE adaptive thresholds so gates see full score
// ════════════════════════════════════════════════════════════════════════════

// HACK-1: ICT Silver Bullet FVG Precision (+3)
// At exact 10:00-11:00 UTC or 15:00-16:00 UTC: FVG + internal CHoCH = top-1% setup
bool _sb_fvg_bull = is_silver_bullet and in_bu_fvg and (internal_bull_choch or sfp_bullish or ob_fvg_ce_bull) and vol_ok
bool _sb_fvg_bear = is_silver_bullet and in_be_fvg and (internal_bear_choch or sfp_bearish or ob_fvg_ce_bear) and vol_ok
if _sb_fvg_bull
    buy_score  += 3
if _sb_fvg_bear
    sell_score += 3

// HACK-2: LDN/NY Overlap Power Window (+2)
// 12:00-13:00 UTC = highest institutional liquidity of day; OB/FVG entries amplified
bool _ldnny_overlap  = hour_utc == 12
bool _ldnny_bull = _ldnny_overlap and bull_bias and (in_bu_ob or in_bu_fvg or sfp_bullish)
bool _ldnny_bear = _ldnny_overlap and bear_bias and (in_be_ob or in_be_fvg or sfp_bearish)
if _ldnny_bull
    buy_score  += 2
if _ldnny_bear
    sell_score += 2

// HACK-3: Trap-Aware Smart Money Dampener (-3 buy / -3 sell)
// New HOD + OBV falling + overbought RSI = institutional distribution / bull trap
// New LOD + OBV rising  + oversold  RSI = institutional accumulation / bear trap
bool _bull_trap = high > ta.highest(high[1], 5) and obv_falling and rsi_val > 72
bool _bear_trap = low  < ta.lowest(low[1],  5) and obv_rising  and rsi_val < 28
if _bull_trap and not (in_bu_ob and vol_spike)  // Don't dampen valid OB entries
    buy_score  := math.max(0, buy_score  - 3)
    sell_score += 1
if _bear_trap and not (in_be_ob and vol_spike)
    sell_score := math.max(0, sell_score - 3)
    buy_score  += 1

// HACK-4: MSS Retest Premium Entry (+3)
// Market Structure Shift confirmed → price retests break level with rejection candle
bool _mss_retest_bull = (internal_bull_bos or internal_bull_choch) and f_near(low, last_support, atr_val * 0.4) and bullish_candle and vol_ok
bool _mss_retest_bear = (internal_bear_bos or internal_bear_choch) and f_near(high, last_resistance, atr_val * 0.4) and bearish_candle and vol_ok
if _mss_retest_bull
    buy_score  += 3
if _mss_retest_bear
    sell_score += 3

// HACK-5: Gold Century-Level Magnet (+1)
// Price within ATR*0.8 of any $100 century level → institutional stop-hunt magnet
bool _century_magnet = near_round_number and math.abs(close - math.round(close / 100.0) * 100.0) < atr_val * 0.8
if _century_magnet and bull_bias and in_discount
    buy_score  += 1
if _century_magnet and bear_bias and in_premium
    sell_score += 1

// HACK-6: Asian Sweep → London Reversal Power Setup (+4)
// Highest-probability ICT setup: Asian range sweep → London CHoCH confirmation
bool _asian_sw_ldn_bull = sweep_asian_low  and in_london_session and (internal_bull_choch or sfp_bullish) and htf_bull and bull_bias
bool _asian_sw_ldn_bear = sweep_asian_high and in_london_session and (internal_bear_choch or sfp_bearish) and htf_bear and bear_bias
if _asian_sw_ldn_bull
    buy_score  += 4
if _asian_sw_ldn_bear
    sell_score += 4

// HACK-7: NY Macro Time Windows (+2)
// ICT 9:50-10:10 / 10:50-11:10 EST = 14:50-15:10 / 15:50-16:10 UTC
int _min_utc = minute(time, "UTC")
bool _ny_macro_w1 = (hour_utc == 14 and _min_utc >= 50) or (hour_utc == 15 and _min_utc <= 10)
bool _ny_macro_w2 = (hour_utc == 15 and _min_utc >= 50) or (hour_utc == 16 and _min_utc <= 10)
bool _in_ny_macro = _ny_macro_w1 or _ny_macro_w2
if _in_ny_macro and bull_bias and (in_bu_ob or in_bu_fvg or sfp_bullish) and vol_ok
    buy_score  += 2
if _in_ny_macro and bear_bias and (in_be_ob or in_be_fvg or sfp_bearish) and vol_ok
    sell_score += 2

// HACK-8: Consecutive Institutional Delivery (+2)
// 3+ same-direction candles with rising volume = institutional delivery phase
bool _inst_del_bull = close > open and close[1] > open[1] and close[2] > open[2] and volume > volume[1] and volume[1] > volume[2] and bull_bias
bool _inst_del_bear = close < open and close[1] < open[1] and close[2] < open[2] and volume > volume[1] and volume[1] > volume[2] and bear_bias
if _inst_del_bull and htf_bull
    buy_score  += 2
if _inst_del_bear and htf_bear
    sell_score += 2

// HACK-9: Wick Rejection Quality Dampener (-2)
// Entry candle with wick >60% of range = weak conviction (except SFP/OB where wick IS the pattern)
float _cr = high - low
float _uw = high - math.max(open, close)
float _lw = math.min(open, close) - low
if _cr > 0 and (_uw / _cr > 0.60) and bull_bias and not (sfp_bullish or in_bu_ob)
    buy_score  := math.max(0, buy_score  - 2)
if _cr > 0 and (_lw / _cr > 0.60) and bear_bias and not (sfp_bearish or in_be_ob)
    sell_score := math.max(0, sell_score - 2)

// HACK-10: Gold $50 Half-Century Institutional Levels (+1)
float _hc_level = math.round(close / 50.0) * 50.0
bool _near_hc = math.abs(close - _hc_level) < atr_val * 0.6 and not near_century
if _near_hc and bull_bias and close < _hc_level
    buy_score  += 1
if _near_hc and bear_bias and close > _hc_level
    sell_score += 1

// HACK-11: DXY Inverse Strength Amplifier (+2)
bool _dxy_ext_bull = gold_dxy_confluence_bull and gold_institutional_flow and vol_spike and htf_bull
bool _dxy_ext_bear = gold_dxy_confluence_bear and gold_institutional_sell and vol_spike and htf_bear
if _dxy_ext_bull and bull_bias
    buy_score  += 2
if _dxy_ext_bear and bear_bias
    sell_score += 2

// HACK-12: Score Velocity Surge Bonus (+2)
if score_bull_surging and bull_bias
    buy_score  += 2
if score_bear_surging and bear_bias
    sell_score += 2

// Re-apply ceiling after all 2026 hacks
buy_score  := math.min(buy_score,  99)
sell_score := math.min(sell_score, 99)

// Refresh display scores with hack-adjusted values
display_buy_score  := math.max(0, math.min(buy_score,  99))
display_sell_score := math.max(0, math.min(sell_score, 99))

float _atr_vs_sma20 = atr_sma_20 > 0 ? atr_val / atr_sma_20 : 1.0
int _vol_adj = _atr_vs_sma20 > 1.5 ? 2 : _atr_vs_sma20 < 0.7 ? -1 : 0
int adaptive_score_scalp    = math.max(4, validated_score_scalp    + _vol_adj)
int adaptive_score_intraday = math.max(6, validated_score_intraday + _vol_adj)
int adaptive_score_swing    = math.max(8, validated_score_swing    + _vol_adj)

// 3-Tier Pre-Signal Alert booleans
// FIX-PS1: Pre-signal now fires without strict HTF bias — allows neutral-HTF buildup awareness
// Imminent: score in [scalp, swing) — signals entry zone approaching
bool _htf_presig_ok_buy  = htf_bull or (bull_bias and buy_score  >= adaptive_score_scalp  + 1)
bool _htf_presig_ok_sell = htf_bear or (bear_bias and sell_score >= adaptive_score_scalp + 1)
bool _presig_imminent_buy  = buy_score  >= adaptive_score_scalp   and buy_score  < adaptive_score_swing and _htf_presig_ok_buy  and not trade_lockdown
bool _presig_imminent_sell = sell_score >= adaptive_score_scalp   and sell_score < adaptive_score_swing and _htf_presig_ok_sell and not trade_lockdown
// ARCH-11: lvl2 READY — score in [intraday*0.9, intraday) AND elite pattern present
bool _presig_lvl2_buy      = buy_score  >= int(adaptive_score_intraday * 0.90) and buy_score  < adaptive_score_intraday and _htf_presig_ok_buy  and (unicorn_bull or mmxm_bull or ob_fvg_ce_bull or wyckoff_accum_conf) and not trade_lockdown
bool _presig_lvl2_sell     = sell_score >= int(adaptive_score_intraday * 0.90) and sell_score < adaptive_score_intraday and _htf_presig_ok_sell and (unicorn_bear or mmxm_bear or ob_fvg_ce_bear or wyckoff_dist_conf) and not trade_lockdown
bool _presig_building_buy  = score_bull_rising and _htf_presig_ok_buy  and not trade_lockdown
bool _presig_building_sell = score_bear_rising and _htf_presig_ok_sell and not trade_lockdown

// ════════════════════════════════════════════════════════════════════════════
// SECTION 19 — PROBABILITY ENGINE (6 MODULAR SUB-FUNCTIONS)
// ════════════════════════════════════════════════════════════════════════════
var float probability_buy  = 50.0
var float probability_sell = 50.0

// Buy Core
f_prob_buy_core(float p) =>
    float rb = p
    if htf_bull and bull_bias
        rb := f_apply_factor(rb, 0.12)
    if in_bu_ob or in_bu_fvg
        rb := f_apply_factor(rb, 0.10)
    if sfp_bullish and bull_bias
        rb := f_apply_factor(rb, 0.10)
    if new_structure_break and market==1
        rb := f_apply_factor(rb, 0.08)
    if in_kill_zone and bull_bias
        rb := f_apply_factor(rb, 0.10)
    if in_ote_bull
        rb := f_apply_factor(rb, 0.09)
    if judas_bull_active and bull_bias
        rb := f_apply_factor(rb, 0.10)
    rb

// Buy Indicators
f_prob_buy_ind(float p) =>
    float rb = p
    if macd_bull_alignment and bull_bias
        rb := f_apply_factor(rb, 0.06)
    if adx_trending and di_plus > di_minus
        rb := f_apply_factor(rb, 0.06)
    if vol_spike and bull_bias
        rb := f_apply_factor(rb, 0.07)
    if near_round_number and bull_bias
        rb := f_apply_factor(rb, 0.05)
    if gold_dxy_confluence_bull and bull_bias
        rb := f_apply_factor(rb, 0.07)
    if mtf_bullish_confluence
        rb := f_apply_factor(rb, 0.08)
    if macro_bull_aligned and bull_bias
        rb := f_apply_factor(rb, 0.08)
    if above_midnight_open and bull_bias
        rb := f_apply_factor(rb, 0.05)
    // BUG-02 FIXED: added exclusive directional gate (matches f_score_ict line 1891)
    if near_poc and bull_bias and not bear_bias
        rb := f_apply_factor(rb, 0.07)
    rb

// Buy Elite
f_prob_buy_elite(float p) =>
    float rb = p
    if liquidity_grab_bullish
        rb := f_apply_factor(rb, 0.08)
    if rsi_bullish_div and bull_bias
        rb := f_apply_factor(rb, 0.06)
    if internal_bull_choch
        rb := f_apply_factor(rb, 0.07)
    if aoe_breakout_bull and bull_bias
        rb := f_apply_factor(rb, 0.07)
    if amd_cycle_bull and bull_bias
        rb := f_apply_factor(rb, 0.12)
    if smt_divergence_bull and bull_bias
        rb := f_apply_factor(rb, 0.08)
    if ssl_swept and bull_bias
        rb := f_apply_factor(rb, 0.09)
    if _ts_bull_val and bull_bias
        rb := f_apply_factor(rb, 0.09)
    if trend_reversal_bull and bull_bias
        rb := f_apply_factor(rb, 0.07)
    if at_fvg_ce_bull and bull_bias
        rb := f_apply_factor(rb, 0.10)
    if at_ob_mt_bull and bull_bias
        rb := f_apply_factor(rb, 0.08)
    if targeting_erl_bull and bull_bias
        rb := f_apply_factor(rb, 0.09)
    if bull_rejection_block and bull_bias
        rb := f_apply_factor(rb, 0.07)
    if strong_bull_vi and bull_bias
        rb := f_apply_factor(rb, 0.06)
    // BUG-03 FIXED: BPR probability gated to bull-specific zone only
    if in_bpr and in_bu_ob and in_bu_fvg and bull_bias
        rb := f_apply_factor(rb, 0.10)
    if bull_disp_aligned and bull_bias
        rb := f_apply_factor(rb, 0.09)
    if unicorn_bull
        rb := f_apply_factor(rb, 0.14)
    if mmxm_bull and bull_bias
        rb := f_apply_factor(rb, 0.11)
    if ob_fvg_ce_bull and bull_bias
        rb := f_apply_factor(rb, 0.09)
    if po3_manip_bull and bull_bias
        rb := f_apply_factor(rb, 0.08)
    if _is_displacement_bull and bull_bias
        rb := f_apply_factor(rb, 0.10)
    if cisd_bull and bull_bias
        rb := f_apply_factor(rb, 0.09)
    if in_bull_breaker and bull_bias
        rb := f_apply_factor(rb, 0.08)
    if rsi_fail_swing_bull
        rb := f_apply_factor(rb, 0.07)
    if score_bull_accelerating
        rb := f_apply_factor(rb, 0.06)
    if vd_bull_div and bull_bias
        rb := f_apply_factor(rb, 0.09)
    if stacked_bull_fvg and htf_bull
        rb := f_apply_factor(rb, 0.10)
    if _lof_bull_val and bull_bias
        rb := f_apply_factor(rb, 0.13)
    if soro_bull and bull_bias
        rb := f_apply_factor(rb, 0.08)
    if gold_inst_flow_bull
        rb := f_apply_factor(rb, 0.08)
    if vwap_reclaim_bull and bull_bias
        rb := f_apply_factor(rb, 0.07)
    if gold_risk_off_buy and bull_bias
        rb := f_apply_factor(rb, 0.09)
    // Dampeners
    if is_overbought_vwap
        rb := rb * 0.88
    if kc_bull_exhaustion
        rb := rb * 0.90
    if not htf_bull and not gold_dxy_confluence_bull
        rb := rb * 0.92
    if entropy_critical
        rb := rb * 0.80
    else if entropy_high
        rb := rb * 0.90
    rb

// Sell Core
f_prob_sell_core(float p) =>
    float rs = p
    if htf_bear and bear_bias
        rs := f_apply_factor(rs, 0.12)
    if in_be_ob or in_be_fvg
        rs := f_apply_factor(rs, 0.10)
    if sfp_bearish and bear_bias
        rs := f_apply_factor(rs, 0.10)
    if new_structure_break and market==-1
        rs := f_apply_factor(rs, 0.08)
    if in_kill_zone and bear_bias
        rs := f_apply_factor(rs, 0.10)
    if in_ote_bear
        rs := f_apply_factor(rs, 0.09)
    if judas_bear_active and bear_bias
        rs := f_apply_factor(rs, 0.10)
    rs

// Sell Indicators
f_prob_sell_ind(float p) =>
    float rs = p
    if macd_bear_alignment and bear_bias
        rs := f_apply_factor(rs, 0.06)
    if adx_trending and di_minus > di_plus
        rs := f_apply_factor(rs, 0.06)
    if vol_spike and bear_bias
        rs := f_apply_factor(rs, 0.07)
    if near_round_number and bear_bias
        rs := f_apply_factor(rs, 0.05)
    if gold_dxy_confluence_bear and bear_bias
        rs := f_apply_factor(rs, 0.07)
    if mtf_bearish_confluence
        rs := f_apply_factor(rs, 0.08)
    if macro_bear_aligned and bear_bias
        rs := f_apply_factor(rs, 0.08)
    if below_midnight_open and bear_bias
        rs := f_apply_factor(rs, 0.05)
    // BUG-02 FIXED: added exclusive directional gate (matches f_score_ict line 1893)
    if near_poc and bear_bias and not bull_bias
        rs := f_apply_factor(rs, 0.07)
    rs

// Sell Elite
f_prob_sell_elite(float p) =>
    float rs = p
    if liquidity_grab_bearish
        rs := f_apply_factor(rs, 0.08)
    if rsi_bearish_div and bear_bias
        rs := f_apply_factor(rs, 0.06)
    if internal_bear_choch
        rs := f_apply_factor(rs, 0.07)
    if aoe_breakout_bear and bear_bias
        rs := f_apply_factor(rs, 0.07)
    if amd_cycle_bear and bear_bias
        rs := f_apply_factor(rs, 0.12)
    if smt_divergence_bear and bear_bias
        rs := f_apply_factor(rs, 0.08)
    if bsl_swept and bear_bias
        rs := f_apply_factor(rs, 0.09)
    if _ts_bear_val and bear_bias
        rs := f_apply_factor(rs, 0.09)
    if trend_reversal_bear and bear_bias
        rs := f_apply_factor(rs, 0.07)
    if at_fvg_ce_bear and bear_bias
        rs := f_apply_factor(rs, 0.10)
    if at_ob_mt_bear and bear_bias
        rs := f_apply_factor(rs, 0.08)
    if targeting_erl_bear and bear_bias
        rs := f_apply_factor(rs, 0.09)
    if bear_rejection_block and bear_bias
        rs := f_apply_factor(rs, 0.07)
    if strong_bear_vi and bear_bias
        rs := f_apply_factor(rs, 0.06)
    // BUG-03 FIXED: BPR probability gated to bear-specific zone only
    if in_bpr and in_be_ob and in_be_fvg and bear_bias
        rs := f_apply_factor(rs, 0.10)
    if bear_disp_aligned and bear_bias
        rs := f_apply_factor(rs, 0.09)
    if unicorn_bear
        rs := f_apply_factor(rs, 0.14)
    if mmxm_bear and bear_bias
        rs := f_apply_factor(rs, 0.11)
    if ob_fvg_ce_bear and bear_bias
        rs := f_apply_factor(rs, 0.09)
    if po3_manip_bear and bear_bias
        rs := f_apply_factor(rs, 0.08)
    if _is_displacement_bear and bear_bias
        rs := f_apply_factor(rs, 0.10)
    if cisd_bear and bear_bias
        rs := f_apply_factor(rs, 0.09)
    if in_bear_breaker and bear_bias
        rs := f_apply_factor(rs, 0.08)
    if rsi_fail_swing_bear
        rs := f_apply_factor(rs, 0.07)
    if score_bear_accelerating
        rs := f_apply_factor(rs, 0.06)
    if vd_bear_div and bear_bias
        rs := f_apply_factor(rs, 0.09)
    if stacked_bear_fvg and htf_bear
        rs := f_apply_factor(rs, 0.10)
    if _lof_bear_val and bear_bias
        rs := f_apply_factor(rs, 0.13)
    if soro_bear and bear_bias
        rs := f_apply_factor(rs, 0.08)
    if gold_inst_flow_bear
        rs := f_apply_factor(rs, 0.08)
    if vwap_reclaim_bear and bear_bias
        rs := f_apply_factor(rs, 0.07)
    if gold_risk_off_sell and bear_bias
        rs := f_apply_factor(rs, 0.09)
    // Dampeners
    if is_oversold_vwap
        rs := rs * 0.88
    if kc_bear_exhaustion
        rs := rs * 0.90
    if not htf_bear and not gold_dxy_confluence_bear
        rs := rs * 0.92
    if entropy_critical
        rs := rs * 0.80
    else if entropy_high
        rs := rs * 0.90
    rs

// V32-FIX-08: Regime-aware probability start
// ADX strong trend → 55% base (higher base rate for trending success)
// ADX ranging      → 40% base (lower base rate in consolidation)
// Normal           → 50% base (neutral)
float _regime_base = adx_strong_trend ? 55.0 : adx_ranging ? 40.0 : 50.0

// V32-FIX-04: Adaptive probability decay with exponential carry-over
// Use last_signal_bar_any (already persisted) instead of strong_buy/sell forward reference
// last_signal_bar_any is updated at signal fire time — gives exact bars since last trade
_bars_since_strong_signal := bar_index - last_signal_bar_any
float _decay_factor  = math.exp(-0.12 * math.min(float(_bars_since_strong_signal), 30.0))
float _carry_weight  = 0.12 * _decay_factor   // decays from 12% → near 0% over ~25 bars
float _pb_start = _regime_base * (1.0 - _carry_weight) + _prob_buy_carry  * _carry_weight
float _ps_start = _regime_base * (1.0 - _carry_weight) + _prob_sell_carry * _carry_weight

float _pb1 = f_prob_buy_core(_pb_start)
float _pb2 = f_prob_buy_ind(_pb1)
float _pb  = f_prob_buy_elite(_pb2)
float _ps1 = f_prob_sell_core(_ps_start)
float _ps2 = f_prob_sell_ind(_ps1)
float _ps  = f_prob_sell_elite(_ps2)

// Final dampeners & constraints
bool _elite_rev_bull = unicorn_bull or mmxm_bull or reversal_buy_exhaustion  or trend_reversal_bull
bool _elite_rev_bear = unicorn_bear or mmxm_bear or reversal_sell_exhaustion or trend_reversal_bear
if not htf_bull and not _elite_rev_bull
    _pb := math.min(_pb, 70.0)
if not htf_bear and not _elite_rev_bear
    _ps := math.min(_ps, 70.0)

// V30-FIX-14: Cross-probability conflict dampener (both >70% → force 62% WAIT)
if _pb > 70.0 and _ps > 70.0 and not _elite_rev_bull and not _elite_rev_bear
    _pb := 62.0
    _ps := 62.0

// Reversal exhaustion boost
if reversal_buy_exhaustion  and bull_bias
    _pb := f_apply_factor(_pb, 0.13)
if reversal_sell_exhaustion and bear_bias
    _ps := f_apply_factor(_ps, 0.13)
if in_tboe
    _pb := f_apply_factor(_pb, 0.06)
    _ps := f_apply_factor(_ps, 0.06)

// V38-FINAL: Institutional hack probability integration
if _asian_sw_ldn_bull
    _pb := f_apply_factor(_pb, 0.14)
if _asian_sw_ldn_bear
    _ps := f_apply_factor(_ps, 0.14)
if _in_ny_macro and bull_bias and (in_bu_ob or in_bu_fvg)
    _pb := f_apply_factor(_pb, 0.08)
if _in_ny_macro and bear_bias and (in_be_ob or in_be_fvg)
    _ps := f_apply_factor(_ps, 0.08)
if _inst_del_bull
    _pb := f_apply_factor(_pb, 0.07)
if _inst_del_bear
    _ps := f_apply_factor(_ps, 0.07)
if score_bull_surging
    _pb := f_apply_factor(_pb, 0.08)
if score_bear_surging
    _ps := f_apply_factor(_ps, 0.08)
if _cr > 0 and (_uw / _cr > 0.60) and bull_bias and not sfp_bullish
    _pb := _pb * 0.92
if _cr > 0 and (_lw / _cr > 0.60) and bear_bias and not sfp_bearish
    _ps := _ps * 0.92

// Save carry-over (decayed)
_prob_buy_carry  := _pb
_prob_sell_carry := _ps

// Floor at 45% gives more dynamic range (was 50 — created dead zone with 68% gate)
probability_buy  := math.max(45.0, math.min(_pb, 92.0))
probability_sell := math.max(45.0, math.min(_ps, 92.0))

// Session-adjusted capped probability (KZ gets 1.15x boost)
float session_multiplier = in_kill_zone ? 1.15 : in_asian_session ? 0.85 : 1.0
float capped_prob_buy  = math.max(45.0, math.min(probability_buy  >= 60.0 ? probability_buy  * session_multiplier : probability_buy,  92.0))
float capped_prob_sell = math.max(45.0, math.min(probability_sell >= 60.0 ? probability_sell * session_multiplier : probability_sell, 92.0))

// V32-FIX-10: Dynamic probability gate — extreme vol + live win-rate calibration
// _live_winrate persists from prior bar outcomes — safe to reference here
int _eff_min_prob_calib_early = not na(_live_winrate) and _live_winrate < 60.0 ? min_probability + 5 : min_probability
int _eff_min_prob = _atr_vs_sma20 > 2.0 ? _eff_min_prob_calib_early + 5 : _eff_min_prob_calib_early

// Confidence labels
string confidence_label_buy  = capped_prob_buy  >= 80 and buy_score  >= 10 and adx_trending and (in_bu_ob or in_bu_fvg or in_ote_bull or in_bpr) ? "HIGH" : (capped_prob_buy >= 65 and buy_score  >= 7) or buy_score  >= adaptive_score_intraday ? "MEDIUM" : "LOW"
string confidence_label_sell = capped_prob_sell >= 80 and sell_score >= 10 and adx_trending and (in_be_ob or in_be_fvg or in_ote_bear or in_bpr) ? "HIGH" : (capped_prob_sell >= 65 and sell_score >= 7) or sell_score >= adaptive_score_intraday ? "MEDIUM" : "LOW"

// ════════════════════════════════════════════════════════════════════════════
// SECTION 20 — SIGNAL GATING & FILTERS
// ════════════════════════════════════════════════════════════════════════════
bool regime_gate_buy  = true
bool regime_gate_sell = true
if use_market_regime
    if adx_strong_trend
        regime_gate_buy  := di_plus  > di_minus or buy_score  >= 5 or sfp_bullish or liquidity_grab_bullish or in_bu_ob
        regime_gate_sell := di_minus > di_plus  or sell_score >= 5 or sfp_bearish or liquidity_grab_bearish or in_be_ob
    if adx_ranging
        regime_gate_buy  := (in_bu_ob or in_bu_fvg or in_ote_bull) and ((sfp_bullish or liquidity_grab_bullish or sweep_confirmed_bull or ssl_swept) or buy_score  >= validated_score_intraday)
        regime_gate_sell := (in_be_ob or in_be_fvg or in_ote_bear) and ((sfp_bearish or liquidity_grab_bearish or sweep_confirmed_bear or bsl_swept) or sell_score >= validated_score_intraday)

bool _score_ok_any   = buy_score >= validated_score_scalp or sell_score >= validated_score_scalp
bool _zone_active    = (in_bu_ob and close>open) or (in_be_ob and close<open)
bool institutional_move = _score_ok_any or sfp_bullish or sfp_bearish or liquidity_grab_bullish or liquidity_grab_bearish or new_structure_break or breakout_up or breakout_down or _zone_active
bool signal_env_ok   = (avoid_asian or institutional_move) and ((in_session and normal_volatility and safe_to_trade) or institutional_move)

bool in_bullish_zone = in_bu_ob or in_bu_fvg or near_support or near_fib_bull or in_ote_bull
bool in_bearish_zone = in_be_ob or in_be_fvg or near_resistance or near_fib_bear or in_ote_bear

// Gold-specific entry gate (tighter than broad in_prime_session)
// GAP-5 FIX: Gold gate expanded with Asian sweep, NY macro, and institutional delivery
gold_gate_buy  = (near_round_number and vol_spike) or (near_round_number and in_kill_zone) or near_fib_bull or rsi_bullish_div or liquidity_grab_bullish or breakout_up or institutional_accumulation or is_silver_bullet or sfp_bullish or bullish_order_flow or in_ote_bull or _asian_sw_ldn_bull or (_in_ny_macro and bull_bias) or _inst_del_bull
gold_gate_sell = (near_round_number and vol_spike) or (near_round_number and in_kill_zone) or near_fib_bear or rsi_bearish_div or liquidity_grab_bearish or breakout_down or institutional_distribution or is_silver_bullet or sfp_bearish or bearish_order_flow or in_ote_bear or _asian_sw_ldn_bear or (_in_ny_macro and bear_bias) or _inst_del_bear

// Anti-trap filter (don't buy into HTF supply or sell into HTF demand without confirmation)
bool anti_trap_buy  = not (htf_bear and in_premium  and not sweep_confirmed_bull and not in_kill_zone and not judas_bull_active)
bool anti_trap_sell = not (htf_bull  and in_discount and not sweep_confirmed_bear and not in_kill_zone and not judas_bear_active)

// Session gate (with institutional override)
bool inst_score_ok  = buy_score >= validated_score_intraday or sell_score >= validated_score_intraday
bool inst_trigger   = sfp_bullish or sfp_bearish or in_bu_ob or in_be_ob or in_bu_fvg or in_be_fvg or near_round_number or near_century or liquidity_grab_bullish or liquidity_grab_bearish or new_structure_break or breakout_up or breakout_down or aoe_breakout_bull or aoe_breakout_bear
bool inst_session_override = inst_score_ok and inst_trigger
bool session_gate   = in_session or inst_session_override

// Probability gates
bool prob_gate_buy  = capped_prob_buy  >= _eff_min_prob or buy_score  >= validated_score_intraday
bool prob_gate_sell = capped_prob_sell >= _eff_min_prob or sell_score >= validated_score_intraday

f_beginner_gates() =>
    bool bb = true
    bool bs = true
    if use_beginner_mode
        bb := buy_score  >= min_quality_score
        bs := sell_score >= min_quality_score
        if require_trend_alignment
            // Allow HTF bull+zone OR strong trend — not both required simultaneously
            bb := bb and (strong_bullish_trend or (htf_bull and (in_bu_ob or in_bu_fvg or near_support or in_ote_bull)))
            bs := bs and (strong_bearish_trend or (htf_bear and (in_be_ob or in_be_fvg or near_resistance or in_ote_bear)))
        if require_zone_entry
            // Widened zone to include OTE + round numbers (Gold-specific)
            bb := bb and (in_bullish_zone or in_ote_bull or near_round_number)
            bs := bs and (in_bearish_zone or in_ote_bear or near_round_number)
        if block_ranging_market
            // FIX-R1: Allow institutional zone entries even in ranging market
            // Pure range-middle signals are blocked; OB/FVG/OTE zone entries are allowed
            bool _zone_ok_buy  = (in_bu_ob or in_bu_fvg or in_ote_bull or near_round_number) and bull_bias
            bool _zone_ok_sell = (in_be_ob or in_be_fvg or in_ote_bear or near_round_number) and bear_bias
            bb := bb and (trending_market or _zone_ok_buy)
            bs := bs and (trending_market or _zone_ok_sell)
        if require_volume_spike
            // Use vol_ok (above 20-bar SMA) instead of vol_spike (1.5×) — less restrictive
            bb := bb and vol_ok
            bs := bs and vol_ok
        // Widened RSI gates: allow deeper pullbacks (40-77 buy, 23-60 sell)
        bb := bb and rsi_val >= math.min(validated_rsi_buy_min, 40) and rsi_val < 77
        bs := bs and rsi_val <= math.max(validated_rsi_sell_max, 60) and rsi_val > 23
        // Candle confirmation: any bullish/bearish close or reversal pattern
        bb := bb and (bullish_candle or bullish_engulfing or pin_bar_bull or sfp_bullish or liquidity_grab_bullish or (close > open and close > close[1]) or gold_bull_momentum_candle)
        bs := bs and (bearish_candle or bearish_engulfing or pin_bar_bear or sfp_bearish or liquidity_grab_bearish or (close < open and close < close[1]) or gold_bear_momentum_candle)
        bb := bb and signal_env_ok
        bs := bs and signal_env_ok
    [bb, bs]

// Beginner / Institutional gate
[beginner_buy_confirmed, beginner_sell_confirmed] = f_beginner_gates()

// Signal tier classification
bool _sg_buy  = session_gate and signal_env_ok and regime_gate_buy
bool _sg_sell = session_gate and signal_env_ok and regime_gate_sell
bool _pg_buy  = session_gate and signal_env_ok and prob_gate_buy  and gold_gate_buy  and regime_gate_buy
bool _pg_sell = session_gate and signal_env_ok and prob_gate_sell and gold_gate_sell and regime_gate_sell
f_professional_entries() =>
    bool _i_t_b = bull_bias or in_bu_ob or in_bu_fvg or bullish_divergence or sfp_bullish or new_structure_break or near_support or near_fib_bull
    bool _i_t_s = bear_bias or in_be_ob or in_be_fvg or bearish_divergence or sfp_bearish or new_structure_break or near_resistance or near_fib_bear
    // FIX-P1: Scalp — added gold_gate as additional qualifier to catch round-number/FVG scalps
    bool s_b_p = buy_score  >= validated_score_scalp    and _pg_buy  and (bull_bias or in_bu_ob or in_bu_fvg or near_fib_bull or liquidity_grab_bullish or sfp_bullish or near_round_number or htf_bull or gold_gate_buy)
    bool s_s_p = sell_score >= validated_score_scalp    and _pg_sell and (bear_bias or in_be_ob or in_be_fvg or near_fib_bear or liquidity_grab_bearish or sfp_bearish or near_round_number or htf_bear or gold_gate_sell)
    // FIX-P2: Intraday — HTF neutral override: if score >= intraday+2 AND in institutional zone, fire
    // This is the PRIMARY fix for missing intraday signals when dashboard shows NEUTRAL
    bool _htf_ok_buy  = htf_bull or (not htf_bear and buy_score  >= validated_score_intraday + 2 and (in_bu_ob or in_bu_fvg or in_ote_bull or sweep_confirmed_bull or internal_bull_choch))
    bool _htf_ok_sell = htf_bear or (not htf_bull and sell_score >= validated_score_intraday + 2 and (in_be_ob or in_be_fvg or in_ote_bear or sweep_confirmed_bear or internal_bear_choch))
    bool i_b_p = buy_score  >= validated_score_intraday and _pg_buy  and _htf_ok_buy  and _i_t_b
    bool i_s_p = sell_score >= validated_score_intraday and _pg_sell and _htf_ok_sell and _i_t_s
    // FIX-P3: Swing — allow MTF neutral when DXY+momentum aligned (Gold-specific macro override)
    bool _sw_htf_ok_buy  = htf_bull or (gold_dxy_confluence_bull and buy_score  >= validated_score_swing + 1 and macro_bull_aligned)
    bool _sw_htf_ok_sell = htf_bear or (gold_dxy_confluence_bear and sell_score >= validated_score_swing + 1 and macro_bear_aligned)
    bool sw_b_p = buy_score  >= validated_score_swing and _pg_buy  and _sw_htf_ok_buy  and (mtf_bullish_confluence or (in_bu_ob and in_bu_fvg) or unicorn_bull or mmxm_bull) and (bull_bias or in_bu_ob or bullish_divergence or bullish_order_flow or breakout_up)
    bool sw_s_p = sell_score >= validated_score_swing and _pg_sell and _sw_htf_ok_sell and (mtf_bearish_confluence or (in_be_ob and in_be_fvg) or unicorn_bear or mmxm_bear) and (bear_bias or in_be_ob or bearish_divergence or bearish_order_flow or breakout_down)
    [s_b_p, s_s_p, i_b_p, i_s_p, sw_b_p, sw_s_p]

[scalp_buy_professional, scalp_sell_professional, intraday_buy_professional, intraday_sell_professional, swing_buy_professional, swing_sell_professional] = f_professional_entries()

f_raw_entries() =>
    bool r_b = use_beginner_mode ? beginner_buy_confirmed  : (use_probability_scoring ? (scalp_buy_professional  or intraday_buy_professional  or swing_buy_professional)  : (buy_score  >= validated_score_scalp  and _sg_buy  and (bull_bias or in_bu_ob or in_bu_fvg or near_support or near_fib_bull)))
    bool r_s = use_beginner_mode ? beginner_sell_confirmed : (use_probability_scoring ? (scalp_sell_professional or intraday_sell_professional or swing_sell_professional) : (sell_score >= validated_score_scalp  and _sg_sell and (bear_bias or in_be_ob or in_be_fvg or near_resistance or near_fib_bear)))
    bool r_s_b = use_beginner_mode ? (beginner_buy_confirmed  and buy_score  >= validated_score_swing) : (use_probability_scoring ? swing_buy_professional  : (buy_score  >= validated_score_swing and _sg_buy  and htf_bull and mtf_bullish_confluence))
    bool r_s_s = use_beginner_mode ? (beginner_sell_confirmed and sell_score >= validated_score_swing) : (use_probability_scoring ? swing_sell_professional : (sell_score >= validated_score_swing and _sg_sell and htf_bear and mtf_bearish_confluence))
    // FIX-R2: Raw intraday — propagate HTF-neutral override to non-probability mode path
    bool _r_htf_buy  = htf_bull or (not htf_bear and buy_score  >= validated_score_intraday + 2 and (in_bu_ob or in_bu_fvg or in_ote_bull))
    bool _r_htf_sell = htf_bear or (not htf_bull and sell_score >= validated_score_intraday + 2 and (in_be_ob or in_be_fvg or in_ote_bear))
    bool r_i_b = use_beginner_mode ? (beginner_buy_confirmed  and buy_score  >= validated_score_intraday and buy_score  < validated_score_swing) : (use_probability_scoring ? intraday_buy_professional  : (buy_score  >= validated_score_intraday and _sg_buy  and _r_htf_buy))
    bool r_i_s = use_beginner_mode ? (beginner_sell_confirmed and sell_score >= validated_score_intraday and sell_score < validated_score_swing) : (use_probability_scoring ? intraday_sell_professional : (sell_score >= validated_score_intraday and _sg_sell and _r_htf_sell))
    [r_b, r_s, r_s_b, r_s_s, r_i_b, r_i_s]

[raw_buy, raw_sell, raw_swing_buy, raw_swing_sell, raw_intraday_buy, raw_intraday_sell] = f_raw_entries()

// Sniper entries
// GAP-1 FIX: Allow breakout snipers when Asian sweep→London reversal is active (HTF neutral OK)
bool _sniper_htf_bull = htf_bull or (_asian_sw_ldn_bull and not htf_bear) or (_in_ny_macro and bull_bias and buy_score >= validated_score_intraday)
bool _sniper_htf_bear = htf_bear or (_asian_sw_ldn_bear and not htf_bull) or (_in_ny_macro and bear_bias and sell_score >= validated_score_intraday)
bool valid_breakout_buy   = follow_through_up and strong_body_up and _sniper_htf_bull and session_gate
bool valid_breakout_sell  = follow_through_dn and strong_body_dn and _sniper_htf_bear and session_gate
bool valid_rejection_buy  = rejection_demand  and bull_bias and session_gate
bool valid_rejection_sell = rejection_supply  and bear_bias and session_gate
bool pdl_sweep_sniper     = sweep_pdl and htf_bull and close > pdl
bool pdh_sweep_sniper     = sweep_pdh and htf_bear and close < pdh
bool ce_sniper_buy        = at_fvg_ce_bull and in_bu_fvg and htf_bull and session_gate and signal_env_ok and buy_score  >= adaptive_score_scalp
bool ce_sniper_sell       = at_fvg_ce_bear and in_be_fvg and htf_bear and session_gate and signal_env_ok and sell_score >= adaptive_score_scalp
bool rb_sniper_buy        = bull_rejection_block and (in_bu_ob or in_bu_fvg) and htf_bull and session_gate and signal_env_ok and buy_score  >= adaptive_score_scalp
bool rb_sniper_sell       = bear_rejection_block and (in_be_ob or in_be_fvg) and htf_bear and session_gate and signal_env_ok and sell_score >= adaptive_score_scalp

f_sniper_entries() =>
    bool l_s_s_b = liq_sweep_bull_v15 and htf_bull and (in_bu_ob or in_bu_fvg or near_support) and buy_score  >= adaptive_score_scalp and signal_env_ok and sweep_quality_ok_bull
    bool l_s_s_s = liq_sweep_bear_v15 and htf_bear and (in_be_ob or in_be_fvg or near_resistance) and sell_score >= adaptive_score_scalp and signal_env_ok and sweep_quality_ok_bear
    bool z_r_b = (in_bu_ob or in_bu_fvg) and (sfp_bullish or sweep_confirmed_bull) and rsi_val < 40 and session_gate and buy_score  >= adaptive_score_scalp and signal_env_ok and gold_bull_momentum_candle
    bool z_r_s = (in_be_ob or in_be_fvg) and (sfp_bearish or sweep_confirmed_bear) and rsi_val > 60 and session_gate and sell_score >= adaptive_score_scalp and signal_env_ok and gold_bear_momentum_candle
    
    bool s_r_b = (valid_breakout_buy or valid_rejection_buy or turtle_soup_bull or pdl_sweep_sniper or z_r_b or l_s_s_b or rb_sniper_buy or ce_sniper_buy) and session_gate and signal_env_ok
    bool s_r_s = (valid_breakout_sell or valid_rejection_sell or turtle_soup_bear or pdh_sweep_sniper or z_r_s or l_s_s_s or rb_sniper_sell or ce_sniper_sell) and session_gate and signal_env_ok
    [s_r_b, s_r_s]

[sniper_raw_buy, sniper_raw_sell] = f_sniper_entries()
bool _sniper_asian_ok = not in_asian_session or buy_score >= validated_score_intraday or sell_score >= validated_score_intraday
sniper_raw_buy  := sniper_raw_buy  and _sniper_asian_ok
sniper_raw_sell := sniper_raw_sell and _sniper_asian_ok

// ════════════════════════════════════════════════════════════════════════════
// SECTION 21 — CONFLICT RESOLUTION & COOLDOWN
// ════════════════════════════════════════════════════════════════════════════
// V30-FIX-17: Adaptive cooldown (extreme vol → 2x)
int _adaptive_cooldown = _atr_vs_sma20 > 2.0 ? signal_cooldown * 2 : signal_cooldown
bool buy_cooldown_ok  = (bar_index - last_buy_bar)  >= _adaptive_cooldown
bool sell_cooldown_ok = (bar_index - last_sell_bar) >= _adaptive_cooldown
bool flip_ok_to_buy   = (bar_index - last_sell_bar) >= _adaptive_cooldown
bool flip_ok_to_sell  = (bar_index - last_buy_bar)  >= _adaptive_cooldown

// V30-NEW-01: Conflict zone tightened to 1pt for Gold (institutional turns are precise)
bool score_conflict_zone    = math.abs(buy_score - sell_score) <= 1 and buy_score >= adaptive_score_scalp and sell_score >= adaptive_score_scalp
bool conflict_override_buy  = unicorn_bull or mmxm_bull or ob_fvg_ce_bull
bool conflict_override_sell = unicorn_bear or mmxm_bear or ob_fvg_ce_bear
bool conflict_clear_buy  = not score_conflict_zone or conflict_override_buy
bool conflict_clear_sell = not score_conflict_zone or conflict_override_sell

// V38: Loss Streak Equity Stop (from v35)
bool _loss_streak_ok = _consec_losses < max_consec_losses
// Auto-reset after 20 quiet bars so sim losses don't freeze live signals
if _consec_losses >= max_consec_losses and (bar_index - last_signal_bar_any) > 20
    _consec_losses := 0
plotshape(score_conflict_zone and not trade_lockdown, title="Conflict", location=location.belowbar, style=shape.diamond, color=color.new(color.orange,40), size=size.tiny)

f_calc_ep_sl_tp_kz() =>
    float ep_b  = in_ote_bull ? ote_bull_low  : in_bu_ob ? nz(ob_mt_bull,  close) : in_bu_fvg ? nz(fvg_ce_bull, close) : close
    float ep_s  = in_ote_bear ? ote_bear_high : in_be_ob ? nz(ob_mt_bear,  close) : in_be_fvg ? nz(fvg_ce_bear, close) : close
    ep_b := na(ep_b) ? close : ep_b
    ep_s := na(ep_s) ? close : ep_s
    float sl_r_b  = not na(l0) ? math.min(l0 - atr_val*0.3, low  - atr_val*0.5) : low  - atr_val*1.5
    float sl_r_s  = not na(h0) ? math.max(h0 + atr_val*0.3, high + atr_val*0.5) : high + atr_val*1.5
    float sl_b   = math.min(sl_r_b,  ep_b  - atr_val*1.0)
    float sl_s  = math.max(sl_r_s, ep_s + atr_val*1.0)
    float rsk_b  = math.max(math.abs(ep_b  - sl_b),  atr_val)
    float rsk_s = math.max(math.abs(sl_s - ep_s), atr_val)
    float tp1_b  = ep_b  + rsk_b  * rr_scalp
    float tp2_b  = ep_b  + rsk_b  * rr_intraday
    float tp3_b  = ep_b  + rsk_b  * rr_swing * 1.618
    float tp1_s = ep_s - rsk_s * rr_scalp
    float tp2_s = ep_s - rsk_s * rr_intraday
    float tp3_s = ep_s - rsk_s * rr_swing * 1.618
    bool kz_e_b  = sfp_bullish or (in_bu_ob and close>open and close>close[1]) or (judas_bull_active and (in_bu_ob or in_bu_fvg)) or (pdl_sweep_sniper and internal_bull_choch) or (liq_low_sweep and (in_bu_ob or in_bu_fvg) and vol_spike) or (sweep_asian_low and internal_bull_choch and htf_bull) or (ssl_swept and at_fvg_ce_bull)
    bool kz_e_s = sfp_bearish or (in_be_ob and close<open and close<close[1]) or (judas_bear_active and (in_be_ob or in_be_fvg)) or (pdh_sweep_sniper and internal_bear_choch) or (liq_high_sweep and (in_be_ob or in_be_fvg) and vol_spike) or (sweep_asian_high and internal_bear_choch and htf_bear) or (bsl_swept and at_fvg_ce_bear)
    float kz_r_b  = math.max(math.abs(ep_b  - sl_b),  atr_val * 0.5)
    float kz_r_s = math.max(math.abs(sl_s - ep_s), atr_val * 0.5)
    bool kz_rr_b   = kz_r_b  > 0 ? (math.abs(tp1_b  - ep_b)  / kz_r_b)  >= 1.5 : false
    bool kz_rr_s  = kz_r_s > 0 ? (math.abs(tp1_s - ep_s) / kz_r_s) >= 1.5 : false
    // GAP-2 FIX: KZ fires during NY Macro windows with bull_bias (doesn't require strict HTF)
    bool _kz_htf_b = htf_bull or (_in_ny_macro and bull_bias and buy_score  >= validated_score_intraday)
    bool _kz_htf_s = htf_bear or (_in_ny_macro and bear_bias and sell_score >= validated_score_intraday)
    bool kz_b  = in_kill_zone and kz_e_b  and _kz_htf_b and buy_cooldown_ok  and flip_ok_to_buy  and signal_env_ok and buy_score  >= adaptive_score_scalp and conflict_clear_buy  and kz_rr_b
    bool kz_s = in_kill_zone and kz_e_s and _kz_htf_s and sell_cooldown_ok and flip_ok_to_sell and signal_env_ok and sell_score >= adaptive_score_scalp and conflict_clear_sell and kz_rr_s
    [ep_b, ep_s, sl_b, sl_s, tp1_b, tp2_b, tp3_b, tp1_s, tp2_s, tp3_s, kz_b, kz_s]

// EP / SL / TP (pre-computed for KZ RR filter and state machine)
[buy_ep, sell_ep, buy_sl, sell_sl, buy_tp1, buy_tp2, buy_tp3, sell_tp1, sell_tp2, sell_tp3, kz_buy_raw, kz_sell_raw] = f_calc_ep_sl_tp_kz()

// Main conflict resolution
bool any_buy  = raw_buy  or sniper_raw_buy  or kz_buy_raw
bool any_sell = raw_sell or sniper_raw_sell or kz_sell_raw
bool conflict = any_buy  and any_sell
bool buy_wins = false
bool sell_wins= false
if conflict
    bool _bp = sniper_raw_buy  or kz_buy_raw
    bool _sp = sniper_raw_sell or kz_sell_raw
    if _bp and not _sp
        buy_wins := true
    else if _sp and not _bp
        sell_wins := true
    else if buy_score > sell_score
        buy_wins := true
    else if sell_score > buy_score
        sell_wins := true
    else
        if (in_be_ob or in_be_fvg) and not (in_bu_ob or in_bu_fvg)
            sell_wins := true
        else if (in_bu_ob or in_bu_fvg) and not (in_be_ob or in_be_fvg)
            buy_wins := true
        else if probability_buy >= probability_sell
            buy_wins := true
        else
            sell_wins := true

int effective_min_score = math.max(min_score_to_show, validated_score_scalp)
bool score_ok_buy  = buy_score  >= effective_min_score or (raw_swing_buy  and buy_score  >= adaptive_score_swing) or (raw_intraday_buy  and buy_score  >= adaptive_score_intraday)
bool score_ok_sell = sell_score >= effective_min_score or (raw_swing_sell and sell_score >= adaptive_score_swing) or (raw_intraday_sell and sell_score >= adaptive_score_intraday)
bool dist_ok_buy   = not trade_lockdown or math.abs(close - frozen_ep) > (atr_val * 0.5) or (bar_index - last_signal_bar_any) > 15
bool dist_ok_sell  = not trade_lockdown or math.abs(close - frozen_ep) > (atr_val * 0.5) or (bar_index - last_signal_bar_any) > 15

bool sniper_buy  = sniper_raw_buy  and (not conflict or buy_wins)  and buy_cooldown_ok  and flip_ok_to_buy  and score_ok_buy  and dist_ok_buy
bool sniper_sell = sniper_raw_sell and (not conflict or sell_wins) and sell_cooldown_ok and flip_ok_to_sell and score_ok_sell and dist_ok_sell

bool _inst_quality_buy  = not use_beginner_mode or beginner_buy_confirmed  or swing_buy_professional  or intraday_buy_professional  or unicorn_bull or mmxm_bull
bool _inst_quality_sell = not use_beginner_mode or beginner_sell_confirmed or swing_sell_professional or intraday_sell_professional or unicorn_bear or mmxm_bear
bool filtered_buy_gated  = (raw_buy  or sniper_buy  or kz_buy_raw)  and (not conflict or buy_wins)  and anti_trap_buy  and _inst_quality_buy
bool filtered_sell_gated = (raw_sell or sniper_sell or kz_sell_raw) and (not conflict or sell_wins) and anti_trap_sell and _inst_quality_sell

// Tier signals with swing confirmation filter
bool intraday_buy  = raw_intraday_buy  and filtered_buy_gated  and buy_cooldown_ok  and flip_ok_to_buy  and session_gate and dist_ok_buy
bool intraday_sell = raw_intraday_sell and filtered_sell_gated and sell_cooldown_ok and flip_ok_to_sell and session_gate and dist_ok_sell
bool swing_buy     = raw_swing_buy     and filtered_buy_gated  and buy_cooldown_ok  and flip_ok_to_buy  and session_gate and dist_ok_buy
bool swing_sell    = raw_swing_sell    and filtered_sell_gated and sell_cooldown_ok and flip_ok_to_sell and session_gate and dist_ok_sell

// Swing 2-bar confirmation
_swing_buy_consec  := raw_swing_buy  ? _swing_buy_consec  + 1 : 0
_swing_sell_consec := raw_swing_sell ? _swing_sell_consec + 1 : 0
// Lowered institutional bypass threshold: 14→12 (catches more high-conviction intraday setups)
bool _swing_inst_bypass_buy  = buy_score  >= 12 and htf_bull and (in_bpr or (in_bu_ob and in_bu_fvg) or unicorn_bull or mmxm_bull or in_ote_bull or (amd_cycle_bull and in_kill_zone))
bool _swing_inst_bypass_sell = sell_score >= 12 and htf_bear and (in_bpr or (in_be_ob and in_be_fvg) or unicorn_bear or mmxm_bear or in_ote_bear or (amd_cycle_bear and in_kill_zone))
// Gold-specific swing bypass — added intraday KZ + vol_ok (was vol_spike)
bool _gold_swing_bypass_buy  = buy_score  >= adaptive_score_swing and htf_bull and ((adx_strong_trend and bull_disp_aligned) or (amd_cycle_bull and judas_bull_active) or (near_poc and new_structure_break and htf_mss_bull) or (strong_daily_bull and in_kill_zone and vol_ok) or (po3_dist_bull and soro_bull) or (in_kill_zone and buy_score >= adaptive_score_intraday and vol_spike))
bool _gold_swing_bypass_sell = sell_score >= adaptive_score_swing and htf_bear and ((adx_strong_trend and bear_disp_aligned) or (amd_cycle_bear and judas_bear_active) or (near_poc and new_structure_break and htf_mss_bear) or (strong_daily_bear and in_kill_zone and vol_ok) or (po3_dist_bear and soro_bear) or (in_kill_zone and sell_score >= adaptive_score_intraday and vol_spike))
// 1-bar confirmation when institutional bypass active (was always 2-bar)
bool swing_buy_confirmed  = swing_buy  and (_swing_buy_consec  >= 2 or unicorn_bull or mmxm_bull or in_bpr or ob_fvg_ce_bull or _swing_inst_bypass_buy  or _gold_swing_bypass_buy or (intraday_buy_professional and in_kill_zone))
bool swing_sell_confirmed = swing_sell and (_swing_sell_consec >= 2 or unicorn_bear or mmxm_bear or in_bpr or ob_fvg_ce_bear or _swing_inst_bypass_sell or _gold_swing_bypass_sell or (intraday_sell_professional and in_kill_zone))
swing_buy  := swing_buy_confirmed  or (swing_buy  and (unicorn_bull or mmxm_bull or ob_fvg_ce_bull or _swing_inst_bypass_buy  or _gold_swing_bypass_buy))
swing_sell := swing_sell_confirmed or (swing_sell and (unicorn_bear or mmxm_bear or ob_fvg_ce_bear or _swing_inst_bypass_sell or _gold_swing_bypass_sell))
intraday_buy  := intraday_buy  and not swing_buy
intraday_sell := intraday_sell and not swing_sell
bool scalp_buy   = filtered_buy_gated  and buy_cooldown_ok  and flip_ok_to_buy  and session_gate and dist_ok_buy  and not swing_buy  and not intraday_buy  and not sniper_buy  and not kz_buy_raw
bool scalp_sell  = filtered_sell_gated and sell_cooldown_ok and flip_ok_to_sell and session_gate and dist_ok_sell and not swing_sell and not intraday_sell and not sniper_sell and not kz_sell_raw

// ════════════════════════════════════════════════════════════════════════════
// SECTION 22 — MODE RESOLVER (DETERMINISTIC PRIORITY CASCADE)
// Priority: SWING > SNIPER > KZ > INTRADAY > SCALP
// ════════════════════════════════════════════════════════════════════════════
bool mode_buy_swing    = swing_buy
bool mode_buy_sniper   = not mode_buy_swing  and sniper_buy
bool mode_buy_kz       = not mode_buy_swing  and not mode_buy_sniper and kz_buy_raw  and buy_cooldown_ok  and flip_ok_to_buy
bool mode_buy_intraday = not mode_buy_swing  and not mode_buy_sniper and not mode_buy_kz and intraday_buy
bool mode_buy_scalp    = not mode_buy_swing  and not mode_buy_sniper and not mode_buy_kz and not mode_buy_intraday and scalp_buy

bool mode_sell_swing    = swing_sell
bool mode_sell_sniper   = not mode_sell_swing and sniper_sell
bool mode_sell_kz       = not mode_sell_swing and not mode_sell_sniper and kz_sell_raw and sell_cooldown_ok and flip_ok_to_sell
bool mode_sell_intraday = not mode_sell_swing and not mode_sell_sniper and not mode_sell_kz and intraday_sell
bool mode_sell_scalp    = not mode_sell_swing and not mode_sell_sniper and not mode_sell_kz and not mode_sell_intraday and scalp_sell

// Entropy gates per tier
bool _entropy_ok_scalp    = not entropy_high and not entropy_critical
bool _entropy_ok_intraday = not entropy_critical

// Upgrade detection (while in trade)
bool _new_signal_worth_showing_buy  = false
bool _new_signal_worth_showing_sell = false
if trade_lockdown
    bool _isu  = active_signal_dir == 1  and swing_buy  and not str.contains(persistent_signal_type,"SWING")
    bool _iss  = active_signal_dir == -1 and swing_sell and not str.contains(persistent_signal_type,"SWING")
    bool _isu2 = active_signal_dir == 1  and intraday_buy  and str.contains(persistent_signal_type,"SCALP")
    bool _iss2 = active_signal_dir == -1 and intraday_sell and str.contains(persistent_signal_type,"SCALP")
    bool _irb  = active_signal_dir == -1 and (buy_score  >= effective_min_score or sniper_raw_buy)  and (buy_score  >= active_signal_score + 3)
    bool _irs  = active_signal_dir == 1  and (sell_score >= effective_min_score or sniper_raw_sell) and (sell_score >= active_signal_score + 3)
    _new_signal_worth_showing_buy  := _isu  or _isu2 or _irb
    _new_signal_worth_showing_sell := _iss  or _iss2 or _irs

// Strong Signal Definitions (V38: loss streak gate added)
bool strong_buy = show_signals and _loss_streak_ok and (
     (mode_buy_scalp and _entropy_ok_scalp) or
     (mode_buy_intraday and _entropy_ok_intraday) or
     mode_buy_swing or mode_buy_sniper or mode_buy_kz) and
     score_ok_buy and anti_trap_buy and conflict_clear_buy and (not trade_lockdown or _new_signal_worth_showing_buy)

bool strong_sell = show_signals and _loss_streak_ok and (
     (mode_sell_scalp and _entropy_ok_scalp) or
     (mode_sell_intraday and _entropy_ok_intraday) or
     mode_sell_swing or mode_sell_sniper or mode_sell_kz) and
     score_ok_sell and anti_trap_sell and conflict_clear_sell and (not trade_lockdown or _new_signal_worth_showing_sell)

// WAIT state — explicit conflict/entropy/environment block
bool wait_signal = show_signals and not trade_lockdown and not strong_buy and not strong_sell and
     (score_conflict_zone or entropy_critical or (conflict and not buy_wins and not sell_wins) or not signal_env_ok)

// Tier classification for dashboard/alerts
bool is_prime_buy  = strong_buy  and mode_buy_swing
bool is_prime_sell = strong_sell and mode_sell_swing
bool is_good_buy   = strong_buy  and (mode_buy_intraday  or mode_buy_sniper)
bool is_good_sell  = strong_sell and (mode_sell_intraday or mode_sell_sniper)
bool is_kz_buy     = strong_buy  and mode_buy_kz
bool is_kz_sell    = strong_sell and mode_sell_kz
bool is_scalp_buy  = strong_buy  and mode_buy_scalp
bool is_scalp_sell = strong_sell and mode_sell_scalp

// ════════════════════════════════════════════════════════════════════════════
// SECTION 23 — TRADE STATE MACHINE
// ════════════════════════════════════════════════════════════════════════════
bool _do_buy  = strong_buy  and (not trade_lockdown or _new_signal_worth_showing_buy)  and barstate.isconfirmed and (not show_only_best or not (any_sell and not strong_buy))
bool _do_sell = strong_sell and (not trade_lockdown or _new_signal_worth_showing_sell) and barstate.isconfirmed and (not show_only_best or not (any_buy  and not strong_sell))

// Reversal detection
bool is_stalling_up = high >= high[1] and close < open
bool is_stalling_dn = low  <= low[1]  and close > open
// GAP-5 FIX: Wick quality added as reversal signal (>60% wick against direction = reversal pressure)
int bear_rev_count  = ((in_be_ob or in_be_fvg) and close<open and rsi_val>65 ? 1 : 0) + (rsi_val>75 ? 1 : 0) + (is_stalling_up and volume>vol_sma*1.5 ? 1 : 0) + (sweep_confirmed_bear ? 1 : 0) + (sfp_bearish and (in_be_ob or in_be_fvg) ? 1 : 0) + (new_structure_break and market==-1 ? 1 : 0) + (blow_off_top ? 1 : 0) + (_cr > 0 and (_uw / _cr > 0.60) and close < open ? 1 : 0)
int bull_rev_count  = ((in_bu_ob or in_bu_fvg) and close>open and rsi_val<35 ? 1 : 0) + (rsi_val<25 ? 1 : 0) + (is_stalling_dn and volume>vol_sma*1.5 ? 1 : 0) + (sweep_confirmed_bull ? 1 : 0) + (sfp_bullish and (in_bu_ob or in_bu_fvg) ? 1 : 0) + (new_structure_break and market==1 ? 1 : 0) + (capitulation_bottom ? 1 : 0) + (_cr > 0 and (_lw / _cr > 0.60) and close > open ? 1 : 0)
bool is_reversal_imminent_bear = bear_rev_count >= 4 or (bear_rev_count >= 3 and turtle_soup_bear and active_signal_dir == 1)
bool is_reversal_imminent_bull = bull_rev_count >= 4 or (bull_rev_count >= 3 and turtle_soup_bull and active_signal_dir == -1)
// EARLY WARNING: 3 factors = reversal caution (pre-alert before full exit)
bool _rev_caution_bear = bear_rev_count == 3 and active_signal_dir == 1  and trade_lockdown
bool _rev_caution_bull = bull_rev_count == 3 and active_signal_dir == -1 and trade_lockdown

// SL / TP hit detection
bool hit_sl = false
bool hit_tp = false
bool close_position_now = false
if trade_lockdown
    hit_sl := frozen_sl > 0 and ((active_signal_dir == 1 and low <= frozen_sl) or (active_signal_dir == -1 and high >= frozen_sl))
    hit_tp := frozen_tp1 > 0 and ((active_signal_dir == 1 and high >= frozen_tp1) or (active_signal_dir == -1 and low <= frozen_tp1))
    close_position_now := (is_reversal_imminent_bear and active_signal_dir == 1) or (is_reversal_imminent_bull and active_signal_dir == -1)

// Fake breakout trap — suppress entry signal
// GAP-3 FIX: Elite score (≥15) or Unicorn/MMXM bypasses trap filter (institutional override)
bool _trap_buy  = _is_fake_bear_bo and not htf_bull and buy_score  < 15 and not unicorn_bull and not mmxm_bull
bool _trap_sell = _is_fake_bull_bo and not htf_bear and sell_score < 15 and not unicorn_bear and not mmxm_bear

if trade_lockdown
    if hit_sl
        persistent_signal_type  := "STOP LOSS HIT [X]"
        persistent_signal_color := color.red
        trade_lockdown          := false
        is_trade_voided         := true
        last_buy_bar            := active_signal_dir == 1  ? bar_index : last_buy_bar
        last_sell_bar           := active_signal_dir == -1 ? bar_index : last_sell_bar
        _consec_losses          := _consec_losses + 1
        if _outcome_pending
            array.push(_signal_outcomes, 0.0)
            if array.size(_signal_outcomes) > _outcome_max
                array.shift(_signal_outcomes)
            _outcome_pending := false
    else if hit_tp
        persistent_signal_type  := "TAKE PROFIT HIT [✓]"
        persistent_signal_color := color.lime
        _consec_losses := 0
        if _outcome_pending
            array.push(_signal_outcomes, 1.0)
            if array.size(_signal_outcomes) > _outcome_max
                array.shift(_signal_outcomes)
            _outcome_pending := false
    else if close_position_now and not is_trade_voided
        persistent_signal_type  := "⚠ REVERSAL EXIT [" + str.tostring(math.max(bear_rev_count, bull_rev_count)) + "/8]"
        persistent_signal_color := color.new(color.orange, 20)
        trade_lockdown          := false
        is_trade_voided         := true
        if _outcome_pending
            float _exit_r = frozen_risk > 0 ? (close - frozen_ep) / frozen_risk * float(active_signal_dir) : 0.0
            array.push(_signal_outcomes, _exit_r > 0 ? 1.0 : 0.0)
            if array.size(_signal_outcomes) > _outcome_max
                array.shift(_signal_outcomes)
            _outcome_pending := false
        if active_signal_dir == 1 ? close < frozen_ep : close > frozen_ep
            _consec_losses := _consec_losses + 1
        else
            _consec_losses := 0
    else if (bar_index - last_signal_bar_any) > (active_signal_dir != 0 and str.contains(persistent_signal_type,"SWING") ? 60 : str.contains(persistent_signal_type,"INTRADAY") ? 30 : 15)
        persistent_signal_type  := "EXPIRED [T]"
        persistent_signal_color := color.orange
        trade_lockdown          := false
        is_trade_voided         := true
        // V32-FIX-10: Expired = not a clear win — record as neutral loss for conservatism
        if _outcome_pending
            array.push(_signal_outcomes, 0.0)
            if array.size(_signal_outcomes) > _outcome_max
                array.shift(_signal_outcomes)
            _outcome_pending := false
    if manual_reset
        trade_lockdown  := false
        frozen_ep       := 0.0
        frozen_sl       := 0.0
        frozen_tp1      := 0.0
        frozen_tp2      := 0.0
        frozen_tp3      := 0.0
        frozen_risk     := 0.0
        last_signal_bar_any := bar_index - 100
        _outcome_pending := false

// V32-FIX-10: Compute live win rate from outcome array
if array.size(_signal_outcomes) >= 5
    float _wins = 0.0
    for _oi = 0 to array.size(_signal_outcomes) - 1
        _wins += array.get(_signal_outcomes, _oi)
    _live_winrate := _wins / float(array.size(_signal_outcomes)) * 100.0
else
    _live_winrate := na

// BUG-05 FIXED: min SL distance computed once before signal fire blocks
float _min_sl_dist_val = min_sl_pips * syminfo.mintick * 10.0
// Sniper entry point
_fvg_mid_buy  := array.size(bu_fvg_boxes) > 0 ? (box.get_top(array.get(bu_fvg_boxes, array.size(bu_fvg_boxes)-1)) + box.get_bottom(array.get(bu_fvg_boxes, array.size(bu_fvg_boxes)-1))) / 2 : close
_fvg_mid_sell := array.size(be_fvg_boxes) > 0 ? (box.get_top(array.get(be_fvg_boxes, array.size(be_fvg_boxes)-1)) + box.get_bottom(array.get(be_fvg_boxes, array.size(be_fvg_boxes)-1))) / 2 : close

if _do_buy and not _trap_buy
    last_buy_bar            := bar_index
    last_signal_was_buy     := true
    string _buy_tier = mode_buy_swing ? "🔵 SWING BUY" : mode_buy_sniper ? "🎯 SNIPER BUY" : mode_buy_kz ? "🎯 KZ BUY" : mode_buy_intraday ? "INTRADAY BUY" : "SCALP BUY"
    persistent_signal_type  := _buy_tier
    persistent_signal_color := mode_buy_sniper ? color.fuchsia : mode_buy_kz ? color.yellow : mode_buy_swing ? color.blue : mode_buy_intraday ? color.lime : color.green
    last_signal_bar_any     := bar_index
    active_signal_dir       := 1
    active_signal_prob      := math.max(50.0, math.min(capped_prob_buy, 92.0))
    active_signal_score     := buy_score
    trade_lockdown          := true
    is_trade_voided         := false
    tp1_already_reached     := false
    float _freeze_buy_ep  = mode_buy_sniper ? (ce_sniper_buy ? fvg_ce_bull : rb_sniper_buy ? nz(ob_mt_bull,close) : valid_breakout_buy ? close : valid_rejection_buy ? close : _fvg_mid_buy) : buy_ep
    float _freeze_buy_sl  = math.min(math.max(buy_sl, _freeze_buy_ep - atr_val*5.0), _freeze_buy_ep - atr_val*1.0)
    _freeze_buy_sl        := math.max(_freeze_buy_sl, _freeze_buy_ep - _freeze_buy_ep*0.02)
    // V32-FIX-05 / BUG-05 FIXED: reuse pre-computed _min_sl_dist_val
    float _min_sl_buy      = _freeze_buy_ep - _min_sl_dist_val
    _freeze_buy_sl        := math.min(_freeze_buy_sl, _min_sl_buy)  // SL must be at least min_sl_pips below EP
    frozen_ep             := _freeze_buy_ep
    frozen_sl             := _freeze_buy_sl
    frozen_tp1            := buy_tp1
    frozen_tp2            := buy_tp2
    frozen_tp3            := buy_tp3
    frozen_risk           := math.min(math.max(math.abs(frozen_sl - frozen_ep), atr_val * 1.0), atr_val * 6.0)
    // V32-FIX-01: Compute lot size at signal fire
    _computed_lot_size    := frozen_risk > 0 ? math.max(0.01, math.round((account_balance * risk_pct / 100.0) / (frozen_risk * gold_pip_value * 100.0) * 100.0) / 100.0) : 0.0
    // V32-FIX-10: Register pending outcome for tracker
    _pending_outcome_dir  := 1
    _pending_outcome_ep   := _freeze_buy_ep
    _pending_outcome_sl   := _freeze_buy_sl
    _pending_outcome_tp1  := buy_tp1
    _outcome_pending      := true
    _total_signals        := _total_signals + 1

if _do_sell and not _trap_sell
    last_sell_bar           := bar_index
    last_signal_was_buy     := false
    string _sell_tier = mode_sell_swing ? "🔴 SWING SELL" : mode_sell_sniper ? "🎯 SNIPER SELL" : mode_sell_kz ? "🎯 KZ SELL" : mode_sell_intraday ? "INTRADAY SELL" : "SCALP SELL"
    persistent_signal_type  := _sell_tier
    persistent_signal_color := mode_sell_sniper ? color.fuchsia : mode_sell_kz ? color.yellow : mode_sell_swing ? color.red : mode_sell_intraday ? color.red : color.orange
    last_signal_bar_any     := bar_index
    active_signal_dir       := -1
    active_signal_prob      := math.max(50.0, math.min(capped_prob_sell, 92.0))
    active_signal_score     := sell_score
    trade_lockdown          := true
    is_trade_voided         := false
    tp1_already_reached     := false
    float _freeze_sell_ep  = mode_sell_sniper ? (ce_sniper_sell ? fvg_ce_bear : rb_sniper_sell ? nz(ob_mt_bear,close) : valid_breakout_sell ? close : valid_rejection_sell ? close : _fvg_mid_sell) : sell_ep
    float _freeze_sell_sl  = math.max(math.min(sell_sl, _freeze_sell_ep + atr_val*5.0), _freeze_sell_ep + atr_val*1.0)
    _freeze_sell_sl        := math.min(_freeze_sell_sl, _freeze_sell_ep + _freeze_sell_ep*0.02)
    // V32-FIX-05 / BUG-05 FIXED: reuse pre-computed _min_sl_dist_val
    float _min_sl_sell      = _freeze_sell_ep + _min_sl_dist_val
    _freeze_sell_sl        := math.max(_freeze_sell_sl, _min_sl_sell)
    frozen_ep              := _freeze_sell_ep
    frozen_sl              := _freeze_sell_sl
    frozen_tp1             := sell_tp1
    frozen_tp2             := sell_tp2
    frozen_tp3             := sell_tp3
    frozen_risk            := math.min(math.max(math.abs(frozen_sl - frozen_ep), atr_val * 1.0), atr_val * 6.0)
    // V32-FIX-01: Compute lot size at signal fire
    _computed_lot_size     := frozen_risk > 0 ? math.max(0.01, math.round((account_balance * risk_pct / 100.0) / (frozen_risk * gold_pip_value * 100.0) * 100.0) / 100.0) : 0.0
    // V32-FIX-10: Register pending outcome for tracker
    _pending_outcome_dir   := -1
    _pending_outcome_ep    := _freeze_sell_ep
    _pending_outcome_sl    := _freeze_sell_sl
    _pending_outcome_tp1   := sell_tp1
    _outcome_pending       := true
    _total_signals         := _total_signals + 1

// Signal persistence
int max_persist_bars = str.contains(persistent_signal_type,"SWING") ? 60 : str.contains(persistent_signal_type,"INTRADAY") ? 30 : 15
bool signal_recent   = trade_lockdown or (bar_index - last_signal_bar_any) <= max_persist_bars
if not signal_recent and not trade_lockdown
    persistent_signal_type  := "No Signal"
    persistent_signal_color := color.gray
    active_signal_dir       := 0
    active_signal_prob      := 0.0
    active_signal_score     := 0

// TP1 label
bool _at_tp1_now = not tp1_already_reached and ((active_signal_dir==1 and high>=frozen_tp1*0.999) or (active_signal_dir==-1 and low<=frozen_tp1*1.001))
if barstate.isconfirmed and trade_lockdown and _at_tp1_now
    tp1_already_reached := true
    label.new(bar_index, active_signal_dir==1 ? high+atr_val*0.6 : low-atr_val*0.6, "[TP] TP1 REACHED\nTake 50% Profit", style=active_signal_dir==1 ? label.style_label_down : label.style_label_up, color=color.new(color.lime,20), textcolor=color.white, size=size.small)
    last_trade_tag_bar := bar_index

// SL/TP/BE trade tags (every 20 bars)
if barstate.isconfirmed and trade_lockdown and active_signal_dir != 0 and (bar_index - last_trade_tag_bar) >= 20
    float _rr_now = frozen_risk > 0 ? math.abs(close - frozen_ep) / frozen_risk : 0
    bool  _in_pft = (active_signal_dir==1 and close>frozen_ep) or (active_signal_dir==-1 and close<frozen_ep)
    bool  _be_ok  = frozen_sl == frozen_ep
    if close_position_now
        label.new(bar_index, active_signal_dir==1 ? high+atr_val*0.6 : low-atr_val*0.6, "[!] EXIT NOW\nReversal Imminent", style=active_signal_dir==1 ? label.style_label_down : label.style_label_up, color=color.new(color.orange,20), textcolor=color.white, size=size.small)
        last_trade_tag_bar := bar_index
    else if not _be_ok and _rr_now >= 1.0 and _in_pft
        label.new(bar_index, active_signal_dir==1 ? high+atr_val*0.5 : low-atr_val*0.5, "✓ 1:1 — Move SL to BE", style=active_signal_dir==1 ? label.style_label_down : label.style_label_up, color=color.new(color.aqua,30), textcolor=color.white, size=size.tiny)
        last_trade_tag_bar := bar_index
    else if _be_ok and _in_pft and _rr_now >= 1.5
        label.new(bar_index, active_signal_dir==1 ? high+atr_val*0.5 : low-atr_val*0.5, "→ 1.5R — Trail Stop", style=active_signal_dir==1 ? label.style_label_down : label.style_label_up, color=color.new(color.aqua,20), textcolor=color.white, size=size.tiny)
        last_trade_tag_bar := bar_index

// Exit labels (full reversal)
if barstate.isconfirmed and (bar_index - last_exit_label_bar) >= 3
    if is_reversal_imminent_bear and trade_lockdown and active_signal_dir == 1
        label.new(bar_index, high+atr_val*0.6, "🚨 EXIT BUY NOW\nReversal " + str.tostring(bear_rev_count) + "/6  [BEAR SIGNALS STACKING]", style=label.style_label_down, color=color.new(color.red,10), textcolor=color.white, size=size.small)
        last_exit_label_bar := bar_index
    if is_reversal_imminent_bull and trade_lockdown and active_signal_dir == -1
        label.new(bar_index, low-atr_val*0.6, "🚨 EXIT SELL NOW\nReversal " + str.tostring(bull_rev_count) + "/6  [BULL SIGNALS STACKING]", style=label.style_label_up, color=color.new(color.lime,10), textcolor=color.black, size=size.small)
        last_exit_label_bar := bar_index
    // EARLY caution — 3 factors: pre-alert before full exit
    else if _rev_caution_bear and not is_reversal_imminent_bear and (bar_index - last_exit_label_bar) >= 5
        label.new(bar_index, high+atr_val*0.4, "⚠ REVERSAL CAUTION\nConsider trailing SL  [" + str.tostring(bear_rev_count) + "/6]", style=label.style_label_down, color=color.new(color.orange,40), textcolor=color.white, size=size.tiny)
        last_exit_label_bar := bar_index
    else if _rev_caution_bull and not is_reversal_imminent_bull and (bar_index - last_exit_label_bar) >= 5
        label.new(bar_index, low-atr_val*0.4, "⚠ REVERSAL CAUTION\nConsider trailing SL  [" + str.tostring(bull_rev_count) + "/6]", style=label.style_label_up, color=color.new(color.orange,40), textcolor=color.black, size=size.tiny)
        last_exit_label_bar := bar_index

// Main signal labels
if _do_buy and not _trap_buy
    float _lbl_y = low - atr_val * 1.2
    if not na(_last_buy_label_y) and math.abs(_lbl_y - _last_buy_label_y) < atr_val*0.5 and (bar_index - _last_buy_lbl_bar) < 3
        _lbl_y := _last_buy_label_y - atr_val*0.5
    // ── AGENTIC SIGNAL INTELLIGENCE ─────────────────────────────────────
    // Session + Kill Zone context
    string _sess_ctx  = in_kill_zone ? ("⚡ " + kill_zone_name + " KZ") : in_prime_session ? "✅ Prime Session" : in_asian_session ? "🌙 Asian" : "⚪ Off-Session"
    // Confluence stack — all active factors that fired this signal
    string _c1 = (in_bu_ob      ? "OB " : "") + (in_bu_fvg     ? "FVG " : "") + (in_ote_bull   ? "OTE " : "")
    string _c2 = (htf_bull      ? "HTF✓ " : "HTF~ ") + (bull_bias     ? "BIAS✓ " : "") + (vol_spike    ? "VOL⬆ " : vol_ok ? "VOL✓ " : "")
    string _c3 = (unicorn_bull  ? "🦄UNICORN " : "") + (mmxm_bull    ? "MMXM " : "") + (ob_fvg_ce_bull ? "OB+FVG+CE " : "")
    string _c4 = (judas_bull_active ? "JUDAS✓ " : "") + (sfp_bullish  ? "SFP " : "") + (sweep_confirmed_bull ? "SWEEP✓ " : "")
    string _c5 = (amd_cycle_bull ? "AMD✓ " : "") + (po3_dist_bull ? "PO3✓ " : "") + (soro_bull    ? "SORO " : "")
    string _c6 = (anchored_vwap_bull ? "AVWAP✓ " : "") + (near_poc    ? "POC✓ " : "") + (in_bpr       ? "BPR " : "")
    string _c7 = (internal_bull_choch ? "MSS✓ " : internal_bull_bos ? "BoS✓ " : "") + (bullish_divergence ? "DIV✓ " : "") + (_sb_fvg_bull ? "SB+FVG✓ " : "")
    string _c8 = (_asian_sw_ldn_bull ? "ASIA→LDN✓ " : "") + (_in_ny_macro ? "MACRO✓ " : "") + (_inst_del_bull ? "DELIV✓ " : "") + (score_bull_surging ? "SURGE✓ " : "")
    string _confluence = str.replace_all(_c1 + _c2 + _c3 + _c4 + _c5 + _c6 + _c7 + _c8, "  ", " ")
    // Trap status
    string _trap_st   = anti_trap_buy and not _bull_trap ? "✅ No Trap" : "⚠ TRAP CHECK"
    // RR info
    float  _rr_actual = frozen_risk > 0 ? (frozen_tp1 - frozen_ep) / frozen_risk : rr_scalp
    string _rr_str    = str.tostring(_rr_actual, "#.#") + "R"
    // Lot size
    string _lot_str   = str.tostring(_computed_lot_size, "#.##") + " lot"
    // Full agentic label
    string _s1 = persistent_signal_type + "  |  Score: " + str.tostring(display_buy_score) + "/" + str.tostring(score_max_display) + "  " + str.tostring(capped_prob_buy, "#") + "% [" + confidence_label_buy + "]"
    string _s2 = "\nEP: " + str.tostring(frozen_ep, "#.##") + "  |  SL: " + str.tostring(frozen_sl, "#.##") + "  |  RR: " + _rr_str + "  |  " + _lot_str
    string _s3 = "\nTP1: " + str.tostring(frozen_tp1, "#.##") + "  TP2: " + str.tostring(frozen_tp2, "#.##") + "  TP3: " + str.tostring(frozen_tp3, "#.##")
    string _s4 = "\n" + _sess_ctx + "  |  " + _trap_st
    string _s5 = "\n⚡ " + (str.length(_confluence) > 2 ? _confluence : "Score-Based Entry")
    label _lbl = label.new(bar_index, _lbl_y, _s1 + _s2 + _s3 + _s4 + _s5, style=label.style_label_up, color=persistent_signal_color, textcolor=color.white, size=text_size)
    array.push(buy_labels, _lbl)
    if array.size(buy_labels) > max_labels_per_side
        label.delete(array.shift(buy_labels))
    _last_buy_label_y  := _lbl_y
    _last_buy_lbl_bar  := bar_index

if _do_sell and not _trap_sell
    float _lbl_y = high + atr_val * 1.2
    if not na(_last_sell_label_y) and math.abs(_lbl_y - _last_sell_label_y) < atr_val*0.5 and (bar_index - _last_sell_lbl_bar) < 3
        _lbl_y := _last_sell_label_y + atr_val*0.5
    // ── AGENTIC SIGNAL INTELLIGENCE ─────────────────────────────────────
    string _sess_ctx  = in_kill_zone ? ("⚡ " + kill_zone_name + " KZ") : in_prime_session ? "✅ Prime Session" : in_asian_session ? "🌙 Asian" : "⚪ Off-Session"
    string _c1 = (in_be_ob      ? "OB " : "") + (in_be_fvg     ? "FVG " : "") + (in_ote_bear   ? "OTE " : "")
    string _c2 = (htf_bear      ? "HTF✓ " : "HTF~ ") + (bear_bias     ? "BIAS✓ " : "") + (vol_spike    ? "VOL⬆ " : vol_ok ? "VOL✓ " : "")
    string _c3 = (unicorn_bear  ? "🦄UNICORN " : "") + (mmxm_bear    ? "MMXM " : "") + (ob_fvg_ce_bear ? "OB+FVG+CE " : "")
    string _c4 = (judas_bear_active ? "JUDAS✓ " : "") + (sfp_bearish  ? "SFP " : "") + (sweep_confirmed_bear ? "SWEEP✓ " : "")
    string _c5 = (amd_cycle_bear ? "AMD✓ " : "") + (po3_dist_bear ? "PO3✓ " : "") + (soro_bear    ? "SORO " : "")
    string _c6 = (anchored_vwap_bear ? "AVWAP✓ " : "") + (near_poc    ? "POC✓ " : "") + (in_bpr       ? "BPR " : "")
    string _c7 = (internal_bear_choch ? "MSS✓ " : internal_bear_bos ? "BoS✓ " : "") + (bearish_divergence ? "DIV✓ " : "") + (_sb_fvg_bear ? "SB+FVG✓ " : "")
    string _c8 = (_asian_sw_ldn_bear ? "ASIA→LDN✓ " : "") + (_in_ny_macro ? "MACRO✓ " : "") + (_inst_del_bear ? "DELIV✓ " : "") + (score_bear_surging ? "SURGE✓ " : "")
    string _confluence = str.replace_all(_c1 + _c2 + _c3 + _c4 + _c5 + _c6 + _c7 + _c8, "  ", " ")
    string _trap_st   = anti_trap_sell and not _bear_trap ? "✅ No Trap" : "⚠ TRAP CHECK"
    float  _rr_actual = frozen_risk > 0 ? (frozen_ep - frozen_tp1) / frozen_risk : rr_scalp
    string _rr_str    = str.tostring(_rr_actual, "#.#") + "R"
    string _lot_str   = str.tostring(_computed_lot_size, "#.##") + " lot"
    string _s1 = persistent_signal_type + "  |  Score: " + str.tostring(display_sell_score) + "/" + str.tostring(score_max_display) + "  " + str.tostring(capped_prob_sell, "#") + "% [" + confidence_label_sell + "]"
    string _s2 = "\nEP: " + str.tostring(frozen_ep, "#.##") + "  |  SL: " + str.tostring(frozen_sl, "#.##") + "  |  RR: " + _rr_str + "  |  " + _lot_str
    string _s3 = "\nTP1: " + str.tostring(frozen_tp1, "#.##") + "  TP2: " + str.tostring(frozen_tp2, "#.##") + "  TP3: " + str.tostring(frozen_tp3, "#.##")
    string _s4 = "\n" + _sess_ctx + "  |  " + _trap_st
    string _s5 = "\n⚡ " + (str.length(_confluence) > 2 ? _confluence : "Score-Based Entry")
    label _lbl = label.new(bar_index, _lbl_y, _s1 + _s2 + _s3 + _s4 + _s5, style=label.style_label_down, color=persistent_signal_color, textcolor=color.white, size=text_size)
    array.push(sell_labels, _lbl)
    if array.size(sell_labels) > max_labels_per_side
        label.delete(array.shift(sell_labels))
    _last_sell_label_y := _lbl_y
    _last_sell_lbl_bar := bar_index

// WAIT label
if wait_signal and not wait_signal[1] and barstate.isconfirmed
    label.new(bar_index, high + atr_val*0.5, "⏸ WAIT\n" + (entropy_critical ? "Entropy!" : score_conflict_zone ? "Conflict" : "Env"), style=label.style_label_down, color=color.new(color.gray,60), textcolor=color.yellow, size=size.tiny)

// SL Hit / TP Hit markers
if barstate.isconfirmed and hit_sl and trade_lockdown
    label.new(bar_index, active_signal_dir==1 ? low-atr_val*0.5 : high+atr_val*0.5, "✕ SL", style=active_signal_dir==1 ? label.style_label_up : label.style_label_down, color=color.new(color.red,20), textcolor=color.white, size=size.small)
if barstate.isconfirmed and hit_tp and not tp1_already_reached
    label.new(bar_index, active_signal_dir==1 ? high+atr_val*0.5 : low-atr_val*0.5, "✓ TP", style=active_signal_dir==1 ? label.style_label_down : label.style_label_up, color=color.new(color.lime,20), textcolor=color.white, size=size.small)

// S/R Plots (Enhanced Scale Safety)
float _sr_limit  = close * 0.005  // 0.5% max distance for S/R
float _plt_limit = close * 0.01   // 1.0% max distance for other lines
plot(show_sr and not na(last_support)    and math.abs(close-last_support)    < _sr_limit ? last_support    : na, "Support",    color=color.new(color.green,0), style=plot.style_linebr, linewidth=2)
plot(show_sr and not na(last_resistance) and math.abs(close-last_resistance) < _sr_limit ? last_resistance : na, "Resistance", color=color.new(color.red,0),   style=plot.style_linebr, linewidth=2)
plot(not na(pdh) and math.abs(close-pdh) < _plt_limit ? pdh : na, "PDH", color=color.new(#FF5252,50), style=plot.style_linebr, linewidth=1)
plot(not na(pdl) and math.abs(close-pdl) < _plt_limit ? pdl : na, "PDL", color=color.new(#00BFA5,50), style=plot.style_linebr, linewidth=1)
float _mid_line = not na(h0) and not na(l0) ? (h0+l0)/2.0 : na
plot(not na(_mid_line) and math.abs(close-_mid_line) < _plt_limit ? _mid_line : na, "Range Mid", color=color.new(color.white,75), style=plot.style_linebr, linewidth=1)
plot(show_vwap and math.abs(close-vwap_val) < _plt_limit ? vwap_val : na, "VWAP", color=color.orange, linewidth=1)
plot(show_ema  and math.abs(close-ema_fast) < _plt_limit ? ema_fast : na, "EMA Fast", color=color.new(color.aqua,30),   linewidth=1)  // BUG-09 FIXED: was commented out
plot(show_ema  and math.abs(close-ema_slow) < _plt_limit ? ema_slow : na, "EMA Slow", color=color.new(color.orange,30), linewidth=2)
float _atzone = htf_bull ? nearest_bu_zone : nearest_be_zone
plot(show_target_zone and not na(_atzone) and math.abs(close-_atzone) < _plt_limit ? _atzone : na, "Target Zone", color=htf_bull ? color.new(color.lime,40) : color.new(color.red,40), style=plot.style_linebr, linewidth=1)

// Frozen trade levels (Scale-Guarded)
plot(trade_lockdown and frozen_ep   > 0 and math.abs(close-frozen_ep)   < _plt_limit ? frozen_ep   : na, "Entry",   color=color.new(color.white,30),  style=plot.style_linebr, linewidth=1)
plot(trade_lockdown and frozen_sl   > 0 and math.abs(close-frozen_sl)   < _plt_limit ? frozen_sl   : na, "SL Line", color=color.new(color.red,30),    style=plot.style_linebr, linewidth=2)
plot(trade_lockdown and frozen_tp1  > 0 and math.abs(close-frozen_tp1)  < _plt_limit ? frozen_tp1  : na, "TP1",     color=color.new(color.lime,40),   style=plot.style_linebr, linewidth=1)
plot(trade_lockdown and frozen_tp2  > 0 and math.abs(close-frozen_tp2)  < _plt_limit ? frozen_tp2  : na, "TP2",     color=color.new(color.lime,60),   style=plot.style_linebr, linewidth=1)
plot(trade_lockdown and frozen_tp3  > 0 and math.abs(close-frozen_tp3)  < _plt_limit ? frozen_tp3  : na, "TP3 Fib", color=color.new(color.aqua,60),   style=plot.style_linebr, linewidth=1)

// ════════════════════════════════════════════════════════════════════════════
// SECTION 24 — DASHBOARD (5 SUB-FUNCTIONS, NO ROW COLLISION)
// ════════════════════════════════════════════════════════════════════════════
if barstate.islast and show_dashboard and dash_display_mode != "Hidden"
    if na(dashboard)
        dashboard := table.new(dash_position, 2, 51, border_width=1, border_color=color.new(color.gray,70), frame_color=color.new(color.gray,70), frame_width=1)


// -- Dashboard Helper Functions (Token Reduction) ---------
f_tc0(int r, string t) => table.cell(dashboard, 0, r, t, text_color=color.white, text_size=size.tiny)
f_tc1(int r, string t, color c) => table.cell(dashboard, 1, r, t, text_color=c, text_size=size.tiny)

f_dash_context() =>
    if not na(dashboard)
        table.cell(dashboard, 0, 0, "MA-Gold v38 PRO+", text_color=color.white, text_size=size.small, bgcolor=color.new(#0D47A1,10))
        table.cell(dashboard, 1, 0, syminfo.ticker + " | " + timeframe.period + "m", text_color=color.yellow, text_size=size.small, bgcolor=color.new(#0D47A1,10))
        table.cell(dashboard, 0, 1, "HTF Bias", text_color=color.white, text_size=size.tiny, bgcolor=color.new(#1a237e,30))
        table.cell(dashboard, 1, 1, htf_bull ? "BULLISH ↑" : htf_bear ? "BEARISH ↓" : "NEUTRAL", text_color=htf_bull ? color.lime : htf_bear ? color.red : color.gray, text_size=size.tiny, bgcolor=color.new(#1a237e,30))
        f_tc0(2, "HTF Strength")
        f_tc1(2, str.tostring(htf_bias_strength) + "/4 " + (htf_bias_strength >= 3 ? "★★★" : htf_bias_strength >= 2 ? "★★" : "★"), htf_bias_strength >= 3 ? color.lime : color.orange)
        f_tc0(3, "Session")
        f_tc1(3, in_kill_zone ? "🎯 " + kill_zone_name : in_asian_session ? "Asia" : in_london_session ? "London" : in_ny_session ? "NY" : "Off-Session", in_kill_zone ? color.yellow : color.white)
        f_tc0(4, "Market Regime")
        f_tc1(4, adx_strong_trend ? "Strong Trend" : adx_trending ? "Trending" : adx_ranging ? "Ranging" : "Normal", adx_strong_trend ? color.lime : adx_ranging ? color.orange : color.white)
        f_tc0(5, "Volatility")
        f_tc1(5, extreme_volatility ? "⚠ EXTREME" : normal_volatility ? "Normal" : "Elevated", extreme_volatility ? color.red : color.white)
        f_tc0(6, "Entropy")
        f_tc1(6, entropy_critical ? "🔴 CRITICAL" : entropy_high ? "🟡 HIGH" : "✓ Clear", entropy_critical ? color.red : entropy_high ? color.yellow : color.lime)
        f_tc0(7, "DXY")
        f_tc1(7, dxy_bullish ? "Bullish (Bear Gold)" : dxy_bearish ? "Bearish (Bull Gold)" : "Neutral", dxy_bearish ? color.lime : dxy_bullish ? color.red : color.white)
        f_tc0(8, "Macro Bias")
        f_tc1(8, macro_bull_aligned ? "BULL (W+M aligned)" : macro_bear_aligned ? "BEAR (W+M aligned)" : "Mixed", macro_bull_aligned ? color.lime : macro_bear_aligned ? color.red : color.gray)

f_dash_signals() =>
    if not na(dashboard)
        color _bc = capped_prob_buy  >= 80 ? color.lime : capped_prob_buy  >= 70 ? color.new(color.lime,30) : color.gray
        color _sc = capped_prob_sell >= 80 ? color.red  : capped_prob_sell >= 70 ? color.new(color.red,30)  : color.gray
        table.cell(dashboard, 0,  9, "BUY Score", text_color=color.white, text_size=size.tiny, bgcolor=color.new(#1B5E20,20))
        table.cell(dashboard, 1,  9, str.tostring(display_buy_score) + "/" + str.tostring(score_max_display) + " | " + str.tostring(capped_prob_buy,"#") + "% [" + confidence_label_buy + "]", text_color=_bc, text_size=size.tiny, bgcolor=color.new(#1B5E20,20))
        table.cell(dashboard, 0, 10, "SELL Score", text_color=color.white, text_size=size.tiny, bgcolor=color.new(#B71C1C,20))
        table.cell(dashboard, 1, 10, str.tostring(display_sell_score) + "/" + str.tostring(score_max_display) + " | " + str.tostring(capped_prob_sell,"#") + "% [" + confidence_label_sell + "]", text_color=_sc, text_size=size.tiny, bgcolor=color.new(#B71C1C,20))
        f_tc0(11, "Active Signal")
        f_tc1(11, persistent_signal_type, persistent_signal_color)
        f_tc0(12, "Signal Tier")
        string _tier_txt = is_prime_buy or is_prime_sell ? "🔵 SWING" : is_good_buy or is_good_sell ? "🎯 SNIPER/INTRADAY" : is_kz_buy or is_kz_sell ? "⚡ KILL ZONE" : is_scalp_buy or is_scalp_sell ? "SCALP" : wait_signal ? "⏸ WAIT" : "—"
        color  _tier_clr = is_prime_buy or is_prime_sell ? color.blue : is_good_buy or is_good_sell ? color.fuchsia : is_kz_buy or is_kz_sell ? color.yellow : is_scalp_buy or is_scalp_sell ? color.orange : wait_signal ? color.gray : color.white
        f_tc1(12, _tier_txt, _tier_clr)
        f_tc0(13, "Win Prob Δ")
        float _prob_edge = math.abs(capped_prob_buy - capped_prob_sell)
        string _edge_txt = str.tostring(_prob_edge,"#.#") + "% " + (capped_prob_buy > capped_prob_sell ? "→ BUY edge" : capped_prob_sell > capped_prob_buy ? "→ SELL edge" : "→ TIED")
        color  _edge_clr = _prob_edge >= 8 ? color.lime : _prob_edge >= 4 ? color.yellow : color.gray
        f_tc1(13, _edge_txt, _edge_clr)
        f_tc0(14, "Pre-Signal")
        string _ps_txt = _presig_imminent_buy or _presig_imminent_sell ? "🔔 IMMINENT" : _presig_lvl2_buy or _presig_lvl2_sell ? "🟡 READY" : _presig_building_buy or _presig_building_sell ? "🔵 BUILDING" : "—"
        color  _ps_clr = _presig_imminent_buy or _presig_imminent_sell ? color.yellow : _presig_lvl2_buy or _presig_lvl2_sell ? color.orange : _presig_building_buy or _presig_building_sell ? color.aqua : color.gray
        f_tc1(14, _ps_txt, _ps_clr)
        f_tc0(15, "Conflict Zone")
        f_tc1(15, score_conflict_zone ? "⚠ SCORES TIED" : "✓ Clear", score_conflict_zone ? color.orange : color.lime)
        f_tc0(16, "Trap Guard")
        string _trap_txt = (_is_fake_bull_bo or _is_fake_bear_bo) ? "⚠ FAKE BREAKOUT" : "✓ No Trap"
        f_tc1(16, _trap_txt, (_is_fake_bull_bo or _is_fake_bear_bo) ? color.red : color.lime)
        f_tc0(17, "Score Velocity")
        string _vel_txt = score_bull_surging ? "▲▲▲ SURGING BUY" : score_bear_surging ? "▼▼▼ SURGING SELL" : score_bull_accelerating ? "▲▲ ACCEL BUY" : score_bear_accelerating ? "▼▼ ACCEL SELL" : score_bull_rising ? "▲ RISING BUY" : score_bear_rising ? "▼ RISING SELL" : "Flat"
        color  _vel_clr = score_bull_surging or score_bull_accelerating or score_bull_rising ? color.lime : score_bear_surging or score_bear_accelerating or score_bear_rising ? color.red : color.gray
        f_tc1(17, _vel_txt, _vel_clr)
        table.cell(dashboard, 0, 18, "──────────", text_color=color.new(color.gray,60), text_size=size.tiny)
        f_tc1(18, "ZONE ANALYSIS", color.new(color.gray,20))

f_dash_zones() =>
    if not na(dashboard)
        // Bull zones
        string _buz = (in_bu_ob ? "OB+" : "") + (in_bu_fvg ? " FVG+" : "") + (in_ote_bull ? " OTE" : "") + (in_bpr and htf_bull ? " BPR" : "") + (in_bull_breaker ? " BRK" : "")
        string _bez = (in_be_ob ? "OB-" : "") + (in_be_fvg ? " FVG-" : "") + (in_ote_bear ? " OTE" : "") + (in_bpr and htf_bear ? " BPR" : "") + (in_bear_breaker ? " BRK" : "")
        f_tc0(19, "Bull Zones")
        f_tc1(19, str.length(_buz) > 1 ? _buz : "—", str.length(_buz) > 1 ? color.new(#00BFA5,20) : color.gray)
        f_tc0(20, "Bear Zones")
        f_tc1(20, str.length(_bez) > 1 ? _bez : "—", str.length(_bez) > 1 ? color.new(#FF5252,20) : color.gray)
        // FVG CE / OB midpoint
        f_tc0(21, "FVG CE Bull")
        f_tc1(21, at_fvg_ce_bull ? "✦ AT CE " + str.tostring(nz(fvg_ce_bull,0),"#.##") : not na(fvg_ce_bull) ? str.tostring(nz(fvg_ce_bull,0),"#.##") : "—", at_fvg_ce_bull ? color.lime : color.gray)
        f_tc0(22, "FVG CE Bear")
        f_tc1(22, at_fvg_ce_bear ? "✦ AT CE " + str.tostring(nz(fvg_ce_bear,0),"#.##") : not na(fvg_ce_bear) ? str.tostring(nz(fvg_ce_bear,0),"#.##") : "—", at_fvg_ce_bear ? color.red : color.gray)
        // POC / VA
        f_tc0(23, "POC / VA")
        string _poc_txt = not na(vp_poc_level) ? str.tostring(vp_poc_level,"#.##") + (near_poc ? " ← NEAR" : "") : "Calculating..."
        f_tc1(23, _poc_txt, near_poc ? color.yellow : color.white)
        // VWAP position
        f_tc0(24, "VWAP")
        string _vwap_txt = str.tostring(vwap_val,"#.##") + (is_overbought_vwap ? " ⚠+2σ" : is_oversold_vwap ? " ⚠-2σ" : close > vwap_val ? " ↑" : " ↓")
        color  _vwap_clr = is_overbought_vwap or is_oversold_vwap ? color.orange : close > vwap_val ? color.lime : color.red
        f_tc1(24, _vwap_txt, _vwap_clr)
        // Premium / Discount
        f_tc0(25, "Price Range")
        string _pd_txt = in_ote_bull ? "OTE (61.8-78.6%)" : in_ote_bear ? "OTE (61.8-78.6%)" : in_discount ? "DISCOUNT (Buy)" : in_premium ? "PREMIUM (Sell)" : "Equilibrium"
        color  _pd_clr = in_ote_bull or in_discount ? color.lime : in_ote_bear or in_premium ? color.red : color.gray
        f_tc1(25, _pd_txt, _pd_clr)
        // Nearest zones
        f_tc0(26, "Next Demand")
        f_tc1(26, not na(nearest_bu_zone) ? str.tostring(nearest_bu_zone,"#.##") : "—", color.new(#00BFA5,20))
        f_tc0(27, "Next Supply")
        f_tc1(27, not na(nearest_be_zone) ? str.tostring(nearest_be_zone,"#.##") : "—", color.new(#FF5252,20))
        table.cell(dashboard, 0, 28, "──────────", text_color=color.new(color.gray,60), text_size=size.tiny)
        f_tc1(28, "ELITE PATTERNS", color.new(color.gray,20))

f_dash_patterns() =>
    if not na(dashboard)
        // Unicorn / MMXM
        string _u_txt = unicorn_bull ? "🦄 UNICORN BUY" : unicorn_bear ? "🦄 UNICORN SELL" : mmxm_bull ? "MMXM BUY" : mmxm_bear ? "MMXM SELL" : "—"
        color  _u_clr = unicorn_bull or mmxm_bull ? color.lime : unicorn_bear or mmxm_bear ? color.red : color.gray
        f_tc0(29, "Unicorn/MMXM")
        f_tc1(29, _u_txt, _u_clr)
        // OB+FVG+CE / BPR
        string _tri_txt = ob_fvg_ce_bull ? "OB+FVG+CE ↑" : ob_fvg_ce_bear ? "OB+FVG+CE ↓" : in_bpr ? "BPR Zone" : cisd_bull ? "CISD ↑" : cisd_bear ? "CISD ↓" : "—"
        color  _tri_clr = ob_fvg_ce_bull or cisd_bull ? color.lime : ob_fvg_ce_bear or cisd_bear ? color.red : in_bpr ? color.yellow : color.gray
        f_tc0(30, "Triple/BPR/CISD")
        f_tc1(30, _tri_txt, _tri_clr)
        // Judas / AMD
        string _jud_txt = judas_bull_active ? "Judas BULL active" : judas_bear_active ? "Judas BEAR active" : amd_cycle_bull ? "AMD Bull phase" : amd_cycle_bear ? "AMD Bear phase" : amd_accumulation ? "AMD Accum." : "—"
        color  _jud_clr = judas_bull_active or amd_cycle_bull ? color.lime : judas_bear_active or amd_cycle_bear ? color.red : amd_accumulation ? color.yellow : color.gray
        f_tc0(31, "Judas / AMD")
        f_tc1(31, _jud_txt, _jud_clr)
        // SORO / PO3
        string _soro_txt = soro_bull ? "SORO BUY" : soro_bear ? "SORO SELL" : po3_dist_bull ? "PO3 Dist ↑" : po3_dist_bear ? "PO3 Dist ↓" : po3_manip_bull ? "PO3 Manip ↑" : po3_manip_bear ? "PO3 Manip ↓" : "—"
        color  _soro_clr = soro_bull or po3_dist_bull or po3_manip_bull ? color.lime : soro_bear or po3_dist_bear or po3_manip_bear ? color.red : color.gray
        f_tc0(32, "SORO / PO3")
        f_tc1(32, _soro_txt, _soro_clr)
        // LOF / TBOE / SFP
        string _lof_txt = _lof_bull_val ? "LOF ↑ (London Trap)" : _lof_bear_val ? "LOF ↓ (London Trap)" : in_tboe ? "TBOE Window" : sfp_bullish ? "SFP ↑" : sfp_bearish ? "SFP ↓" : "—"
        color  _lof_clr = _lof_bull_val or sfp_bullish ? color.lime : _lof_bear_val or sfp_bearish ? color.red : in_tboe ? color.yellow : color.gray
        f_tc0(33, "LOF/TBOE/SFP")
        f_tc1(33, _lof_txt, _lof_clr)
        // Displacement / SMT
        string _disp_txt = bull_disp_aligned ? "DISPLACEMENT ↑" : bear_disp_aligned ? "DISPLACEMENT ↓" : smt_divergence_bull ? "SMT Bull" : smt_divergence_bear ? "SMT Bear" : "—"
        color  _disp_clr = bull_disp_aligned or smt_divergence_bull ? color.lime : bear_disp_aligned or smt_divergence_bear ? color.red : color.gray
        f_tc0(34, "Displacement/SMT")
        f_tc1(34, _disp_txt, _disp_clr)
        // Liquidity sweeps
        string _liq_txt = sweep_confirmed_bull ? "✦ Sweep BULL confirmed" : sweep_confirmed_bear ? "✦ Sweep BEAR confirmed" : ssl_swept ? "SSL swept ↑" : bsl_swept ? "BSL swept ↓" : liquidity_grab_bullish ? "Liq grab ↑" : liquidity_grab_bearish ? "Liq grab ↓" : "—"
        color  _liq_clr = sweep_confirmed_bull or ssl_swept or liquidity_grab_bullish ? color.lime : sweep_confirmed_bear or bsl_swept or liquidity_grab_bearish ? color.red : color.gray
        f_tc0(35, "Liquidity")
        f_tc1(35, _liq_txt, _liq_clr)
        // HTF MSS / CHoCH
        string _mss_txt = htf_mss_bull ? "HTF MSS ↑" : htf_mss_bear ? "HTF MSS ↓" : internal_bull_choch ? "CHoCH ↑" : internal_bear_choch ? "CHoCH ↓" : internal_bull_bos ? "BoS ↑" : internal_bear_bos ? "BoS ↓" : "—"
        color  _mss_clr = htf_mss_bull or internal_bull_choch or internal_bull_bos ? color.lime : htf_mss_bear or internal_bear_choch or internal_bear_bos ? color.red : color.gray
        f_tc0(36, "HTF MSS/CHoCH")
        f_tc1(36, _mss_txt, _mss_clr)
        table.cell(dashboard, 0, 37, "──────────", text_color=color.new(color.gray,60), text_size=size.tiny)
        f_tc1(37, "ACTIVE TRADE", color.new(color.gray,20))

f_dash_trade() =>
    if not na(dashboard)
        bool _in_trade = trade_lockdown and active_signal_dir != 0 and frozen_ep > 0
        color _dir_clr = active_signal_dir == 1 ? color.lime : active_signal_dir == -1 ? color.red : color.gray
        // Direction
        f_tc0(38, "Direction")
        f_tc1(38, _in_trade ? (active_signal_dir == 1 ? "▲ LONG" : "▼ SHORT") : "No Trade", _dir_clr)
        // Entry
        f_tc0(39, "Entry Price")
        f_tc1(39, _in_trade ? str.tostring(frozen_ep, "#.##") : "—", color.white)
        // Stop Loss
        f_tc0(40, "Stop Loss")
        f_tc1(40, _in_trade ? str.tostring(frozen_sl, "#.##") + " (" + str.tostring(math.abs(frozen_ep - frozen_sl), "#.##") + "pts)" : "—", color.red)
        // TP1
        f_tc0(41, "TP1 (" + str.tostring(rr_scalp,"#.#") + "R)")
        string _tp1_txt = _in_trade ? str.tostring(frozen_tp1, "#.##") + (tp1_already_reached ? " ✓HIT" : "") : "—"
        f_tc1(41, _tp1_txt, tp1_already_reached ? color.new(color.lime,30) : color.lime)
        // TP2
        f_tc0(42, "TP2 (" + str.tostring(rr_intraday,"#.#") + "R)")
        f_tc1(42, _in_trade ? str.tostring(frozen_tp2, "#.##") : "—", color.new(color.lime,30))
        // TP3 Fib extension
        f_tc0(43, "TP3 (1.618 Fib)")
        f_tc1(43, _in_trade ? str.tostring(frozen_tp3, "#.##") : "—", color.new(color.aqua,20))
        // Live RR
        f_tc0(44, "Live R:R")
        string _rr_live = _in_trade and frozen_risk > 0 ? "1:" + str.tostring(math.abs(close - frozen_ep) / frozen_risk, "#.##") + (((active_signal_dir==1 and close>frozen_ep) or (active_signal_dir==-1 and close<frozen_ep)) ? " ✦" : " ✗") : "—"
        color  _rr_clr  = _in_trade and frozen_risk > 0 and ((active_signal_dir==1 and close>frozen_ep) or (active_signal_dir==-1 and close<frozen_ep)) ? color.lime : color.red
        f_tc1(44, _rr_live, _rr_clr)
        // Status / signal probability
        f_tc0(45, "Signal Prob")
        string _prob_txt = _in_trade ? str.tostring(math.round(active_signal_prob), "#") + "% | Score: " + str.tostring(active_signal_score) + "/" + str.tostring(score_max_display) : "—"
        f_tc1(45, _prob_txt, active_signal_prob >= 80 ? color.lime : active_signal_prob >= 70 ? color.yellow : color.gray)

        // ── V32 NEW ROWS ──────────────────────────────────────────────────────
        // V32-FIX-01: Lot Size row
        if show_lot_size
            table.cell(dashboard, 0, 46, "Lot Size", text_color=color.new(#FFD700,10), text_size=size.tiny)
            string _lot_txt = _in_trade and _computed_lot_size > 0 ? str.tostring(_computed_lot_size, "#.##") + " lots  (risk $" + str.tostring(math.round(account_balance * risk_pct / 100.0)) + ")" : show_lot_size ? "Set balance in G10" : "—"
            color  _lot_clr = _in_trade and _computed_lot_size > 0 ? color.new(#FFD700,10) : color.gray
            f_tc1(46, _lot_txt, _lot_clr)

        // V32-FIX-10: Live win rate tracker
        f_tc0(47, "Live Win Rate")
        // ARCH-04: clarified rolling window vs all-time count (GAP-05 fix)
        int _wr_window = array.size(_signal_outcomes)
        string _wr_txt  = not na(_live_winrate) ? str.tostring(math.round(_live_winrate), "#") + "% | last " + str.tostring(_wr_window) + " of " + str.tostring(_total_signals) + " total" : "Needs 5+ signals"
        color  _wr_clr  = not na(_live_winrate) ? (_live_winrate >= 65 ? color.lime : _live_winrate >= 55 ? color.yellow : color.red) : color.gray
        f_tc1(47, _wr_txt, _wr_clr)

        // V32-FIX-11: Wyckoff phase
        f_tc0(48, "Wyckoff Phase")
        string _wyc_txt = wyckoff_accum_conf ? "↑ ACCUM (buy setup)" : wyckoff_dist_conf ? "↓ DIST (sell setup)" : wyckoff_accum ? "Accum forming" : wyckoff_dist ? "Dist forming" : "—"
        color  _wyc_clr = wyckoff_accum_conf ? color.lime : wyckoff_dist_conf ? color.red : wyckoff_accum or wyckoff_dist ? color.yellow : color.gray
        f_tc1(48, _wyc_txt, _wyc_clr)

        // V32-FIX-12: Liquidity pool proximity
        f_tc0(49, "Liq Pools")
        string _lp_eqh = not na(_nearest_eq_high) ? "EQH " + str.tostring(_nearest_eq_high, "#.##") + " (" + str.tostring(math.round(_dist_eqh * 10.0) / 10.0, "#.#") + "ATR)" : "—"
        string _lp_eql = not na(_nearest_eq_low)  ? " | EQL " + str.tostring(_nearest_eq_low,  "#.##") : ""
        color  _lp_clr = near_liq_pool_buy ? color.lime : near_liq_pool_sell ? color.red : color.gray
        f_tc1(49, _lp_eqh + _lp_eql, _lp_clr)

        // V32-FIX-03/08: Entropy + Regime
        f_tc0(50, "Entropy/Regime")
        string _ent_lbl  = entropy_critical ? "CRITICAL" : entropy_high ? "HIGH" : "CLEAR"
        string _reg_lbl  = adx_strong_trend ? "TREND" : adx_ranging ? "RANGE" : "NEUTRAL"
        color  _ent_clr  = entropy_critical ? color.red : entropy_high ? color.orange : color.lime
        f_tc1(50, _ent_lbl + " | " + _reg_lbl + " | H=" + str.tostring(math.round(bar_entropy * 100.0) / 100.0, "#.##"), _ent_clr)

        // V38: Loss Streak + Guards (from v35)
        f_tc0(51, "Loss Streak")
        bool   _eq_paused = _consec_losses >= max_consec_losses
        string _streak_txt = _eq_paused ? "⛔ PAUSED [" + str.tostring(_consec_losses) + "/" + str.tostring(max_consec_losses) + "]" : str.tostring(_consec_losses) + "/" + str.tostring(max_consec_losses) + " ✓"
        color  _streak_clr = _eq_paused ? color.red : _consec_losses >= max_consec_losses - 1 ? color.orange : color.lime
        f_tc1(51, _streak_txt, _streak_clr)

        // Guards status
        f_tc0(52, "Guards")
        string _guards_txt = (_trap_buy or _trap_sell) ? "⚠ TRAP BLOCKED" : _loss_streak_ok ? "✅ All Clear" : "⛔ EQUITY STOP"
        color  _guards_clr = (_trap_buy or _trap_sell or not _loss_streak_ok) ? color.red : color.lime
        f_tc1(52, _guards_txt, _guards_clr)

// ── Dashboard execution (barstate.islast guard ensures single-bar render) ──
if barstate.islast and show_dashboard and dash_display_mode != "Hidden"
    f_dash_context()
    if dash_display_mode == "Full"
        f_dash_signals()
        f_dash_zones()
        f_dash_patterns()
        f_dash_trade()
    else // Minimized — only context + signal scores
        f_dash_signals()

