// ════════════════════════════════════════════════════════════════════════════
// V32-FIX-01: POSITION SIZING — Dynamic lot calculator for XAUUSD
// ════════════════════════════════════════════════════════════════════════════
// ── EXNESS MT5 XAUUSD OPTIMIZED POSITION SIZING ────────────────────────────────────
// Exness Gold: 1 standard lot = 100 oz. $1 price move = $100/lot. 1 pip = $0.01 = $1/lot
// Formula: lot = (balance × risk%) / (SL_in_price × 100)
// At risk_pct=2%, $10k balance, $15 SL → lot = 200/1500 = 0.13 → correct Exness sizing
// For 20-40% daily compounding: 3-5 intraday wins at 2.5R with 2% risk → ~25-35% daily ✓
G10 = "Position Sizing (XAUUSD / Exness MT5)"
account_balance     = input.float(10000.0, "Account Balance ($)",   minval=100, maxval=10000000, step=100, group=G10)
risk_pct            = input.float(2.0,     "Risk % Per Trade",      minval=0.1, maxval=10.0, step=0.1, group=G10)  // 2% per trade for compounding
gold_pip_value      = input.float(1.0,     "Pip Value (Exness XAUUSD = 1.0)", minval=0.01, step=0.01, group=G10)   // DO NOT change for Exness
show_lot_size       = input.bool(true,     "Show Lot Size in Dashboard", group=G10)
// Min SL: 150 pts on XAUUSD = $1.50 minimum (increased to 200 for Gold noise floor)
min_sl_pips         = input.float(200.0,   "Min SL Distance (XAUUSD pts)", minval=10.0, maxval=2000.0, step=10.0, group=G10)

